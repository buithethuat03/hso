    /** Tra ve id vat pham "Bo vang" trong tui tieu hao, hoac -1. */
    static int findCowItemId() {
        @class.VEC@ bag = @class.ITEM@.@item.bag@;
        if (bag == null) return -1;
        for (int i = 0; i < bag.@vec.size@(); i++) {
            Object o = bag.@vec.get@(i);
            if (o == null) continue;
            @class.ITEM@ it = (@class.ITEM@) o;
            if (it.@item.category@ != 4) continue;              // 4 = tui tieu hao
            String name = itemName(it);
            if (name != null && name.toLowerCase().indexOf(NAME_COW) >= 0) return it.@item.id@;
        }
        return -1;
    }

    static String itemName(@class.ITEM@ it) {
        if (it.@item.name@ != null && it.@item.name@.length() > 0) return it.@item.name@;
        String[] table = @class.ITEM@.@item.names@;
        int id = it.@item.id@;
        if (table != null && id >= 0 && id < table.length) return table[id];
        return null;
    }


