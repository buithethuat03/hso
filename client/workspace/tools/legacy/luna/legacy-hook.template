    static void restorePersistentHorse() {
        try {
            if (persistentHorse.needsConfigLoad()) {
                HSOSKYPetFeedSupport.loadRMS();
                persistentHorse.markConfigLoaded();
            }
            long currentTime = now();
            boolean inGame = HSOSKYPetFeedSupport.isPlayerInGame();
            boolean ready = inGame && player() != null && !mapHolderMissing()
                    && onGameScreen()
                    && !HSOSKYPetFeedSupport.isConnectingWaitDialog()
                    && !HSOSKYPetFeedSupport.hasCurrentDialog() && !dialogOpen();

            if (!inGame) horseLastInfoText = lastInfoText;
            observeHorseNotice(currentTime);

            // Native onCanvasUpdate() may run before this bridge on the first
            // frame. Keep its 2500ms guard fresh while login/dialog state is
            // still settling, so it cannot try to use the horse item early.
            if (HSOSKYPetFeedSupport.persistentAutoHorse && !ready) {
                HSOSKYPetFeedSupport.lastHorseMountAttemptTime = currentTime;
            }

            int action = persistentHorse.tick(currentTime, inGame, ready,
                    HSOSKYPetFeedSupport.persistentAutoHorse,
                    @class.ENGINE@.@engine.field.autoHorse@);
            if (action == PersistentHorseController.ENABLE_AND_MOUNT) {
                HSOSKYPetFeedSupport.setModAutoHorse(true);
                // Do not force an item-use call here. The native support and
                // the retry branch will perform it after the normal cooldown.
                HSOSKYPetFeedSupport.lastHorseMountAttemptTime = currentTime;
            } else if (action == PersistentHorseController.RETRY_MOUNT) {
                HSOSKYPetFeedSupport.checkAndMountHorse();
            }
        } catch (Throwable ignore) {
            // A transient login-screen/native state must not stop the frame hook.
        }
    }

