                // The original transport accepted the retry but produced no
                // usable world transition. Escalate once to the native
                // socket/handshake path instead of spinning on the same dead
                // sender forever.
                loginSameSessionRetryAt = 0L;
                loginLoadingSince = t;
                loginCooldownRetryAt = t;
                loginCooldownRetryPending = true;
                loginRetryTransportRequired = true;
                loginTransportRestartIssued = false;
                loginRetryLoginPacketSent = false;
                loginRetrySequenceStarted = false;
                loginAwaitingCharacterList = false;
                loginCharacterListReady = false;
                loginCharacterListReadyAt = 0L;
                loginEnterRetrySent = false;
                return;
            }
            boolean connectingWait = false;
            boolean loginSurface = false;
            boolean nonGameSurface = false;
            try {
                connectingWait = HSOSKYPetFeedSupport.isConnectingWaitDialog()
                        || HSOSKYPetFeedSupport.hasCurrentDialog() || dialogOpen();
                loginSurface = onLoginScreen();
                nonGameSurface = !onGameScreen();
            } catch (Throwable ignoreDialog) {
                connectingWait = false;
            }
            // The visible countdown can live on the logo/loader surface, inside
            // the game surface, or disappear before the spinner remains. The
            // authoritative condition is simpler: a real opcode-1 attempt was
            // sent, but strict world entry has not been observed yet. This also
            // avoids relying on one particular native screen/dialog class. With
            // no observed cooldown packet, assume the old sender may already
            // be closed and force one fresh native transport immediately.
            if (!loginCooldownRetryPending && !loginRetrySequenceStarted
                    && t - lastAttempt >= LOGIN_COOLDOWN_RETRY_DELAY_MS) {
                loginCooldownRetryAt = t;
                loginCooldownRetryPending = true;
                loginRetryTransportRequired = true;
                loginTransportRestartIssued = false;
                loginTransportHandshakeReady = true;
                loginRetryLoginPacketSent = false;
                loginAwaitingCharacterList = false;
                loginCharacterListReady = false;
                loginCharacterListReadyAt = 0L;
                loginEnterRetrySent = false;
                return;
            }
            if (loginSurface || nonGameSurface || connectingWait) {
                return;
            }
            if (loginLoadingSince == 0L) loginLoadingSince = t;
            if (t - loginLoadingSince < LOGIN_LOADING_WATCHDOG_MS
                    || t - lastAttempt < LOGIN_LOADING_WATCHDOG_MS) {
                return;
            }
            loginLoadingSince = t;
            loginCooldownRetryAt = t;
            loginCooldownRetryPending = true;
            loginRetryTransportRequired = true;
            loginTransportRestartIssued = false;
            loginRetryLoginPacketSent = false;
            loginRetrySequenceStarted = false;
            loginAwaitingCharacterList = false;
            loginCharacterListReady = false;
            loginCharacterListReadyAt = 0L;
            loginEnterRetrySent = false;
        } catch (Throwable ignore) {
            // A transient screen transition must not stop the frame hook.
        }
    }

    /** Sends one fresh login request after the server cooldown has elapsed. */
    static void retryLoginAfterCooldown() {
        // Custom reconnect belongs only to the explicit Auto Login mode.
        // Manual login must never be restarted by the generic 10-second
        // watchdog when the user has not selected an auto-login character.
        if (HSOSKYPetFeedSupport.selectedAutoLoginChar < 0) return;
        observeDisconnectForLoginRetry();
        observeLoginLoadingWatchdog();
        if (!loginCooldownRetryPending) return;
        try {
            if (loginRetrySequenceStarted && reconnectEnteredWorld()) {
                loginCooldownRetryPending = false;
                loginLoadingSince = 0L;
                loginWatchdogArmed = false;
                loginRetryTransportRequired = false;
                loginTransportRestartIssued = false;
                loginSameSessionRetryAt = 0L;
                loginRetryLoginPacketSent = false;
                loginRetrySequenceStarted = false;
                loginAwaitingCharacterList = false;
                loginCharacterListReady = false;
                loginCharacterListReadyAt = 0L;
                loginEnterRetrySent = false;
                return;
            }
            long t = now();
            if (t < loginCooldownRetryAt) return;
            if (!onLoginScreen()) {
                // The connecting dialog is the state that can remain stuck
                // after its countdown reaches zero.  This retry is already
                // armed by a cooldown/disconnect signal, so dismiss it and
                // rebuild the login screen instead of returning forever.
                HSOSKYPetFeedSupport.dismissCurrentDialog();
                forceLoginSurface();
                // The login object already owns the credentials and sender;
                // select it directly instead of re-running the local_server
                // bootstrap on every retry frame.
                loginCooldownRetryAt = t + 250L;
                loginCooldownRetryPending = true;
                return;
            }
            // A stale connecting/error dialog can survive the screen switch
            // for one frame. This path is already armed by a reconnect signal,
            // so close any remaining dialog and continue to trigger login.
            if (HSOSKYPetFeedSupport.hasCurrentDialog() || dialogOpen()) {
                HSOSKYPetFeedSupport.dismissCurrentDialog();
            }

            // A real fallback is prepared once and waits for handshake. The
            // cooldown path never enters this branch and reuses its sender.
            if (loginRetryTransportRequired && !loginTransportRestartIssued) {
                forceTransportReconnectBeforeLogin();
                loginCooldownRetryAt = t;
                loginCooldownRetryPending = true;
                return;
            }
            if (loginTransportRestartIssued && !loginTransportHandshakeReady) {
                if (t - loginTransportRestartAt < LOGIN_TRANSPORT_HANDSHAKE_TIMEOUT_MS) {
                    loginCooldownRetryAt = t + LOGIN_TRANSPORT_HANDSHAKE_POLL_MS;
                    loginCooldownRetryPending = true;
                    return;
                }
                // Do not deadlock forever if the server never answers the
                // handshake; the normal watchdog will arm another attempt.
                loginTransportRestartIssued = false;
            }
            if (loginTransportRestartIssued && loginTransportHandshakeReady
                    && t - loginTransportHandshakeAt < LOGIN_TRANSPORT_SETTLE_MS) {
                loginCooldownRetryAt = t + LOGIN_TRANSPORT_HANDSHAKE_POLL_MS;
                loginCooldownRetryPending = true;
                return;
            }
            loginCooldownRetryPending = false;
            loginWatchdogArmed = true;
            loginLastRetryAt = t;
            if (HSOSKYPetFeedSupport.selectedAutoLoginChar >= 0) {
                HSOSKYPetFeedSupport.setModSelectedChar(
                        HSOSKYPetFeedSupport.selectedAutoLoginChar);
            }
            HSOSKYPetFeedSupport.loginScreenEnterTime = t;
            HSOSKYPetFeedSupport.lastLoginAttemptTime = t;
            boolean rebuiltTransport = loginTransportRestartAt > 0L
                    && t - loginTransportRestartAt < 60000L;
            loginTransportRestartIssued = false;
            // Always restart the native login sequence with opcode 1.  The
            // server returns the character list (inbound opcode 13), and only
            // then is the captured enter-world opcode 13 legal to resend.
            // V28 sent opcode 13 immediately after the countdown, which left
            // both the old and rebuilt transports at the loading spinner.
            loginRetryLoginPacketSent = true;
            loginRetrySequenceStarted = true;
            loginAwaitingCharacterList = false;
            loginCharacterListReady = false;
            loginCharacterListReadyAt = 0L;
            loginEnterRetrySent = false;
            // Resolve SENDER.gI() at send time. It is the same live sender for
            // a cooldown retry and the newly-created sender after a fallback
            // socket/handshake; the captured fields only hold packet data.
            boolean replayed = replayCapturedLoginRequest();
            if (!replayed) HSOSKYPetFeedSupport.triggerLogin();
            loginTransportRestartAt = 0L;
            loginSameSessionRetryAt = rebuiltTransport ? 0L : t;
        } catch (Throwable retryFailure) {
            // If the login screen is still rebuilding, try once more after a short gap.
            loginCooldownRetryAt = now() + 3000L;
            loginCooldownRetryPending = true;
            loginTransportRestartIssued = false;
            loginRetryTransportRequired = true;
            loginRetrySequenceStarted = false;
        }
    }

    // ------------------------------------------------------------------- menu

    /** Duoc chen vao dau ENGINE.perform(int,int). Tra ve true = da xu ly xong. */
    public static boolean handleMenuAction(int action, int param) {
        if (action == ACT_NATIVE_AUTO_HORSE) {
            persistentHorse.observeNativeToggle(param != -1);
        }
        if (action == ACT_SUBMENU) {
            pendingSubmenu = true;
            return true;
        }
        if (action == ACT_TOGGLE) {
            if (state == OFF) {
                start();
            } else {
                stop(null);
            }
            pendingSubmenu = true;
            return true;
        }
        if (action == ACT_BOOST) {
            boostOn = !boostOn;
            notice(boostOn ? "Tăng tốc: BẬT (dắt bò nhịp đầy đủ)."
                           : "Tăng tốc: TẮT (dắt bò chậm một nửa).");
            pendingSubmenu = true;
            return true;
        }
        if (action == ACT_N4_SUBMENU) {
            pendingN4Submenu = true;
            return true;
        }
        if (action == ACT_N4_TOGGLE) {
            if (n4State == N4_OFF) {
                n4Start();
            } else {
                n4Stop(null);
            }
            pendingN4Submenu = true;
            return true;
        }
        if (action == ACT_REVIVE_SUBMENU) {
            pendingReviveSubmenu = true;
            return true;
        }
        if (action == ACT_REVIVE_ITEM) {
            itemReviveOn = !itemReviveOn;
            if (itemReviveOn) {
                // Engine goc: 0 = VPSHS/dung vat pham; 1 = ve lang; -1 = tat.
                @class.ENGINE@.@engine.field.reviveMode@ = 0;
            }
            if (!itemReviveOn) {
                @class.ENGINE@.@engine.field.reviveMode@ = -1;
                resetReviveState();
            }
            notice(itemReviveOn ? "Auto hoi sinh bang vat pham: BAT (delay 0.5s)."
                                : "Auto hoi sinh bang vat pham: TAT.");
            pendingReviveSubmenu = true;
            return true;
        }
        if (action == ACT_NOCLIP) {
            noclipOn = !noclipOn;
            HSOSKYRuntimeSupport.setNoClipEnabled(noclipOn);
            clearPlan();
            @class.PLAYER@ me = player();
            if (me != null) haltWalk(me);
            notice(noclipOn ? "Noclip: BAT (di xuyen dia hinh)."
                           : "Noclip: TAT (tim duong that).");
            pendingSubmenu = true;
            return true;
        }
        if (action == ACT_AUTO_MONSTERS) {
            selectAutoAttackMode(false);
            return true;
        }
        if (action == ACT_AUTO_MONSTERS_AND_PLAYERS) {
            selectAutoAttackMode(true);
            return true;
        }
        return false;
    }

    /**
     * Thay cho chat 7/6. Chon mode dong thoi bat Auto Danh, giong hanh vi lenh chat hien tai.
     * Gia tri false la mac dinh mode 7 (chi quai), true la mode 6 (quai + PK).
     */
    static void selectAutoAttackMode(boolean players) {
        HSOSKYPetFeedSupport.setAutoPlayersEnabled(players);
        HSOSKYPetFeedSupport.persistentAutoAttack = true;
        HSOSKYPetFeedSupport.setModAutoAttack(true);
        HSOSKYPetFeedSupport.reengageAutoAttack();
        HSOSKYPetFeedSupport.saveRMS();
    }

    static void showSubmenu() {
        @class.VEC@ items = new @class.VEC@((byte) 0);
        String label = state == OFF ? "Trạng thái: [OFF]" : "Trạng thái: [ON]";
        items.@vec.add@(new @class.CMD@(label, ACT_TOGGLE, @class.ENGINE@.@engine.field.INSTANCE@));
        String boost = boostOn ? "Tăng tốc: [ON]" : "Tăng tốc: [OFF]";
        items.@vec.add@(new @class.CMD@(boost, ACT_BOOST, @class.ENGINE@.@engine.field.INSTANCE@));
        String noclip = noclipOn ? "Noclip: [ON]" : "Noclip: [OFF]";
        items.@vec.add@(new @class.CMD@(noclip, ACT_NOCLIP, @class.ENGINE@.@engine.field.INSTANCE@));
        @class.CANVAS@.@canvas.menu@.@menubox.show@(items, 2, "AUTO ĐI BUÔN", false, (@class.VEC@) null);
    }

    static void showReviveSubmenu() {
        @class.VEC@ items = new @class.VEC@((byte) 0);
        String item = reviveAutoOn() ? "Dung vat pham: [ON] (0.5s)" : "Dung vat pham: [OFF] (0.5s)";
        items.@vec.add@(new @class.CMD@(item, ACT_REVIVE_ITEM, @class.ENGINE@.@engine.field.INSTANCE@));
        @class.CANVAS@.@canvas.menu@.@menubox.show@(items, 2, "AUTO HOI SINH", false, (@class.VEC@) null);
    }

    /** VPSHS (mode 0) la che do hoi sinh bang vat pham cua engine goc. */
    static boolean reviveAutoOn() {
        if (!itemReviveOn && @class.ENGINE@.@engine.field.reviveMode@ == 0) {
            // Dong bo trang thai native VPSHS vao bo auto cua support.
            itemReviveOn = true;
        }
        return itemReviveOn;
    }

    static void resetReviveState() {
        reviveSince = 0L;
        reviveLastRequest = 0L;
        reviveRequestSent = false;
        reviveSelected = false;
        reviveMenuPending = false;
        reviveConfirmAccepted = false;
        reviveConfirmMenuPending = false;
        reviveMenuRow = 0;
        reviveLastOk = 0L;
        reviveNpc = -1;
        reviveMenu = 0;
        reviveMenuAt = 0L;
    }

    /** Len lich goi lai helper native len ngua sau khi nhan vat vua song lai. */
    static void scheduleHorseAfterRevive() {
        if (@class.ENGINE@.@engine.field.autoHorse@) {
            horseRevivePending = true;
            horseReviveAt = now() + HORSE_REVIVE_WAIT_MS;
            horseReviveLastKick = 0L;
            horseReviveKicks = 0;
        } else {
            horseRevivePending = false;
        }
    }

    /** Chu dong chay helper len ngua; khong can doi nguoi choi di chuyen. */
    static void tickHorseAfterRevive(@class.PLAYER@ me) {
        if (!horseRevivePending) return;
        if (!@class.ENGINE@.@engine.field.autoHorse@ || me == null) {
            horseRevivePending = false;
            return;
        }
        long t = now();
        if (t < horseReviveAt || t - horseReviveLastKick < HORSE_REVIVE_RETRY_MS) return;
        if (dialogOpen()) return;
        try {
            // State 4 la state con sot lai sau hoi sinh; di chuyen binh thuong vo tinh xoa no.
            me.@entity.autoHorseState@ = 0;
            me.@entity.autoHorseBusy@ = false;
            @class.ENGINE@.@engine.method.autoHorseTick@();
        } catch (Throwable ignore) {
            // Khong de routine len ngua lam anh huong vong game chinh.
        }
        horseReviveLastKick = t;
        horseReviveKicks++;
        if (horseReviveKicks >= HORSE_REVIVE_MAX_KICKS) horseRevivePending = false;
    }

    /** Xu ly hoi sinh bang vat pham va kickstart len ngua sau hoi sinh. */
    static boolean tickReviveFeatures() {
        try {
            @class.PLAYER@ me = player();
            if (me == null || mapHolderMissing()) return false;

            if (reviveMenuPending) {
                if (now() - reviveMenuAt < ITEM_REVIVE_MENU_DELAY_MS) return true;
                short npc = reviveNpc;
                byte menu = reviveMenu;
                byte row = reviveMenuRow;
                boolean confirm = reviveConfirmMenuPending;
                reviveMenuPending = false;
                reviveLastRequest = now();
                if (confirm) {
                    // Day la popup "OK/Huy": bam OK nhung van cho menu vat pham tiep theo.
                    reviveConfirmMenuPending = false;
                    reviveConfirmAccepted = true;
                } else {
                    // Day moi la menu hoi sinh: chon option dau tien "Dung vat pham hoi sinh".
                    reviveRequestSent = false;
                    reviveSelected = true;
                    reviveConfirmMenuPending = false;
                }
                sender().@sender.npcMenuSelect@(npc, menu, row);
                return true;
            }

            boolean dead = playerDead();
            if (dead) {
                reviveDeadSeen = true;
                boolean reviveOn = reviveAutoOn();
                if (n4State != N4_OFF && reviveOn) n4Stop(null);
                if (state != OFF && reviveOn) stop(null);
                if (reviveOn) {
                    // De engine goc khong gui them mot goi hoi sinh trung voi support.
                    @class.ENGINE@.@engine.field.reviveMode@ = -1;
                    tickItemRevive();
                    long t = now();
                    if (reviveRequestSent && dialogOpen()
                            && t - reviveLastRequest >= 250L
                            && t - reviveLastOk >= 750L) {
                        pressOk();
                        reviveLastOk = t;
                    }
                }
                return reviveOn;
            }

            if (reviveDeadSeen) {
                reviveDeadSeen = false;
                resetReviveState();
                // Da song lai: hien lai che do VPSHS, khop voi itemReviveOn va menu native.
                if (itemReviveOn) @class.ENGINE@.@engine.field.reviveMode@ = 0;
                scheduleHorseAfterRevive();
            }

            tickHorseAfterRevive(me);
            return false;
        } catch (Throwable t) {
            return false;
        }
    }

    static void tickItemRevive() {
        long t = now();
        if (reviveSince == 0L) {
            reviveSince = t;
            reviveSelected = false;
            reviveRequestSent = false;
        }
        if (reviveSelected) return;
        if (!reviveRequestSent && t - reviveSince < ITEM_REVIVE_DELAY_MS) return;
        if (reviveRequestSent && t - reviveLastRequest < ITEM_REVIVE_RETRY_MS) return;
        @class.ENGINE@.@engine.field.reviveMode@ = 0;
        sender().@sender.reviveRequest@((byte) 1);
        reviveRequestSent = true;
        reviveLastRequest = t;
    }

    // ------------------------------------------------------------ bat / tat

    static void start() {
        if (player() == null || mapHolderMissing()) {
            notice("Chưa vào game.");
            return;
        }
        if (n4State != N4_OFF) n4Stop("Bật Auto Đi Buôn nên tắt Auto Ngã 4.");
        if (findCowItemId() < 0) {
            notice("Không có Bò vàng trong hành trang!");
            return;
        }
        // Cac auto duoi day cung gianh quyen dieu khien di chuyen -> se lam lac bo.
        savedAutoAttack = @class.ENGINE@.@engine.field.autoAttack@ || attackRecoveryDesired;
        savedPersistentAutoAttack = HSOSKYPetFeedSupport.persistentAutoAttack
                || attackRecoveryDesired;
        savedAutoNextMap = @class.ENGINE@.@engine.field.autoNextMap@;
        savedAutoSell = @class.ENGINE@.@engine.field.autoSell@;
        savedAutoHorse = @class.ENGINE@.@engine.field.autoHorse@;
        savedValid = true;
        @class.ENGINE@.@engine.field.autoAttack@ = false;
        HSOSKYPetFeedSupport.setModAutoAttack(false);
        HSOSKYPetFeedSupport.persistentAutoAttack = false;
        attackRecoveryState = ATTACK_RECOVERY_IDLE;
        attackRecoveryDesired = false;
        attackRecoverySuppressed = false;
        attackRecoveryTargetMissingSince = 0L;
        @class.ENGINE@.@engine.field.autoNextMap@ = false;
        @class.ENGINE@.@engine.field.autoSell@ = false;
        @class.ENGINE@.@engine.field.autoHorse@ = false;
        // Native PetFeedSupport co the tu bat lai autoHorse theo RMS; dong bo ca co nho do.
        HSOSKYPetFeedSupport.onAutoHorseToggled(false);
        HSOSKYRuntimeSupport.setNoClipEnabled(noclipOn);
        clearPlan();

        beginTrip();
        talkingNpc = -1;
        pathFails = 0;
        fetchMapId = -1;
        prevMapId = -1;
        lastMapId = mapId();
        spawnTries = 0;
        cowRef = null;
        // Chua co bo nao cua luot nay; dat moc de gia tri cu tu lan bat truoc khong sot lai.
        cowSummonedAt = now();
        shopScreen = null;
        lastAlive = now();
        offlineHold = false;
        lastSeenX = -1;
        lastSeenY = -1;
        lastMoveAt = 0L;
        stuckTold = false;
        dialogSince = 0L;
        dialogTold = false;
        pendRow = -1;
        pendIsSell = false;
        pendIsBoost = false;
        mapChangedAt = now();
        cowGoneSince = 0L;
        routeMissSince = 0L;
        setState(GOTO_START);
    }

    /**
     * Dat lai moi thu tinh theo TUNG CHUYEN. Goi dung MOT cho - luc goi duoc con bo moi -
     * vi do moi that su la moc bat dau mot chuyen.
     *
     * Truoc day cac bien nay duoc dat lai rai rac o start() va o cho ban xong, va da mac
     * dung kieu loi do: boostDone chi co trong start() nen tu chuyen thu hai tro di khong
     * bam tang toc cho bo nua.
     */
    static void beginTrip() {
        gemsBought = 0;
        respawnRuns = 0;
        fetchRuns = 0;
        lastInfoText = null;
        noReplyRun = 0;
        dismissTries = 0;
        gemTier = 0;          // chuyen sau mua lai tu kim cuong: NPC hoi hang moi gio
        buyPending = false;
        lastDialogText = null;
        grahamAsked = false;
        boostDone = false;
    }

    /** reason: null = nguoi choi tu tat, khac null = dung vi su co (co bao). */
    static void stop(String reason) {
        state = OFF;
        shopScreen = null;
        offlineHold = false;
        if (savedValid) {
            @class.ENGINE@.@engine.field.autoAttack@ = savedAutoAttack;
            HSOSKYPetFeedSupport.setModAutoAttack(savedAutoAttack);
            HSOSKYPetFeedSupport.persistentAutoAttack = savedPersistentAutoAttack;
            if (savedAutoAttack && savedPersistentAutoAttack) {
                HSOSKYPetFeedSupport.reengageAutoAttack();
            }
            attackRecoveryState = savedAutoAttack && savedPersistentAutoAttack
                    ? ATTACK_RECOVERY_ARMED : ATTACK_RECOVERY_IDLE;
            attackRecoveryDesired = savedAutoAttack && savedPersistentAutoAttack;
            attackRecoverySuppressed = false;
            attackRecoveryLastPersistent = savedPersistentAutoAttack;
            @class.ENGINE@.@engine.field.autoNextMap@ = savedAutoNextMap;
            @class.ENGINE@.@engine.field.autoSell@ = savedAutoSell;
            @class.ENGINE@.@engine.field.autoHorse@ = savedAutoHorse;
            HSOSKYPetFeedSupport.onAutoHorseToggled(savedAutoHorse);
            savedValid = false;
        }
        if (reason != null) notice(reason);
    }

    /**
     * Dang mat ket noi (hoac khong con o man hinh game) hay khong.
     *
     * KHONG duoc dung HSOSKYPetFeedSupport.isDisconnected hay isPlayerInGame() o day, du
     * chung nghe rat dung ten: co bat len nhung chi duoc xoa o hai cho, mot cho nam trong
     * "if (isPlayerInGame())" - ma isPlayerInGame() lai tra ve false ngay khi co bat -, cho
     * con lai nam trong nhanh auto login va chi chay khi nguoi choi da chon nhan vat auto
     * login. Nguoi choi khong bat auto login thi co do bat len roi la KHONG BAO GIO tat, va
     * auto di buon se treo vinh vien.
     *
     * Chi tam dung khi CHUNG MINH duoc la mat ket noi, khong bao gio dung vi "khong
     * chung minh duoc la dang online":
     *   - khong con doc duoc nhan vat / ban do
     *   - dang o dung man hinh DANG NHAP
     *   - hop thoai cua he thong ve duong truyen dang mo
     *
     * TUYET DOI khong dung "khong o man hinh game" lam dau hieu: mo cua hang cua Dylan la
     * DOI man hinh that (lop chua cua hang goi ham doi man hinh cua client), nen chot kieu
     * do lam auto treo cung ngay o buoc "Toi cho Dylan" - dung loi da gap. Ma treo o day
     * con khong co han nao go ra, vi nhanh tam dung return truoc cho kiem tra qua han.
     */
    static boolean offline() {
        if (player() == null || mapHolderMissing()) return true;
        if (onLoginScreen()) return true;
        return isLinkDialog(dialogText());
    }

    /** Dang o man hinh dang nhap - dau hieu chac chan la khong con trong game. */
    static boolean onLoginScreen() {
        try {
            Object cur = HSOSKYPetFeedSupport.getCurrentScreen();
            Object login = HSOSKYPetFeedSupport.getLoginScreen();
            return cur != null && login != null && cur == login;
        } catch (Throwable t) {
            return false;
        }
    }

    /** Mat ket noi: dung yen, khong dung toi ban phim lan duong truyen. */
    static void holdOffline() {
        if (offlineHold) return;
        offlineHold = true;
        offlineSince = now();
        pendRow = -1;
        pendIsSell = false;
        pendIsBoost = false;
        // noticeQuiet: khong duoc mo hop thoai luc nay - ban mod nhan biet dut ket noi
        // bang viec CO hop thoai dang mo, mo them mot hop nua la pha luon cho no.
        noticeQuiet("Mất kết nối - tạm dừng, vào lại game sẽ đi tiếp.");
    }

    /**
     * Vao lai game: di tiep tu dung buoc dang lam, khong lam lai tu dau.
     *
     * Con bo van con do (server giu thu di buon theo nhan vat, khong theo phien) nen dang
     * dat thi dat tiep. Rieng man hinh cua hang chac chan da dong, nen dang mua do thi lui
     * mot buoc ve cho Dylan de mo lai - so vien da mua duoc giu nguyen.
     *
     * Moi moc thoi gian phai duoc doi ho dung bang thoi gian nghi, khong thi han cua buoc
     * dang lam da troi qua tu bao gio va auto tat ngay khi vua vao lai duoc.
     */
    static void resumeOnline() {
        long away = now() - offlineSince;
        offlineHold = false;
        stateSince += away;
        if (fetchSince != 0L) fetchSince += away;

        // Vao lai game giong het vua doi map: thuc the va bang cong deu nap lai tu dau.
        cowRef = null;                   // doi tuong mob cu khong con, nhan dang lai
        /*
         * Quen luon map lien truoc. Neu vao lai game ma khong thay bo thi khong duoc doan
         * la "no bi bo lai map vua roi" rồi chay nguoc ve do - cai moc do la tu truoc luc
         * rot mang, khong con y nghia gi.
         */
        prevMapId = -1;
        mapChangedAt = now();
        lastMapId = mapId();
        cowGoneSince = 0L;
        routeMissSince = 0L;
        cowRecovering = false;
        gateSince = 0L;
        gateBackOff = false;
        pathFails = 0;

        // cowSummonedAt KHONG doi ho: dong ho cua bo chay theo gio thuc, offline no van chay.
        lastAlive = now();
        lastStep = 0L;
        lastMoveAt = 0L;
        lastSeenX = -1;
        lastSeenY = -1;
        stuckTold = false;
        dialogSince = 0L;
        dialogTold = false;

        buyPending = false;          // goi mua dang cho tra loi thi khong bao gio ve nua
        lastDialogText = null;
        lastInfoText = null;
        for (int i = 0; i < infoSeen.length; i++) infoSeen[i] = null;
        noReplyRun = 0;
        shopScreen = null;
        /*
         * KHONG lui buoc o day nua. Moi buoc tu biet phai lam gi khi vao lai game:
         *   B4 Mua ngoc          - con bo: stepBuy tu mo lai cua hang, so vien da mua giu
         *                          nguyen; mat bo: cowVanished -> B2 Goi bo vang
         *   B5 Tang toc cho bo   - con bo: bam tiep; mat bo: cowVanished -> B2
         *   B6 Dat bo            - con bo: dat tiep; mat bo: fetchCowFromPrevMap, ma sau khi
         *                          vao lai game prevMapId = -1 nen thanh restartTrip -> B1
         *   B9 Cho NPC nhap hang - con bo: hoi tiep; mat bo: cowVanished -> B2
         * B1, B2, B3, B7, B8, B10 khong dinh gi toi con bo dang cam nen cu the ma chay tiep.
         */
        if (state == SPAWN_PET) markAlienCows();

        notice(join("Vào lại game, đi tiếp: ", STATE_LABEL[state]));
    }

    /**
     * Doc dong thong bao tam thoi cua client.
     *
     * Client co BA kenh rieng cho loai thong bao nay, cung nam tren mot doi tuong:
     *   - hang doi chu chay ngang dau man hinh
     *   - hang doi thu hai danh cho dong qua dai
     *   - dong ngan hien thang, khong qua hang doi nao
     * "Vat pham hien tai da ban het" di vao kenh NGAN. Ban dau chi doc kenh chu chay nen
     * khong bao gio thay no, va auto cu bam mua mai mot loai da het - dung loi da bao.
     *
     * So sanh bang THAM CHIEU chu khong bang noi dung: hai lan bao het hang lien tiep co
     * noi dung y het nhau, so bang equals la lan thu hai bi nuot mat.
     */
    static void pollInfo() {
        try {
            @class.INFOBOX@ box = @class.INFOQ@.@infoq.holder@;
            if (box == null) return;
            takeInfo(0, box.@infobox.text1@);
            takeInfo(1, box.@infobox.text2@);
            takeInfo(2, box.@infobox.text3@);
        } catch (Throwable t) {
            // khong doc duoc thi thoi, con luoi an toan dem lan mua khong tra loi
        }
    }

    /**
     * Coi nhu da doc het nhung dong dang co tren hop thong bao.
     *
     * Goi luc doi map. Khong lam the thi cac dong con lai tu map TRUOC se duoc coi la moi
     * va duoc xu ly mot lan nua ngay khi vua sang map moi - voi Auto Nga 4 thi do la thong
     * bao cua cua luot truoc: no chiem mat khoa doi cua, nhan vat chay sang cua sai, va
     * thong bao THAT cua dot dau bi khoa chan lai. Dung loi "vao pho ban thi di vong vong
     * mot luc roi moi quay ve cho can dung, quai ra mat roi khong kip danh".
     */
    static void flushInfo() {
        try {
            @class.INFOBOX@ box = @class.INFOQ@.@infoq.holder@;
            if (box == null) return;
            infoSeen[0] = box.@infobox.text1@;
            infoSeen[1] = box.@infobox.text2@;
            infoSeen[2] = box.@infobox.text3@;
        } catch (Throwable t) {
            // doc khong duoc thi thoi
        }
    }

    static void takeInfo(int slot, String text) {
        if (text == null || text == infoSeen[slot]) return;
        infoSeen[slot] = text;
        lastInfoText = text.toLowerCase();
        if (n4InDungeon) n4ReadGate(lastInfoText);
    }

    /** Dong thong bao noi mon dang mua da het hang. */
    static boolean isSoldOut(String text) {
        return NoticeReader.isSoldOut(text)
                || (text != null && text.indexOf(SOLD_OUT_MARK2) >= 0);
    }

    /** Hop thong bao cua he thong ve duong truyen - tuyet doi khong dung toi. */
    static boolean isLinkDialog(String text) {
        if (NoticeReader.isConnectionNotice(text)) return true;
        return text != null && text.indexOf("kết nối") >= 0;
    }

    /**
     * Nguong "bo tut lai" theo che do dang chay. Bat tang toc: buoc dai gap doi nen
     * nguong cung gap doi. Van con thua bien so voi ban kinh bam cua server luc pet duoc
     * tang toc (85 * speed, speed = 4).
     */
    static int petLostPx() {
        return AutoTradeController.petLostPixels(boostOn);
    }


    /**
      * So O duoc giao cho engine moi nhip khi dat bo - cat theo o chu khong theo pixel,
      * vi duong di la mang cac o. Tat tang toc thi nua so o: o rong 24px nen 2 o (48px/giay)
      * xuong con 1 o (24px/giay), dung mot nua.
      */
    static int haulTiles(int tile) {
        return AutoTradeController.haulTiles(tile, boostOn);
    }

    static void setState(int next) {
        // Chup danh sach bo nguoi khac NGAY TRUOC khi bat dau goi, khong phai luc nao khac.
        if (next == SPAWN_PET) markAlienCows();
        state = next;
        stillSince = 0L;
        stateSince = now();
        lastStep = 0L;
        lastAction = 0L;
        cowRecovering = false;
    }

    // ------------------------------------------------------------------ tick

    /**
     * Duoc chen vao method chay moi frame cua CANVAS, tuc chay o MOI man hinh.
     *
     * KHONG dat trong ENGINE.update(): method do chi duoc goi tu man hinh game, nen mo
     * cua hang cua Dylan la auto dung im giua cua hang.
     */
    public static void tick() {
        try {
            // Read short server notices before the horse policy decides whether
            // a bounded transient retry is warranted.
            pollInfo();
            // Re-arm the RMS-backed horse setting on each login/world edge.
            restorePersistentHorse();
            // The server rejects an early reconnect instead of queueing it; retry once
            // after the displayed cooldown rather than leaving the user at loading.
            retryLoginAfterCooldown();
            // Complete the second half of the native login sequence only after
            // the reader has parsed the returned character list.
            retryLoginEnterAfterCharacterList();
            // Observe lifecycle before any early return caused by revive/login handling.
            attackRecoveryObserve();
            postLoginEnterTick();
            if (pendingReviveSubmenu) {
                pendingReviveSubmenu = false;
                showReviveSubmenu();
            }
            boolean reviveHandled = tickReviveFeatures();
            // Recovery must run even while revive owns this frame.
            attackRecoveryTick();
            if (reviveHandled) return;
            if (pendingSubmenu) {
                pendingSubmenu = false;
                showSubmenu();
            }
            if (pendingN4Submenu) {
                pendingN4Submenu = false;
                showN4Submenu();
            }
            /*
             * Hai tinh nang loai tru nhau: ca hai deu gianh quyen dieu khien di chuyen va
             * hop thoai. n4Start()/start() da tu tat cai kia, cho nay chi la chot cuoi.
             */
            if (n4State != N4_OFF) {
                n4Tick();
                return;
            }
            if (state == OFF) return;

            /*
             * Mat ket noi thi KHONG dung toi gi ca: khong bam phim, khong gui goi. Client
             * co san vong tu dang nhap lai, va ban mod co auto login - de yen cho chung
             * chay, vao lai game roi thi di tiep tu dung buoc dang lam do.
             *
             * Truoc day cho nay do player() == null || mapHolderMissing(). Ca hai deu
             * KHONG BAO GIO dung khi rot mang that: quet ca jar bang ASM thi mapHolder chi
             * duoc gan MOT lan trong CANVAS.<init>, con CHARS.player khong co mot cho nao
             * gan null. Nen nhanh "Mat ket noi." cu chi bat duoc vai frame truoc khi vao
             * game lan dau, con rot mang that thi auto cu chay tiep vao khoang khong.
             */
            if (offline()) {
                holdOffline();
                return;
            }
            if (offlineHold) resumeOnline();
            lastAlive = now();
            if (playerDead()) {
                if (reviveAutoOn()) return;
                stop("Nhân vật đã chết.");
                return;
            }
            /*
             * Theo doi doi map o DAY, khong phai trong routeTowards. Khi mat bo thi
             * stepHaul re sang fetchCowFromPrevMap va khong bao gio goi routeTowards nua,
             * nen prevMapId se van la -1 va tinh nang dung ngay voi ly do "khong tim thay
             * de quay lai don" - dung nhu loi da gap.
             */
            int here = mapId();
            if (here >= 0 && here != lastMapId) {
                if (lastMapId >= 0) prevMapId = lastMapId;
                lastMapId = here;
                gateSince = 0L;
                gateBackOff = false;
                mapChangedAt = now();
                cowGoneSince = 0L;
                routeMissSince = 0L;
                fetchRuns = 0;     // qua duoc mot cong la co tien do that, dem lai tu dau
                clearPlan();       // ban do khac roi, duong di cu vo nghia
                /*
                 * Quen diem lui ra cong. Diem nay duoc ghi tren map CU; giu lai thi ngay
                 * sau khi qua cong, neu gap nhanh lui-ra-buoc-vao-lai, nhan vat se chay toi
                 * mot toa do cua map truoc - tuc la lao di dau do giua map moi.
                 */
                preGateX = 0;
                preGateY = 0;
            }
            // Theo doi con bo o mot cho duy nhat, de moi buoc doi chieu cung mot moc thoi gian.
            if (cow() != null) cowGoneSince = 0L;
            else if (cowGoneSince == 0L) cowGoneSince = now();
            /*
             * Hop thong bao xu ly o DAY, mot cho duy nhat.
             *
             * Truoc kia moi buoc tu lo phan minh, nen buoc HAUL - buoc khong he cho hop
             * thoai nao - bo qua luon: mua vien cuoi xong, hop "Da mua 1 Kim cuong" cua
             * server ve CHAM hon mot frame nen luc do da sang HAUL, va nhan vat di qua di
             * lai voi cai hop chan tren mat.
             */
            pollInfo();

            if (dialogOpen()) {
                String text = dialogText();
                /*
                 * Hop cua he thong ("Ban bi mat ket noi voi may chu.", "Dang ket noi lai.
                 * Vui long cho.") thi khong duoc dung toi. Bam phim mem se kich hoat DONG
                 * DAU TIEN cua hop - co truong hop dong do la "Thoat" - va vong tu ket noi
                 * lai 30 giay cua client chay trong chinh tick cua hop, dong hop di la
                 * vong do khong chay nua.
                 */
                if (isLinkDialog(text)) return;
                if (text != null) lastDialogText = text;
                if (dialogSince == 0L) {
                    dialogSince = now();
                } else if (!dialogTold && now() - dialogSince > DIALOG_STUCK_MS) {
                    dialogTold = true;
                    notice("Hộp thông báo không đóng được, vẫn đang thử.");
                }
                /*
                 * Rieng chuoi goi / huy bo thi bam cham lai mot nhip: hop xac nhan cua
                 * server co khi ve cham nua giay, bam ngay khung hinh dau tien la de dinh
                 * vao dung luc no vua dung xong.
                 */
                if (slowCowStep() && now() - dialogSince < SPAWN_STEP_MS) return;
                pressOk();
                return;
            }
            if (dialogSince != 0L) dialogClosedAt = now();
            dialogSince = 0L;
            dialogTold = false;

            /*
             * Bam dong menu NPC o day chu khong bam ngay trong onNpcMenu: bam ngay la hai
             * cap menu duoc chon cach nhau vai milli giay, server tra ve "Thao tac qua
             * nhanh" va khong ban duoc.
             */
            if (pendRow >= 0) {
                if (now() - pendAt < MENU_DELAY_MS) return;
                short npc = pendNpc;
                byte menu = pendMenu;
                byte row = (byte) pendRow;
                boolean sell = pendIsSell;
                boolean boost = pendIsBoost;
                pendRow = -1;
                pendIsSell = false;
                pendIsBoost = false;
                if (sell) grahamAsked = true;
                if (boost) {
                    boostDone = true;
                    notice("Đã bấm tăng tốc cho bò.");
                }
                sender().@sender.npcMenuSelect@(npc, menu, row);
                lastAction = now();
                return;
            }

            watchStuck();

            // Tat tang toc thi dat cham di mot nua -> han cua chang dat bo gap doi.
            long limit = state == HAUL ? (boostOn ? HAUL_TIMEOUT_MS : HAUL_TIMEOUT_MS * 2)
                                       : STATE_TIMEOUT_MS;
            if (now() - stateSince > limit) {
                stop(join("Quá hạn ở bước ", STATE_LABEL[state]));
                return;
            }

            switch (state) {
                case GOTO_START:  stepGotoStart();  break;
                case SPAWN_PET:   stepSpawnPet();   break;
                case TALK_DYLAN:  stepTalkDylan();  break;
                case BUY:         stepBuy();        break;
                case HAUL:        stepHaul();       break;
                case TALK_GRAHAM: stepTalkGraham(); break;
                case RETURN_HOME: stepReturnHome(); break;
                case BOOST_PET:   stepBoostPet();   break;
                case WAIT_STOCK:  stepWaitStock();  break;
                case DISMISS_COW: stepDismissCow(); break;
                default: break;
            }
        } catch (Throwable t) {
            System.out.println("HSOAUTO: tick error " + t.toString());
            stop("Lỗi bất ngờ, đã dừng.");
        }
    }

    /**
     * Dung mot cho qua lau thi bao ra roi tu go ket.
     *
     * Cai nay sinh ra vi lan truoc auto dung im khong mot dong bao nao: dung im la trang
     * thai co the xay ra o nhieu nguyen nhan khac nhau (bo khong duoc keo, engine khong
     * tieu thu duong di, khong con o man hinh game...) nen phai bao ro dang ket vi cai gi.
     */
    static void watchStuck() {
        @class.PLAYER@ me = player();
        if (me == null) return;
        int x = me.@player.x@;
        int y = me.@player.y@;
        if (x != lastSeenX || y != lastSeenY) {
            lastSeenX = x;
            lastSeenY = y;
            lastMoveAt = now();
            stuckTold = false;
            return;
        }
        if (lastMoveAt == 0L) {
            lastMoveAt = now();
            return;
        }
        if (now() - lastMoveAt <= STUCK_MS) return;
        lastMoveAt = now();
        if (state != HAUL && state != GOTO_START && state != RETURN_HOME) return;

        if (!stuckTold) {
            stuckTold = true;
            StringBuffer sb = new StringBuffer("Kẹt tại ");
            sb.append(x).append(',').append(y);
            sb.append(" map ").append(mapId());
            sb.append(" - bò ").append(cowGap()).append("px");
            sb.append(me.@player.path@ == null ? ", chưa có đường đi" : ", đang có đường đi");
            if (!onGameScreen()) sb.append(", KHÔNG ở màn hình game");
            notice(sb.toString());
        }
        // Tu go ket: bo duong di dang treo de vong sau tinh lai tu dau.
        haltWalk(me);
        lastStep = 0L;
    }

    /**
     * Con o man hinh game khong. Dung lai hai helper co san trong jar cua
     * HSOSKYPetFeedSupport (chung chi doc mot field static cua CANVAS).
     */
    static boolean onGameScreen() {
        try {
            Object cur = HSOSKYPetFeedSupport.getCurrentScreen();
            return cur != null && cur == HSOSKYPetFeedSupport.getGameScreen();
        } catch (Throwable t) {
            return true;   // khong biet thi coi nhu binh thuong, khong bao nham
        }
    }

    /** Vua doi map xong, du lieu map (danh sach thuc the, bang cong) chua chac da nap du. */
    static boolean mapSettling() {
        return now() - mapChangedAt < MAP_SETTLE_MS;
    }

    /** Mat bo du lau de tin la that, chu khong phai cua so trong luc doi map. */
    static boolean cowReallyGone() {
        return cowGoneSince != 0L && now() - cowGoneSince >= COW_GONE_MS && !mapSettling();
    }

    // --------------------------------------------------------- tung buoc

    static void stepGotoStart() {
        if (mapId() != MAP_START) {
            routeTowards(MAP_START, false);
            return;
        }
        if (!arrived(START_X, START_Y)) {
            stepToward(START_X, START_Y, false);
            return;
        }
        setState(SPAWN_PET);
    }

    static void stepSpawnPet() {
        if (cow() != null) {
            spawnTries = 0;
            cowSummonedAt = now();
            boolean byName = cowByName;
            beginTrip();
            // Ghi ro nhan dang bang duong nao: neu sau do lai mat bo thi biet ngay la do
            // vo nham con chua kip mang ten hay khong.
            notice(byName ? "Đã gọi được bò vàng (khớp tên), sang chỗ Dylan."
                          : "Đã gọi được bò vàng (chưa có tên chủ), sang chỗ Dylan.");
            setState(TALK_DYLAN);
            return;
        }
        // Hop xac nhan "Ban co 30 phut buon..." do tick() dong, khong xu ly o day.
        // Doi mot nhip sau khi hop vua dong, roi doi han SPAWN_WAIT_MS ke tu lan dung
        // truoc: bam lai som la huy mat con bo server vua tao cho minh.
        if (now() - dialogClosedAt < SPAWN_STEP_MS) return;
        if (lastAction != 0L && now() - lastAction < SPAWN_WAIT_MS) return;
        if (spawnTries >= MAX_SPAWN_TRIES) {
            stop("Dùng Bò vàng nhiều lần mà không thấy bò hiện ra.");
            return;
        }
        // Dung han lai roi hay bam: bam giua luc con dang di la con bo duoc tao o cho khac.
        if (!standStill()) return;
        lastAction = now();
        int cowId = findCowItemId();
        if (cowId < 0) {
            stop("Hết Bò vàng trong hành trang.");
            return;
        }
        spawnTries++;
        sender().@sender.useItem4@((short) cowId);
    }

    /*
     * PHAI mo cua hang cua Dylan that. Ban dau chi dung gan roi ban thang goi 24 vi ban
     * server tham chieu chi doi khoang cach toi NPC -57, nhung server dang chay thi khong
     * mua duoc - nguoi choi da xac nhan bang cach choi thu.
     *
     * Mo duoc cua hang la nho tick() chay o MOI man hinh (moc dat trong CANVAS chu khong
     * phai trong ENGINE.update() - cai do chi chay tren man hinh game).
     */
    static void stepTalkDylan() {
        /*
         * Dylan bao khong thay con vat di buon => con bo dang vo khong phai cua minh, hoac
         * that ra chua he goi duoc con nao. Danh dau no lai roi ve buoc goi bo. Khong co dau
         * hieu nao chac hon the: chinh server vua noi thang la minh khong co bo.
         */
        if (lastAction != 0L && lastDialogText != null
                && lastDialogText.indexOf(NO_PET_MARK) >= 0) {
            lastDialogText = null;
            markAlien(cowRef);
            cowRef = null;
            notice("Dylan không thấy con bò - hoá ra chưa gọi được, gọi lại.");
            spawnTries = 0;
            setState(SPAWN_PET);
            return;
        }
        if (cow() == null) {
            // Dang o map 52 canh Dylan roi - goi con moi ngay tai cho.
            cowVanished("trước khi mua ngọc", SPAWN_PET);
            return;
        }
        if (shopScreen != null) {
            notice("Đã mở được cửa hàng của Dylan, bắt đầu mua kim cương.");
            setState(BUY);
            return;
        }
        if (!within(START_X, START_Y, NPC_TALK_PX)) {
            stepToward(START_X, START_Y, true);
            return;
        }
        /*
         * Dung sat Dylan roi thi cho them mot nhip cho ten chu ve (server gan ten o nhip keo
         * pet moi giay). Co ten la chac chan bo cua minh, bat chuyen khong so bi tu choi.
         * Het han cho thi cu bat chuyen - loi tu choi da co nhanh tren bat lai.
         */
        if (!cowByName && now() - stateSince < PET_NAME_WAIT_MS) return;
        if (now() - lastAction < 2500L) return;
        lastAction = now();
        // Xoa hop cu truoc khi hoi: co the nhanh tren moi dam ket luan "khong co bo" tu
        // hop tra loi cua CHINH lan hoi nay, chu khong phai tu mot hop con sot lai.
        lastDialogText = null;
        talkingNpc = (short) npcIdOf(NPC_DYLAN, NPC_DYLAN_ID);
        sender().@sender.requestNpcMenu@((byte) talkingNpc);
    }

    static void stepBuy() {
        if (cow() == null) {
            // Van dung canh Dylan: goi con moi roi mua lai tu dau.
            cowVanished("trong lúc mua ngọc", SPAWN_PET);
            return;
        }
        if (shopScreen == null) {
            /*
             * Cua hang dong giua chung - hay gap nhat la vua vao lai game sau khi rot mang.
             * Mo lai chu khong dung auto: gemsBought duoc giu nguyen nen quay lai day la mua
             * tiep dung cho dang do, khong phai lam lai tu dau.
             */
            notice(join("Cửa hàng đã đóng, mở lại để mua tiếp (đã có ",
                    gemsBought + " viên)."));
            setState(TALK_DYLAN);
            return;
        }
        if (buyPending && !settleBuy()) return;

        if (gemTier >= GEM_NAMES.length || gemsBought >= MAX_GEMS) {
            closeShop();
            /*
             * Mua duoc vien nao thi cu dat di ban, dung tham cho cho day bo: bo chi song 30
             * phut, ma cho lai con nghia la mang so ngoc dang co tren lung no ra danh cuoc.
             * Chi khi CHUA mua duoc gi (khong co gi de mat) moi dung lai cho NPC nhap hang.
             */
            if (gemsBought > 0) {
                notice(join("Mua xong ", gemsBought + " viên, bắt đầu dắt bò."));
                setState(boostOn ? BOOST_PET : HAUL);
                return;
            }
            notice("Hết cả 3 loại ngọc, ra ngoài chờ NPC nhập hàng.");
            stockPolledAt = now();
            setState(WAIT_STOCK);
            return;
        }
        if (lastAction != 0L && now() - lastAction < BUY_INTERVAL_MS) return;

        /*
         * Loai da het thi server BO HAN no khoi danh sach hang (nguoi choi thay cua hang
         * chi con 3 o thay vi 4). Nen khong tim thay tuc la het, chuyen sang loai sau.
         */
        int id = gemIdInShop(GEM_NAMES[gemTier]);
        if (id < 0) {
            nextGemTier(join("Cửa hàng không còn ", GEM_NAMES[gemTier] + "."));
            return;
        }
        lastAction = now();
        buyPending = true;
        lastDialogText = null;      // hop cu (vi du bang gia luc mo cua hang) khong tinh
        lastInfoText = null;        // dong thong bao cu cung khong tinh cho lan mua nay
        sender().@sender.buy@((byte) shopScreen.@shop.type@, (short) id, (short) 1);
    }

    /**
     * Doc ket qua cua lan mua vua roi. Tra ve true khi da xu ly xong, false khi con phai cho.
     *
     * Danh sach hang chi phan anh luc MO cua hang, nen neu ngoc het GIUA CHUNG thi phai dua
     * vao hop tra loi cua server. Mua duoc thi hop luon co manh "Đã mua 1 ..." - thieu manh
     * do la coi nhu khong mua duoc loai nay nua.
     *
     * Huong an toan la coi nhu MUA DUOC: khong co hop nao ve thi van dem la thanh cong, de
     * neu ban server nao do khong bao gi thi auto van chay chu khong tut bac oan - dung
     * kieu sai da mac phai khi coi "co hop thoai" la dau hieu bi tu choi.
     */
    static boolean settleBuy() {
        /*
         * Het hang giua chung thi server KHONG gui hop thoai, chi chay mot dong chu o dau
         * man hinh. Phai xet dong do TRUOC, khong thi roi vao nhanh "khong co hop tra loi
         * => coi nhu mua duoc" va auto dem nham, bam mua mai mot loai da het.
         */
        if (isSoldOut(lastInfoText)) {
            String why = trim(lastInfoText, 60);
            lastInfoText = null;
            lastDialogText = null;
            buyPending = false;
            nextGemTier(join("Hết hàng: ", why + "."));
            return true;
        }
        String reply = lastDialogText;
        if (reply == null) {
            if (now() - lastAction < BUY_REPLY_MS) return false;
            buyPending = false;
            /*
             * Mua duoc thi server LUON tra ve mot hop "Da mua 1 ..." - khong co hop nao tuc
             * la khong mua duoc. Truoc day cho nay coi nhu mua duoc de phong ban server nao
             * do khong bao gi, nhung nhu the la khi het hang that thi auto dem khong va bam
             * mua den het gio. Cho them mot lan nua roi moi ket luan, de mot goi tin ve
             * cham khong bi tinh oan.
             */
            if (++noReplyRun >= MAX_NO_REPLY) {
                nextGemTier("Mua không thấy hồi âm.");
            }
            return true;
        }
        lastDialogText = null;
        buyPending = false;
        if (reply.indexOf(BUY_OK_MARK) >= 0 && reply.indexOf(GEM_NAMES[gemTier]) >= 0) {
            noReplyRun = 0;
            countGem();
        } else {
            nextGemTier(join("Không mua được: ", trim(reply, 70)));
        }
        return true;
    }

    static void countGem() {
        gemsBought++;
        if (gemsBought == 1 || gemsBought == MAX_GEMS || gemsBought % 8 == 0) {
            notice(join("Đã mua ", gemsBought + "/" + MAX_GEMS + " (" + GEM_NAMES[gemTier] + ")"));
        }
    }

    /** Het loai dang mua thi xuong loai sau; het bang thi thoi, di ban voi so da co. */
    static void nextGemTier(String why) {
        gemTier++;
        noReplyRun = 0;
        if (gemTier < GEM_NAMES.length) {
            notice(join(why, " Chuyển sang mua " + GEM_NAMES[gemTier] + "."));
        } else {
            notice(join(why, " Hết loại để mua."));
        }
        lastAction = now();
    }

    /** Id mot loai ngoc doc tu danh sach hang cua chinh cua hang dang mo, hoac -1. */
    static int gemIdInShop(String gemName) {
        @class.SHOP@ shop = shopScreen;
        if (shop == null) return -1;
        @class.VEC@ list = shop.@shop.items@;
        if (list == null) return -1;
        for (int i = 0; i < list.@vec.size@(); i++) {
            Object o = list.@vec.get@(i);
            if (!(o instanceof @class.ITEM@)) continue;
            @class.ITEM@ it = (@class.ITEM@) o;
            String name = itemName(it);
            if (name != null && name.toLowerCase().indexOf(gemName) >= 0) return it.@item.id@;
        }
        return -1;
    }

    /** Duoc chen vao cuoi <init> cua man hinh cua hang. */
    public static void onShopOpened(@class.SHOP@ shop) {
        try {
            if (state == TALK_DYLAN || state == BUY) shopScreen = shop;
        } catch (Throwable t) {
            // khong duoc lam sap game vi mot moc phu
        }
    }

    /** Dong cua hang dung cach client tu dong (xu ly "quay lai" cua man hinh). */
    static void closeShop() {
        @class.SHOP@ shop = shopScreen;
        shopScreen = null;
        if (shop == null) return;
        try {
            shop.@screen.close@();
        } catch (Throwable t) {
            // dong khong duoc thi de nguyen, buoc sau se het han va bao loi
        }
    }

    /**
     * Bam "Tang toc" trong menu cua chinh con bo.
     *
     * Menu nay mo bang goi -30 voi id -56, va server tra ve menu mang mot id khac. Thu tu
     * cac dong khac nhau giua cac ban server (ban tham chieu la Thong tin/Bao ho/Hoi mau/
     * Tang toc, ban dang chay la Hanh trang/Tang toc/Bao ho/Hoi mau) nen chi khop theo nhan.
     *
     * Bam khong duoc thi bo qua, khong dung auto: day la tuy chon, khong phai buoc bat buoc.
     */
    static void stepBoostPet() {
        if (cow() == null) {
            cowVanished("trước khi tăng tốc", SPAWN_PET);
            return;
        }
        if (boostDone) {
            // Cho hop xac nhan "Ban muon tang toc..." ve va duoc dong het roi moi di.
            if (now() - lastAction < BOX_SETTLE_MS) return;
            setState(HAUL);
            return;
        }
        if (now() - stateSince > BOOST_TIMEOUT_MS) {
            notice("Không bấm được tăng tốc cho bò, cứ đi tiếp.");
            setState(HAUL);
            return;
        }
        if (lastAction != 0L && now() - lastAction < 2500L) return;
        lastAction = now();
        talkingNpc = (short) NPC_PET_ID;
        sender().@sender.npcMenuSelect@((short) NPC_PET_ID, (byte) 0, (byte) 0);
    }

    /**
     * Het ca 3 loai: dung gan Dylan, cu STOCK_POLL_MS lai vao hoi cua hang mot lan.
     *
     * Phai vao HOI THAT (mo cua hang roi thu mua) chu khong nhin danh sach hang: danh sach
     * van liet ke du 4 loai ngoc ke ca khi so luong bang 0, nen nhin no thi luc nao cung
     * tuong la con hang.
     */
    /**
     * Khong thay bo o mot buoc dung yen mot cho (chua mua xong, chua dat di dau).
     *
     * KHONG duoc ket luan ngay tu mot khung hinh: danh sach thuc the cua client co luc
     * trong mot nhip (mob duoc gui lai, vua doi khu, ten chu ve cham...). Truoc day ba buoc
     * nay tat auto ngay lap tuc, nen thinh thoang vua bao "Da goi duoc bo vang" xong la bao
     * "Mat con bo" ngay dong sau - dung loi nguoi choi gap.
     *
     * Cho het COW_GONE_MS roi moi tin. Luc do neu tren lung bo chua co gi thi goi con khac
     * (toi da MAX_RESPAWN lan mot chuyen, de khong dot sach Bo vang trong hanh trang); con
     * neu da mua duoc ngoc thi ngoc di theo bo luon, khong cuu duoc, dung han.
     */
    static void cowVanished(String when, int back) {
        if (!cowReallyGone()) return;
        cowRef = null;                 // con cu khong con nua, lan sau nhan dang lai tu dau
        /*
         * Mat bo thi LAM LAI CHUYEN chu khong tat auto. Server bao tri hai lan moi ngay, va
         * sau bao tri con bo bien mat - tat auto o day la moi lan bao tri xong la khong chay
         * nua cho toi luc nguoi choi de y. So ngoc dang tren lung bo thi mat that, khong cuu
         * duoc, nhung chuyen sau van chay binh thuong.
         *
         * Van co tran: MAX_RESPAWN lan lien tiep ma khong chuyen nao thanh cong thi dung,
         * de khong dot sach Bo vang trong hanh trang. Bo dem nay duoc xoa trong beginTrip(),
         * tuc moi lan goi duoc bo va di duoc mot chuyen la tinh lai tu dau.
         */
        if (++respawnRuns > MAX_RESPAWN) {
            stop(join("Mất bò ", MAX_RESPAWN + " lần liên tiếp mà không đi được chuyến nào, dừng."));
            return;
        }
        String lost = gemsBought > 0 ? (", mất luôn " + gemsBought + " viên đã mua") : "";
        notice(join("Mất con bò ", when + lost + ", làm lại chuyến."));
        gemsBought = 0;
        spawnTries = 0;
        fetchMapId = -1;
        setState(back);
    }

    /** Dang o chuoi thao tac goi / huy bo - noi duy nhat phai bam cham hon binh thuong. */
    static boolean slowCowStep() {
        return state == SPAWN_PET || state == DISMISS_COW;
    }

    static void stepWaitStock() {
        if (cow() == null) {
            cowVanished("trong lúc chờ NPC nhập hàng", SPAWN_PET);
            return;
        }
        // Bo sap het 30 phut thi huy di goi con moi - luc nay tren lung no khong co gi.
        if (now() - cowSummonedAt > COW_RESUMMON_AGE_MS) {
            notice("Bò sắp hết hạn mà chưa mua được gì, hủy rồi gọi con mới.");
            dismissTries = 0;
            setState(DISMISS_COW);
            return;
        }
        if (!within(START_X, START_Y, NPC_TALK_PX)) {
            stepToward(START_X, START_Y, false);
            return;
        }
        if (now() - stockPolledAt < STOCK_POLL_MS) return;
        stockPolledAt = now();
        gemTier = 0;                 // lan nao cung hoi lai tu kim cuong
        setState(TALK_DYLAN);
    }

    /**
     * Huy con bo bang cach dung lai chinh vat pham Bo vang, roi de SPAWN_PET goi con moi -
     * con moi duoc tinh lai tu dau 30 phut.
     *
     * Chi lam khi tren lung bo khong co gi: huy bo la mat sach ngoc dang tren no.
     */
    static void stepDismissCow() {
        if (cow() == null) {
            cowRef = null;
            notice("Đã hủy được bò, gọi con mới.");
            spawnTries = 0;
            setState(SPAWN_PET);
            return;
        }
        if (now() - dialogClosedAt < SPAWN_STEP_MS) return;
        if (lastAction != 0L && now() - lastAction < SPAWN_WAIT_MS) return;
        if (dismissTries >= MAX_SPAWN_TRIES) {
            stop("Không hủy được bò để gọi lại con mới.");
            return;
        }
        int cowId = findCowItemId();
        if (cowId < 0) {
            stop("Hết Bò vàng trong hành trang.");
            return;
        }
        if (!standStill()) return;     // nhu luc goi bo: dung han roi hay bam vat pham
        lastAction = now();
        dismissTries++;
        sender().@sender.useItem4@((short) cowId);
    }

    static void stepHaul() {
        if (cow() == null) {
            // Chua du lau de tin la mat bo: dung yen cho, dung quay dau chay nguoc lai.
            if (cowReallyGone()) fetchCowFromPrevMap();
            return;
        }
        if (fetchMapId >= 0) {
            fetchMapId = -1;
            notice("Đã tìm lại được bò.");
        }
        if (mapId() != MAP_SELL) {
            routeTowards(MAP_SELL, true);
            return;
        }
        if (!arrived(SELL_X, SELL_Y)) {
            stepToward(SELL_X, SELL_Y, true);
            return;
        }
        setState(TALK_GRAHAM);
    }

    /**
     * Khong thay bo tren map nay - gan nhu chac chan no o lai map vua roi (server chi cho bo
     * theo qua cong khi dang trong 125px). Quay ve do don, chu khong bo cuoc.
     */
    static void fetchCowFromPrevMap() {
        if (fetchMapId < 0) {
            // Khong biet no o dau (vua vao lai game chang han) - ve lam lai chuyen luon.
            if (prevMapId < 0 || prevMapId == mapId()) {
                restartTrip("Mất con bò, không rõ bỏ lại ở đâu");
                return;
            }
            fetchMapId = prevMapId;
            fetchSince = now();
            notice("Bò bị bỏ lại map trước, quay lại đón.");
        }
        if (mapId() == fetchMapId) {
            // Da ve toi noi ma van khong thay -> luc nay moi chiu la mat that.
            if (now() - fetchSince > COW_SEARCH_MS) {
                restartTrip("Quay lại map cũ cũng không thấy bò");
            }
            return;
        }
        routeTowards(fetchMapId, false);   // di nhanh, dang khong dat bo
    }

    /**
     * Mat bo khi dang o xa Cong dia nguc: ve do goi con moi va lam lai tu dau.
     *
     * Khong goi bo ngay tai cho vi con ngoc phai mua o cho Dylan; ve toi noi roi goi thi
     * dung mot vong nhu binh thuong.
     */
    static void restartTrip(String why) {
        cowRef = null;
        if (++respawnRuns > MAX_RESPAWN) {
            stop(join(why, ", va da " + MAX_RESPAWN + " lần liên tiếp như vậy - dừng."));
            return;
        }
        notice(join(why, ", quay về Cổng địa ngục làm lại chuyến."));
        gemsBought = 0;
        spawnTries = 0;
        fetchMapId = -1;
        setState(GOTO_START);
    }

    static void stepTalkGraham() {
        if (cow() == null) {
            // Ban xong thi server thu con bo -> chuyen buon hoan tat.
            if (grahamAsked) {
                cowRef = null;          // server thu bo roi, chuyen sau nhan dang lai tu dau
                notice("Bán xong đá quý, quay về làm chuyến mới.");
                // Chan tai vao nhanh nay lan nua trong cung mot chuyen; con lai de
                // beginTrip() dat lai khi goi duoc con bo moi.
                grahamAsked = false;
                setState(RETURN_HOME);
            } else if (cowReallyGone()) {
                fetchCowFromPrevMap();
            }
            return;
        }
        // Hop hoi "co dung vat pham x2 khong" do tick() dong y.
        if (!within(SELL_X, SELL_Y, NPC_TALK_PX)) {
            stepToward(SELL_X, SELL_Y, true);
            return;
        }
        if (now() - lastAction < 2500L) return;
        lastAction = now();
        talkingNpc = (short) npcIdOf(NPC_GRAHAM, NPC_GRAHAM_ID);
        sender().@sender.requestNpcMenu@((byte) talkingNpc);
    }

    static void stepReturnHome() {
        if (mapId() != MAP_START) {
            routeTowards(MAP_START, false);
            return;
        }
        setState(GOTO_START);
    }

    // ------------------------------------------------------------ menu NPC

    /**
     * Duoc chen vao dau ENGINE.onNpcMenuOpened(short, byte, Vector).
     * Tra ve true = da tu chon mot dong, khong hien menu ra man hinh nua.
     */
    public static boolean onNpcMenu(short npcId, byte menuId, @class.VEC@ items) {
        try {
            if (items == null) return false;
            if (reviveAutoOn() && reviveRequestSent && !reviveSelected && playerDead()) {
                int itemRow = indexOfLabel(items, LBL_REVIVE_ITEM);
                int okRow = indexOfLabel(items, LBL_REVIVE_OK);

                /*
                 * Luong that la:
                 *   menu 1: "Ban muon hoi sinh tai cho" -> OK/Huy
                 *   menu 2: "Dung vat pham hoi sinh" -> option 0
                 * Khong duoc coi menu 1 la menu vat pham, neu khong state se ket thuc
                 * truoc khi menu 2 xuat hien.
                 */
                boolean confirm = !reviveConfirmAccepted && itemRow < 0;
                if (confirm && okRow < 0 && items.@vec.size@() == 0) return false;
                byte row = (byte)(confirm ? (okRow >= 0 ? okRow : 0)
                                           : (itemRow >= 0 ? itemRow : 0));
                reviveNpc = npcId;
                reviveMenu = menuId;
                reviveMenuAt = now();
                reviveMenuRow = row;
                reviveConfirmMenuPending = confirm;
                reviveMenuPending = true;
                return true;
            }
            if (n4State != N4_OFF) return n4OnNpcMenu(npcId, menuId, items);
            if (state == BOOST_PET) {
                /*
                 * Menu cua con bo tra ve mot id KHAC id da gui, va id do lech giua cac ban
                 * server - nen o day khong doi id, chi can menu co dong "Tang toc".
                 */
                int row = indexOfLabel(items, LBL_SPEED);
                if (row < 0) return false;
                pendNpc = npcId;
                pendMenu = menuId;
                pendRow = row;
                pendIsBoost = true;
                pendAt = now();
                return true;
            }
            if (state != TALK_GRAHAM && state != TALK_DYLAN) return false;
            if (npcId != talkingNpc) return false;

            int pick;
            boolean sell = false;
            if (state == TALK_DYLAN) {
                // Dylan: "Mua bán" o ca hai cap menu, bam den khi cua hang mo ra.
                pick = indexOfLabel(items, LBL_SHOP);
            } else {
                // Uu tien "Bán đá quý"; chua thay thi bam "Giao tiếp" de mo menu con.
                pick = indexOfLabel(items, LBL_SELL_GEM);
                if (pick >= 0) {
                    sell = true;
                } else {
                    pick = indexOfLabel(items, LBL_TALK);
                }
            }
            if (pick < 0) return false;

            // Chi ghi nho lai; tick() se gui sau MENU_DELAY_MS.
            pendNpc = npcId;
            pendMenu = menuId;
            pendRow = pick;
            pendIsSell = sell;
            pendAt = now();
            return true;
        } catch (Throwable t) {
            return false;
        }
    }

    static int indexOfLabel(@class.VEC@ items, String needle) {
        for (int i = 0; i < items.@vec.size@(); i++) {
            @class.CMD@ cmd = (@class.CMD@) items.@vec.get@(i);
            if (cmd == null || cmd.@cmd.label@ == null) continue;
            if (cmd.@cmd.label@.toLowerCase().indexOf(needle) >= 0) return i;
        }
        return -1;
    }

    // ------------------------------------------------------------ di chuyen

    /*
     * Di THAT SU, khong dich chuyen.
     *
     * Ghi thang toa do roi ban goi 4 thi nhan vat "nhay" toi noi. Server chi mo cong khi
     * thay chuoi vi tri cua mot nguoi dang di bo (MapService: phai roi diem den cu hon 45px
     * moi bat co is_changemap, roi moi tinh chuyen o trong 40px quanh cong), nen kieu nhay
     * lam nhan vat dung sat mep map ma khong bao gio sang duoc map ben canh.
     *
     * Cach dung - giao mot duong di cho engine roi de engine tu buoc
     * va tu bao vi tri, y het luc nguoi choi tu di.
     *
     * player.path la mang o ma hoa (tileX << 8) | tileY; player.pathCursor la con tro chay
     * trong mang do, engine bat dau tu 1 va tu gan path = null khi di xong - nho vay
     * "path == null" chinh la tin hieu da toi noi.
     */
    static void stepToward(int tx, int ty, boolean leadingCow) {
        stepToward(tx, ty, leadingCow, true);
    }

    /** Di trong vung gan cong thi khong dung vi tri bo tren client lam chot quay dau. */
    static void stepToward(int tx, int ty, boolean leadingCow, boolean checkCow) {
        @class.PLAYER@ me = player();
        if (me == null) return;

        if (leadingCow && checkCow) {
            int gap = cowGap();
            if (gap < 0) {
                goFetchCow();             // khong thay bo nua
                return;
            }
            if (cowRecovering) {
                /*
                 * Da quay dau lai don thi phai bam SAT moi tinh la xong luot don.
                 *
                 * Da thu noi long cho nay (dung o nua nguong) va hong nang: luc do co ca
                 * mot DAI khoang cach ma ham don bao "du gan roi, khong di nua" con cho
                 * goi no van bao "bo chua dat yeu cau" - khong ben nao chiu phat lenh di.
                 * Ca nguoi lan bo dung im cho toi khi nguoi choi tu bam mot phim.
                 *
                 * Bam sat 20px thi dieu kien ket thuc luon CHAT HON moi dieu kien kich
                 * hoat (70px o cong, petLostPx() khi di duong), nen khong the ho ra dai
                 * chet nao. Doi lai la quay dau nhieu hon - nguoi choi chap nhan, vi
                 * "quay lai nhieu nhung it ra con dat duoc bo".
                 */
                if (gap > PET_STEP_OK) {
                    goFetchCow();
                    return;
                }
                cowRecovering = false;
                haltWalk(me);       // dang di nguoc ve phia bo -> bo duong do, tinh lai
                notice("Đã dắt lại được bò, đi tiếp.");
            } else if (gap > petLostPx()) {
                /*
                 * DA RA NGOAI PHAM VI AN TOAN thi quay lai NGAY, khong dung cho.
                 *
                 * Da co mot ban chen co che "dung yen mot nhip cho bo bam kip" vao day va
                 * ca vao chot cong, voi ly do server keo bo ve moi giay nen cho la du. Ly
                 * do do khong sai, nhung moi duong "cho" la them mot duong return truoc cho
                 * phat lenh di, va chinh chung la thu ghep lai thanh trang thai khong ai
                 * chiu di ca. Bo het: quay dau nhieu con hon dung im.
                 *
                 * Vua doi map thi vi tri con bo chua dang tin - cho het MAP_SETTLE_MS da.
                 */
                if (!mapSettling()) goFetchCow();
                return;
            }
            // Trong nguong thi cu di tiep. KHONG cho bo bam sat: nhip
            // HAUL_STEP_PX/HAUL_TICK_MS da du cham de bo luon theo kip.
        }

        if (me.@player.path@ != null) return;    // engine dang buoc, de yen cho no di
        long interval = leadingCow ? HAUL_TICK_MS : FAST_REPATH_MS;
        if (now() - lastStep < interval) return;
        lastStep = now();

        if (walkTo(tx, ty, leadingCow)) {
            pathFails = 0;
        } else if (++pathFails >= MAX_PATH_FAILS) {
            /*
             * Ham di chuyen nay dung chung cho ca hai tinh nang, nen phai tat dung cai dang
             * chay. Goi thang stop() thi Auto Nga 4 van chay tiep trong khi da bao la dung.
             */
            if (n4State != N4_OFF) {
                n4Stop("Không tìm được đường đi, đã dừng.");
            } else {
                stop("Không tìm được đường đi, đã dừng.");
            }
        }
    }

    /**
     * Bo tut lai qua xa thi quay dau lai don no.
     *
     * Cho tai cho la vo ich: server chi keo bo toi khi con trong tam keo, xa hon la no dung
     * im vinh vien. Nen phai tu di nguoc lai cho no.
     */
    static void goFetchCow() {
        @class.MOB@ c = cow();
        @class.PLAYER@ me = player();
        if (c == null || me == null) return;      // truong hop mat han do stepHaul lo
        if (!cowRecovering) {
            /*
             * Chan vong lap don-mai-khong-xong. Bo cua minh duoc keo ve moi giay nen mot
             * lan don la du han; phai don toi lan thu MAX_FETCH_RUNS tren CUNG MOT MAP ma
             * van chua yen thi co gi do khong on han - khong phai chuyen don them mot lan
             * nua la xong. Bo dem duoc xoa moi khi qua duoc mot cong, tuc moi khi that su
             * di duoc mot doan.
             *
             * CHI dem khi chua khop ten. Da khop ten thi chac chan la bo cua minh, don bao
             * nhieu lan cung cu don - quay dau nhieu van hon la bo mat con bo dang cam.
             */
            if (!cowByName && ++fetchRuns > MAX_FETCH_RUNS) {
                dropCow("Đón mãi mà bò không theo - không phải bò của mình, bỏ.");
                return;
            }
            cowRecovering = true;
            haltWalk(me);                          // cat ngang duong dang di toi
            notice("Bò tụt lại, quay lại dắt.");
        }

        /*
         * Di HET quang toi con bo, che do di nhanh - dang khong dat duoc no nen khong can
         * cat ngan.
         *
         * Da thu "di tung doan ngan, dung cach con bo mot doan" va hong: co mot dai khoang
         * cach ma ham nay khong phat mot lenh di nao, trong khi cho goi no van cho la chua
         * dat yeu cau. Duong nay di het quang nen khong bao gio ho ra dai nhu vay.
         */
        stepToward(cowX(c), cowY(c), false);
    }

    /** Dung ngay duong dang di. Dat y het cach engine ket thuc mot duong di. */
    static void haltWalk(@class.PLAYER@ me) {
        me.@player.path@ = null;
        me.@player.pathCursor@ = 0;
    }

    /**
     * Dung han lai truoc khi bam goi / huy bo. Tra ve true khi da that su dung yen.
     *
     * Ban mod khong dieu khien tung buoc chan: no giao han ca mot DUONG DI cho engine roi de
     * engine tu di het (walkTo). Nen bo tay ra khong lam nhan vat dung lai - engine van di
     * cho het duong da giao. Day chinh la cai nguoi choi goi la "di theo quan tinh huong bam
     * gan nhat". Truoc day buoc goi bo bam vat pham ngay giua luc do, roi con dung cho hop
     * xac nhan them nua giay nua, nen con bo bi tao lech han ra khoi cho dinh dat.
     *
     * Ha SPAWN_STEP_MS xuong chi lam quang troi ngan bot chu khong het. Muon het thi phai
     * dung han ca ba tang mot luc:
     *   - bo doan duong con lai            -> engine thoi giao buoc moi
     *   - keo diem den ve ngay cho dang dung -> thoi luon buoc dang di do dang
     *   - bao vi tri cho server             -> con bo duoc tao o conn.p.x/y cua SERVER chu
     *                                          khong phai toa do client dang ve
     *                                          (UseItem.java:97), nen server phai biet minh
     *                                          dung o dau thi diem tha bo moi dung.
     */
    static boolean standStill() {
        @class.PLAYER@ me = player();
        if (me == null) return false;
        if (me.@player.path@ != null
                || me.@player.stepDestX@ != me.@player.x@
                || me.@player.stepDestY@ != me.@player.y@) {
            haltWalk(me);
            me.@player.stepDestX@ = me.@player.x@;
            me.@player.stepDestY@ = me.@player.y@;
            sender().@sender.move@((short) me.@player.x@, (short) me.@player.y@);
            stillSince = now();
            return false;      // vong sau ca ba tang deu da dung -> chi con cho lang xuong
        }
        if (stillSince == 0L) stillSince = now();
        return now() - stillSince >= STAND_STILL_MS;
    }

    /** Giao duong di cho engine. Khi dat bo thi chi giao mot doan ngan de bo con kip theo. */
    static boolean walkTo(int tx, int ty, boolean leadingCow) {
        @class.PLAYER@ me = player();
        int tile = @class.TILEMAP@.@tilemap.tileSize@;
        if (me == null || tile <= 0) return false;

        int maxTiles = leadingCow ? haulTiles(tile) : FAST_MAX_TILES;
        // Bao ve ca khi sau nay doi hang so: player goc chi chap nhan path.length <= 20.
        if (maxTiles > 19) maxTiles = 19;
        if (maxTiles < 1) maxTiles = 1;

        int fromTx = me.@player.x@ / tile;
        int fromTy = me.@player.y@ / tile;
        int toTx = tx / tile;
        int toTy = ty / tile;
        /*
         * DA AP SAT DICH: ep buoc thang len o dich, khong tim duong nua.
         *
         * Day la mieng con thieu cua hai ban truoc, va la ly do lan nao cung "di den gan
         * cong roi lai chay ra cho khac".
         *
         * Cong duoc ghi bang TOA DO PIXEL; o duoi chan no thuong khong phai o di duoc trong
         * ban do that (cong hay nam sat vien map). Tat Noclip thi findPath khong bao gio
         * dat duoc chan len o do: hoac tra ve null, hoac vong ra loi khac. The la nhan vat
         * cu lan quan quanh cong ma khong bao gio vao trong 40px ma server doi de mo cong.
         *
         * Legacy path policy giai dung cho nay: vao trong MOT o quanh cong la thoi tim duong, giao
         * cho nhan vat mot duong di DUY NHAT MOT O - chinh o cua cong - roi de engine buoc
         * thang len. Duong mot phan tu thi con tro phai bat dau tu 0 (khong co o "dang
         * dung" o dau mang nhu duong binh thuong).
         *
         * Chi lam khi da trong GATE_FORCE_TILES o, nen doan di thang luon rat ngan.
         */
        if (!noclipOn && within(tx, ty, tile * GATE_FORCE_TILES)
                && walkableTile(toTx, toTy)) {
            return forceStep(me, tile, tx, ty);
        }

        short[] path = noclipOn
                ? straightPath(fromTx, fromTy, toTx, toTy, maxTiles)
                : realPath(fromTx, fromTy, toTx, toTy, maxTiles);
        if (path == null) {
            // Dang dung dung o dich thi khong co gi de di - dung, chu khong phai loi.
            return fromTx == toTx && fromTy == toTy;
        }

        me.@player.stepDestX@ = me.@player.x@;
        me.@player.stepDestY@ = me.@player.y@;
        me.@player.path@ = path;
        me.@player.pathCursor@ = 1;
        me.@player.startMove@();
        return true;
    }

    /**
     * Giao cho engine mot duong di DUY NHAT MOT O: chinh o dich.
     *
     * Khong qua ham tim duong, nen khong the bi tu choi vi o dich khong di duoc. Dung cach
     * Legacy path policy ep buoc cuoi vao cong (forcePortalStep): dat luon diem den roi giao duong
     * mot phan tu, con tro 0.
     *
     * Con tro phai la 0 chu khong phai 1: duong binh thuong co phan tu 0 la o DANG DUNG nen
     * engine bat dau tu 1, con duong nay chi co dung o dich.
     */
    static boolean forceStep(@class.PLAYER@ me, int tile, int tx, int ty) {
        int toTx = tx / tile;
        int toTy = ty / tile;
        if (!tileInRange(toTx) || !tileInRange(toTy)) return false;
        haltWalk(me);
        me.@player.stepDestX@ = tx;
        me.@player.stepDestY@ = ty;
        short[] one = new short[1];
        one[0] = tileWord(toTx, toTy);
        me.@player.path@ = one;
        me.@player.pathCursor@ = 0;
        me.@player.startMove@();
        return true;
    }

    /**
     * Dung mot duong di THANG tu o dang dung toi o dich khi Noclip dang bat.
     *
     * Dinh dang mang phai khop dung cach engine giai ma (xem vong di cua PLAYER):
     *   tileX = (byte)(path[i] >> 8)     tileY = (byte) path[i]
     * tuc moi o la (tileX << 8) | (tileY & 0xFF), va vi ep kieu byte nen toa do o phai
     * nam trong 0..127. Phan tu 0 la o dang dung, vi engine bat dau con tro tu 1.
     *
     * maxTiles chi cat ngan doan duoc giao lan nay, huong di van la huong toi dich.
     */
    static short[] straightPath(int fromTx, int fromTy, int toTx, int toTy, int maxTiles) {
        return PathPlanner.straightPath(fromTx, fromTy, toTx, toTy, maxTiles);
    }

    /**
     * Tim duong bang engine khi Noclip tat. Engine goc goi findPath voi dich truoc,
     * vi tri hien tai sau; ket qua tra ve da la huong hien tai -> dich.
     */
    static short[] realPath(int fromTx, int fromTy, int toTx, int toTy, int maxTiles) {
        if (!tileInRange(fromTx) || !tileInRange(fromTy)
                || !tileInRange(toTx) || !tileInRange(toTy)) return null;
        @class.CHARS@ screen = @class.CANVAS@.@canvas.currentScreen@;
        if (screen == null) return null;

        short[] plan = plannedPath(screen, fromTx, fromTy, toTx, toTy);
        if (plan == null) return null;

        /*
         * Dang dung o dau tren ke hoach?
         *
         * Truoc day cho nay doi nhan vat phai dung DUNG tren mot o cua ke hoach, khong thi
         * vut ca ke hoach di va tinh lai. Do la mot cho hong lon: nhan vat di theo pixel,
         * chi lech nua o la da roi khoi ke hoach, va lan tinh lai tu cho moi rat de ra mot
         * loi vong khac - the la quay dau. Chinh la loi "di gan toi noi thi tu nhien chay
         * ra cho khac roi chay vong vo".
         *
         * Gio chi can dang o CANH ke hoach (lech toi da mot o) la di tiep, va buoc dau
         * tien la buoc tro lai len ke hoach.
         */
        int at = nearestOnPath(plan, fromTx, fromTy);
        if (at < 0) {
            clearPlan();
            return null;
        }
        boolean onPlan = plan[at] == tileWord(fromTx, fromTy);
        int left = onPlan ? plan.length - 1 - at : plan.length - at;
        if (left <= 0) {
            clearPlan();        // da di het ke hoach
            return null;
        }

        int steps = left < maxTiles ? left : maxTiles;
        int src = onPlan ? at + 1 : at;
        short[] out = new short[steps + 1];
        out[0] = tileWord(fromTx, fromTy);      // phan tu 0 luon la o DANG dung
        for (int i = 1; i <= steps; i++) {
            out[i] = plan[src + i - 1];
        }
        return out;
    }

    /**
     * Vi tri cua nhan vat tren ke hoach: chi so cua o gan nhat, hoac -1 neu da di qua xa.
     *
     * Cho phep lech mot o vi nhan vat di theo pixel chu khong nhay tung o; doi khop tuyet
     * doi thi ke hoach bi vut di lien tuc.
     */
    static int nearestOnPath(short[] path, int fromTx, int fromTy) {
        if (path == null) return -1;
        int best = -1;
        int bestDist = Integer.MAX_VALUE;
        for (int i = 0; i < path.length; i++) {
            int dx = Math.abs(((path[i] >> 8) & 0xFF) - fromTx);
            int dy = Math.abs((path[i] & 0xFF) - fromTy);
            int d = dx > dy ? dx : dy;
            if (d < bestDist) {
                bestDist = d;
                best = i;
            }
        }
        return bestDist <= 1 ? best : -1;
    }

    /**
     * Ke hoach duong di toi o dich, tinh MOT LAN roi dung lai cho cac nhip sau.
     *
     * Vi sao khong tinh lai moi nhip: mot nhip chi giao cho engine mot doan ngan, xong lai
     * tinh lai tu vi tri moi. Duong thang thi khong sao - tinh lai van ra dung duong do.
     * Nhung duong di THAT thi vong qua chuong ngai, va tu hai vi tri gan nhau, ham tim
     * duong co the tra ve hai loi vong khac han nhau (trai hay phai deu dai bang nhau).
     * The la nhip nay di sang trai, nhip sau di sang phai, roi lai sang trai - nhan vat
     * chay vong vo tai cho, khong toi dau ca. Dung loi nguoi choi gap ngay o buoc dau
     * tien sau khi tat Noclip.
     *
     * Legacy path policy lam dung the nay: tinh ca duong roi giao han cho nhan vat (assignPlayerPath),
     * khong tinh lai tung nhip. Chinh engine goc cung vay.
     *
     * Ke hoach chi duoc tinh lai khi: chua co, doi o dich, doi map, hoac nhan vat khong con
     * dung tren duong da vach (bi day ra, hoac tu di cho khac).
     */
    static short[] plannedPath(@class.CHARS@ screen, int fromTx, int fromTy,
            int toTx, int toTy) {
        if (planPath != null && planMapId == mapId() && planTx == toTx && planTy == toTy
                && nearestOnPath(planPath, fromTx, fromTy) >= 0) {
            return planPath;
        }

        /*
         * Hai tang, dung thu tu cua path policy (buildPathToTile):
         *
         *   1. Hoi ham tim duong cua engine. Nhanh, va la loi di ma chinh game dung.
         *   2. Engine chiu thua (hoac tra ve duong dai qua muc tin duoc) thi TU DO RONG lay
         *      tren ban do o that.
         *
         * Tang 2 la thu mod nay thieu tu dau, va la ly do map lon khong bao gio tim ra
         * duong: ham cua engine chi lam viec trong tam ngan, di xa la no bo cuoc, ma bo
         * cuoc thi truoc day coi nhu khong co duong. Path policy co dung tang nay va chay
         * duoc; day la thuat toan tim duong hai tang.
         *
         * Ham do rong cung tra loi luon cau hoi "o dich khong dat chan len duoc thi di dau":
         * no chon o GAN DICH NHAT trong so cac o that su den duoc, thay vi do tung o mot
         * bang engine nhu ban v24 - do kieu do moi nhip ra mot dap an khac nen nhan vat
         * nhay qua nhay lai quanh cong.
         */
        short[] found = null;
        if (walkableTile(toTx, toTy)) {
            found = askPath(screen, fromTx, fromTy, toTx, toTy);
        }
        if (found == null) {
            found = gridPath(fromTx, fromTy, toTx, toTy, GATE_APPROACH_TILES);
        }
        if (found == null) return null;

        planPath = found;
        planTx = toTx;          // khoa theo o dich DA YEU CAU, khong phai o thay the
        planTy = toTy;
        planMapId = mapId();
        return planPath;
    }

    /**
     * Hoi engine mot duong di, va chi nhan khi no that su di tu cho dang dung toi dung dich.
     *
     * Thu tu tham so la DICH truoc, vi tri hien tai sau - doc tu chinh cho engine goi
     * findPath (nap toa do doi tuong dich, roi moi nap CHARS.player), va path policy goi ham
     * tuong ung cua no cung theo thu tu do. Ket qua tra ve da theo huong hien tai -> dich,
     * phan tu 0 la o dang dung (engine dat con tro = 1 ngay sau khi nhan duong).
     *
     * Tham so cuoi la PATH_BUDGET: ca ba cho engine goi ham nay deu truyen 5000.
     */
    static short[] askPath(@class.CHARS@ screen, int fromTx, int fromTy, int toTx, int toTy) {
        if (!tileInRange(toTx) || !tileInRange(toTy)) return null;
        short[] found;
        try {
            found = screen.@screen.findPath@(toTx, toTy, fromTx, fromTy, PATH_BUDGET);
        } catch (Throwable t) {
            return null;        // ban do chua nap xong chang han
        }
        if (found == null || found.length < 2
                || found.length > ENGINE_PATH_MAX
                || found[0] != tileWord(fromTx, fromTy)
                || found[found.length - 1] != tileWord(toTx, toTy)) return null;
        return found;
    }

    // ------------------------------------------------------- ban do o that

    /**
     * Mang o cua ban do dang mo. Moi o mot so; 1 va -1 la o CHAN, con lai la di duoc.
     *
     * Chinh ham hoi o cua engine doc mang nay: idx = (pixelY / o) * rong + (pixelX / o).
     * Doc thang mang thay vi goi ham do vi ham do da bi mod cai Noclip vao giua (adjustTile
     * bien moi o thanh di duoc), ma o day can dia hinh THAT.
     */
    static int[] tileGrid() {
        @class.TILEMAP@ m = @class.CANVAS@.@canvas.mapHolder@;
        return m == null ? null : m.@tilemap.tiles@;
    }

    /** So o theo chieu ngang cua ban do dang mo. */
    static int gridWidth() {
        @class.TILEMAP@ m = @class.CANVAS@.@canvas.mapHolder@;
        return m == null ? 0 : m.@tilemap.width@;
    }

    /** O nay co dat chan len duoc khong (theo dia hinh THAT, khong tinh Noclip). */
    static boolean walkableTile(int tx, int ty) {
        int[] grid = tileGrid();
        int w = gridWidth();
        if (grid == null || w <= 0) return false;
        int h = grid.length / w;
        if (tx < 0 || ty < 0 || tx >= w || ty >= h) return false;
        if (!tileInRange(tx) || !tileInRange(ty)) return false;
        int cell = grid[ty * w + tx];
        return cell != 1 && cell != -1;
    }

    /**
     * Tu tim duong bang cach do rong (BFS) tren ban do o that.
     *
     * Day la tang duoi (buildGridPathToTile) va la thu mod nay thieu tu dau.
     * Ham tim duong cua engine chi lam viec trong tam ngan; di xa la no bo cuoc, va truoc
     * day bo cuoc dong nghia voi "khong co duong" - dung loi "map lon khong tim duoc duong
     * di". Do rong thi khong co tam: no duyet het ban do, co loi la ra loi.
     *
     * Do rong MOT lan tu cho dang dung, roi trong so cac o den duoc chon o gan DICH nhat
     * (trong ban kinh cho phep). Nho vay khi o dich bi chan - cong hay nam sat vien map -
     * van co mot cho dung hop ly, va quan trong hon la lan nao cung ra CUNG mot cho, khong
     * doi y giua chung nhu ban do-tung-o-bang-engine truoc day.
     *
     * Duong tra ve co phan tu 0 la o dang dung, giong het dinh dang cua engine.
     */
    static short[] gridPath(int fromTx, int fromTy, int toTx, int toTy, int radius) {
        return PathPlanner.gridPath(tileGrid(), gridWidth(), fromTx, fromTy,
                toTx, toTy, radius);
    }

    /** Mot buoc cua ham do rong: nhan o ke neu di duoc va chua tham. */
    static int pushTile(int[] grid, int w, int h, int x, int y, int from, int tail) {
        if (x < 0 || y < 0 || x >= w || y >= h) return tail;
        if (!tileInRange(x) || !tileInRange(y)) return tail;   // duong ma hoa 1 byte moi truc
        int idx = y * w + x;
        if (bfsDist[idx] >= 0) return tail;
        int cell = grid[idx];
        if (cell == 1 || cell == -1) return tail;
        bfsDist[idx] = bfsDist[from] + 1;
        bfsPrev[idx] = from;
        bfsQueue[tail++] = idx;
        return tail;
    }

    static void clearPlan() {
        planPath = null;
        planTx = -1;
        planTy = -1;
        planMapId = -1;
    }

    static boolean tileInRange(int t) {
        return PathPlanner.tileInRange(t);
    }

    static short tileWord(int tx, int ty) {
        return PathPlanner.tileWord(tx, ty);
    }

    /** Di toi cong dan sang map ke tiep tren duong toi targetMap. */
    static void routeTowards(int targetMap, boolean leadingCow) {
        int here = mapId();               // tick() da cap nhat lastMapId/prevMapId
        /*
         * Ca hai that bai duoi day deu co the chi la tam thoi: ngay sau khi qua cong,
         * mapId() da la map moi nhung bang cong cua map do co the chua nap xong. Truoc day
         * tat auto ngay tu lan dau khong tim thay - dung loi "khong co duong di" nguoi choi
         * gap khi dang tren duong ve Cong dia nguc.
         */
        int hop = nextHop(here, targetMap);
        if (hop < 0) {
            routeFailing("Không tìm được đường tới map " + targetMap + " từ map " + here + ".");
            return;
        }
        Object gate = findWaypointTo(hop);
        if (gate == null) {
            routeFailing("Map " + here + " không có cổng tới map " + hop
                    + ". Cổng đang thấy: " + waypointLabels());
            return;
        }
        routeMissSince = 0L;
        @class.WAYPOINT@ wp = (@class.WAYPOINT@) gate;
        int gx = wp.@waypoint.x@;
        int gy = wp.@waypoint.y@;
        boolean gateZone = within(gx, gy, GATE_NEAR_PX);

        // Neu truoc do da quay dau ve bo, huy duong quay dau khi da ap sat cong.
        // Vi tri bo tren client co the tre hon server mot nhip, khong de no keo nguoi
        // choi chay nguoc ra giua map ngay truoc khi qua cong.
        if (leadingCow && gateZone && cowRecovering) {
            cowRecovering = false;
            @class.PLAYER@ me = player();
            if (me != null) haltWalk(me);
        }

        if (!arrived(gx, gy)) {
            // Ghi lai cho dang dung: neu ket o cong thi lui ve day roi buoc vao lai.
            @class.PLAYER@ me = player();
            if (me != null) {
                preGateX = me.@player.x@;
                preGateY = me.@player.y@;
            }
            gateSince = 0L;
            gateBackOff = false;
            /*
             * Nham goc chi dung khi dang di XUYEN dia hinh.
             *
             * Diem goc duoc neo vao toa do HIEN TAI cua nhan vat: (gx, my) hoac (mx, gy).
             * Di duong thang thi mot truc dung yen nen goc do dung im. Con di duong that
             * thi duong vong len xuong ca hai truc, nen goc truot theo tung buoc chan -
             * nhan vat duoi mot cai dich khong bao gio dung lai. Ma tat Noclip roi thi
             * cung khong can no nua: duong that da di theo loi that, khong cat ngang cong
             * khac nhu duong thang.
             */
            if (noclipOn) {
                computeAim(wp, gx, gy);
            } else {
                aimIsCorner = false;
            }
            stepToward(aimIsCorner ? aimCornerX : gx, aimIsCorner ? aimCornerY : gy,
                    leadingCow, !gateZone);
            return;
        }

        /*
         * Da dung ngay tren cong. Server chi doi map khi nhan duoc mot bao cao vi tri roi
         * vao trong 40px quanh cong, nen neu dung im khong con goi nao nua thi ket luon.
         * Lui ra roi buoc vao lai de sinh them bao cao - dung nhu nguoi choi se lam.
         */
        if (gateSince == 0L) gateSince = now();
        if (now() - gateSince > GATE_RETRY_MS) {
            gateSince = now();
            gateBackOff = !gateBackOff;
        }
        if (gateBackOff && (preGateX != 0 || preGateY != 0)) {
            stepToward(preGateX, preGateY, leadingCow, false);
        } else {
            stepToward(gx, gy, leadingCow, false);
        }
    }

    /*
     * Di thang toi cong khong phai luc nao cung duoc: co map ma duong thang di NGANG QUA
     * mot cong khac, va server mo cong ngay khi vao trong 40px quanh no - the la bi dat
     * sang map la. Nguoi choi bao dung loi nay o map "Cong vao Ha gioi": phai sang phai
     * mot doan roi moi di len.
     *
     * Nen thay vi ghi cung toa do cho tung map, o day nham toi mot diem trung gian: neu
     * duong thang khong sach thi di MOT TRUC TRUOC (ngang roi doc, khong duoc thi doc roi
     * ngang) - dung ca hai chan deu tranh duoc cong khac. Toi goc roi thi duong con lai
     * chinh la chan da kiem, nen vong sau tu dong nham thang toi cong.
     */
    static int aimCornerX;
    static int aimCornerY;
    static boolean aimIsCorner;

    static void computeAim(@class.WAYPOINT@ gate, int gx, int gy) {
        aimIsCorner = false;
        @class.PLAYER@ me = player();
        if (me == null) return;
        int mx = me.@player.x@;
        int my = me.@player.y@;
        if (segmentClear(mx, my, gx, gy, gate)) return;

        if (segmentClear(mx, my, gx, my, gate) && segmentClear(gx, my, gx, gy, gate)) {
            aimCornerX = gx;
            aimCornerY = my;
        } else if (segmentClear(mx, my, mx, gy, gate) && segmentClear(mx, gy, gx, gy, gate)) {
            aimCornerX = mx;
            aimCornerY = gy;
        } else {
            return;             // khong co loi nao sach - cu di thang, con hon dung im
        }
        // Da dung o goc roi thi thoi, nham thang toi cong (chan con lai da duoc kiem).
        if (Math.abs(mx - aimCornerX) <= ARRIVE_PX && Math.abs(my - aimCornerY) <= ARRIVE_PX) return;
        aimIsCorner = true;
    }

    /** Doan thang nay co di ngang qua mot cong NAO KHAC ngoai cong dich khong. */
    static boolean segmentClear(int x0, int y0, int x1, int y1, @class.WAYPOINT@ gate) {
        @class.VEC@ list = @class.TILEMAP@.@tilemap.waypoints@;
        if (list == null) return true;
        int dx = x1 - x0;
        int dy = y1 - y0;
        int len = Math.abs(dx) > Math.abs(dy) ? Math.abs(dx) : Math.abs(dy);
        int steps = len / 16 + 1;
        for (int i = 0; i < list.@vec.size@(); i++) {
            Object o = list.@vec.get@(i);
            if (o == null) continue;
            @class.WAYPOINT@ wp = (@class.WAYPOINT@) o;
            if (wp == gate) continue;
            if (segmentNearPoint(x0, y0, dx, dy, steps,
                    wp.@waypoint.x@, wp.@waypoint.y@, GATE_AVOID_PX)) {
                return false;
            }
        }
        return true;
    }

    /**
     * Doan thang co di vao trong hinh vuong ban kinh r quanh (wx,wy) khong. Lay mau tung
     * diem doc theo doan; buoc lay mau phai nho hon r de khong nhay qua muc tieu.
     */
    static boolean segmentNearPoint(int x0, int y0, int dx, int dy, int steps,
            int wx, int wy, int r) {
        return PathPlanner.segmentNearPoint(x0, y0, dx, dy, steps, wx, wy, r);
    }

    /**
     * Ghi nhan mot lan khong tra ra duoc duong di. Chi khi that bai LIEN TUC qua
     * ROUTE_MISS_MS (va da qua cua so nap du lieu map) moi that su dung auto.
     */
    static void routeFailing(String reason) {
        if (routeMissSince == 0L) routeMissSince = now();
        if (now() - routeMissSince < ROUTE_MISS_MS || mapSettling()) return;
        routeMissSince = 0L;
        // Bo dinh tuyen dung chung cho ca hai tinh nang - tat dung cai dang chay.
        if (n4State != N4_OFF) {
            n4Stop(reason);
        } else {
            stop(reason);
        }
    }

