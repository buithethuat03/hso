    // ==================================================================
    //                        AUTO NGA TU TU THAN
    // ==================================================================
    //
    // Vong lap bon buoc, viet lai theo dung mau Auto Di Buon sau khi cac ban truoc sinh qua
    // nhieu loi NGAU NHIEN. Nguyen tac:
    //
    //   - Moi buoc mot ham, moi ham mot viec. Khong buoc nao lam viec cua buoc khac.
    //   - Chi hai buoc duoc DI: N4_HOME (duong that, Noclip TAT) va N4_MOVE (Noclip BAT).
    //     Cac buoc con lai khong dung toi di chuyen: khong halt, khong tu gui vi tri.
    //   - Toa do deu CO DINH (cho NPC, bon cho don, thien thach). Khong doc thuc the, khong
    //     nho vi tri, khong suy doan tu vi tri quai.
    //   - Moi lan doi buoc theo map deu di qua DUNG MOT cho: dau n4Tick().
    //   - KHONG BAO GIO CAT DUONG GIUA CHUNG. Da giao duong cho engine thi de no di het;
    //     chi khi engine ranh (path == null) moi xet "toi chua", roi doi mot nhip (nguoi choi
    //     chot: 0.5s o NPC, 0.5s truoc khi ra cho don, 1s sau khi ra lang), roi moi lam tiep.
    //     Loi da xac nhan cua cac ban truoc: vua vao tam la dung gap va tuong tac ngay trong
    //     khi engine con dang di not doan duong - nhan vat bi le di mot doan roi giat nguoc
    //     lai. Do la hai buoc chong len nhau. Khong halt, khong tu gui vi tri: engine tu bao.

    /** Bat/tat va cac muc con cua Auto Nga 4. */
    static void showN4Submenu() {
        @class.VEC@ items = new @class.VEC@((byte) 0);
        String label = n4State == N4_OFF ? "Trạng thái: [OFF]" : "Trạng thái: [ON]";
        items.@vec.add@(new @class.CMD@(label, ACT_N4_TOGGLE, @class.ENGINE@.@engine.field.INSTANCE@));
        @class.CANVAS@.@canvas.menu@.@menubox.show@(items, 2, "AUTO NGÃ 4", false, (@class.VEC@) null);
    }

    static void n4SetState(int next) {
        n4State = next;
        n4StateSince = now();
        n4IdleSince = 0L;
        lastStep = 0L;
        pathFails = 0;
        n4MovePrepared = next != N4_MOVE;
    }

    /**
     * B1 bat dau tu day. Bat o dau cung duoc: buoc N4_HOME tu ve Lang Soi Trang bang bo dinh
     * tuyen cua Auto Di Buon, roi toi dung cho Pho chi huy.
     */
    static void n4Start() {
        if (player() == null || mapHolderMissing()) {
            notice("Chưa vào game.");
            return;
        }
        if (state != OFF) stop("Bật Auto Ngã 4 nên tắt Auto Đi Buôn.");
        n4SavedPlayers = HSOSKYPetFeedSupport.isAutoPlayersEnabled();
        n4SavedAttack = @class.ENGINE@.@engine.field.autoAttack@ || attackRecoveryDesired;
        n4SavedPersistentAttack = HSOSKYPetFeedSupport.persistentAutoAttack
                || attackRecoveryDesired;
        n4AttackPaused = false;
        n4AttackStateSaved = true;
        n4PauseAttackForMovement();
        n4SavedNoclip = noclipOn;
        n4AutoOn = false;
        n4InDungeon = false;
        n4Runs = 0;
        n4TalkFails = 0;
        n4MenuSeen = false;
        n4AimX = 0;
        n4AimY = 0;
        n4AimName = null;
        n4AimDirty = false;
        n4LastMap = mapId();
        clearPlan();
        // Khong cat duong dang di: nguoi choi dang di thi engine cu di het, B1 xet sau.
        notice("Auto Ngã 4: BẬT.");
        if (n4LastMap == N4_DUNGEON_MAP) {
            n4OnEnterDungeon();          // vao pho ban thi cho huong, chua bat auto danh
        } else {
            n4SetState(N4_HOME);
        }
    }

    static void n4Stop(String why) {
        n4RestoreAttack();
        n4State = N4_OFF;
        n4InDungeon = false;
        @class.PLAYER@ me = player();
        if (me != null) haltWalk(me);
        clearPlan();
        // Tra Noclip ve dung cai nguoi choi chon trong menu Auto Di Buon.
        noclipOn = n4SavedNoclip;
        HSOSKYRuntimeSupport.setNoClipEnabled(noclipOn);
        notice(why == null ? "Auto Ngã 4: TẮT." : why);
    }

    /**
     * Bat Auto Tu Danh o che do 7 "Chỉ Quái".
     *
     * Che do 7 la autoPlayersEnabled = false. Thien thach thi khong can lo: bo loc muc tieu
     * cua mod (HSOSKYPetFeedSupport.isAutoTargetType) chi nhan loai 1 (quai) va loai 0
     * (nguoi, va chi khi dang o che do 6), con thien thach la thuc the loai 2 - khong che do
     * nao nham vao no ca. Tam chon muc tieu bi autoTargetGate() gioi han trong vong tron.
     *
     * persistentAutoAttack de onCanvasUpdate tu bat lai moi khi engine tu tat.
     */
    static void n4StartAttack() {
        HSOSKYPetFeedSupport.setAutoPlayersEnabled(false);
        HSOSKYPetFeedSupport.setModAutoAttack(true);
        n4AutoOn = true;
    }

    /** Tra Auto Tu Danh ve dung nguyen trang truoc khi auto dong vao. */
    static void n4RestoreAttack() {
        if (!n4AutoOn && !n4AttackStateSaved) return;
        n4AutoOn = false;
        if (n4AttackStateSaved) {
            @class.ENGINE@.@engine.field.autoAttack@ = n4SavedAttack;
            HSOSKYPetFeedSupport.setModAutoAttack(n4SavedAttack);
            HSOSKYPetFeedSupport.persistentAutoAttack = n4SavedPersistentAttack;
            if (n4SavedAttack && n4SavedPersistentAttack) {
                try {
                    if (!HSOSKYPetFeedSupport.isPlayerAuto()) {
                        HSOSKYPetFeedSupport.reengageAutoAttack();
                    }
                } catch (Throwable t) {
                    // Native state will be checked by the next canvas update.
                }
            }
            HSOSKYPetFeedSupport.saveRMS();
            attackRecoveryState = n4SavedAttack && n4SavedPersistentAttack
                    ? ATTACK_RECOVERY_ARMED : ATTACK_RECOVERY_IDLE;
            attackRecoveryDesired = n4SavedAttack && n4SavedPersistentAttack;
            attackRecoverySuppressed = false;
            attackRecoveryLastPersistent = n4SavedPersistentAttack;
            n4AttackPaused = false;
            n4AttackStateSaved = false;
        }
        HSOSKYPetFeedSupport.setAutoPlayersEnabled(n4SavedPlayers);
    }

    /** Tam dung native combat trong khi N4 dang giu quyen ghi player.path de dan duong. */
    static void n4PauseAttackForMovement() {
        boolean wasPaused = n4AttackPaused;
        @class.ENGINE@.@engine.field.autoAttack@ = false;
        if (!wasPaused) HSOSKYPetFeedSupport.onAutoAttackToggled(false);
        HSOSKYPetFeedSupport.setModAutoAttack(false);
        HSOSKYPetFeedSupport.setAutoPlayersEnabled(false);
        HSOSKYPetFeedSupport.persistentAutoAttack = false;
        n4AttackPaused = true;
        if (n4AttackPaused) {
            if (!wasPaused) {
                @class.PLAYER@ me = player();
                if (me != null) haltWalk(me);
            }
        }
    }

    /** Chi bat native combat sau khi da den dung vi tri cua cua. */
    static void n4ResumeAttackAfterMovement() {
        if (!n4AttackPaused) return;
        n4AttackPaused = false;
        @class.ENGINE@.@engine.field.autoAttack@ = true;
        HSOSKYPetFeedSupport.setModAutoAttack(true);
        HSOSKYPetFeedSupport.persistentAutoAttack = true;
        try {
            if (!HSOSKYPetFeedSupport.isPlayerAuto()) {
                HSOSKYPetFeedSupport.reengageAutoAttack();
            }
        } catch (Throwable t) {
            // Native onCanvasUpdate remains the final fallback.
        }
    }

    static void n4Tick() {
        try {
            // Ngoai dung danh, tat ca giai doan N4 phai khoa ca hai co che auto danh.
            if (n4State != N4_HOLD) n4PauseAttackForMovement();
            /*
             * Mat ket noi thi khong dung toi gi ca - y het Auto Di Buon: client co vong tu
             * dang nhap lai, de yen cho no chay roi di tiep.
             */
            if (offline()) return;
            if (playerDead()) {
                if (reviveAutoOn()) return;
                n4Stop("Nhân vật đã chết.");
                return;
            }

            /*
             * DOI MAP - cho DUY NHAT doi buoc theo map.
             *
             *   dang trong pho ban, map doi        -> B4 (server da ra lang)
             *   dang B2 va map doi                 -> B3 (vao pho ban)
             *   dang B1 va map doi                 -> khong lam gi, B1 dang tu qua map ve lang
             */
            int here = mapId();
            if (here >= 0 && here != n4LastMap) {
                n4LastMap = here;
                mapChangedAt = now();          // cho cac ham dung chung (mapSettling) biet
                clearPlan();
                @class.PLAYER@ meNow = player();
                if (meNow != null) haltWalk(meNow);
                if (n4InDungeon) {
                    n4OnLeaveDungeon();
                } else if (n4State == N4_TALK) {
                    n4OnEnterDungeon();
                }
                return;
            }

            // Dong thong bao chi co nghia trong pho ban; ngoai lang khong doc, khoi doc nham.
            if (n4InDungeon) pollInfo();

            /*
             * Moi hop thoai deu bam dong dau tien:
             *   - hop chao cua NPC   -> dong dau la "Giao tiếp" (dong sau la "Đóng")
             *   - hop hoi vao pho ban -> dong dau la dong dong y
             * Rieng hop cua he thong (mat ket noi) thi khong dung toi, y het Auto Di Buon.
             */
            if (dialogOpen()) {
                if (isLinkDialog(dialogText())) return;
                pressOk();
                return;
            }

            // Bam dong menu cham mot nhip, khong thi server tra "Thao tac qua nhanh".
            if (pendRow >= 0) {
                if (now() - pendAt < MENU_DELAY_MS) return;
                short npc = pendNpc;
                byte menu = pendMenu;
                byte row = (byte) pendRow;
                pendRow = -1;
                sender().@sender.npcMenuSelect@(npc, menu, row);
                return;
            }

            switch (n4State) {
                case N4_HOME:  n4StepHome();  break;
                case N4_TALK:  n4StepTalk();  break;
                case N4_WAIT:  n4StepWait();  break;
                case N4_MOVE:  n4StepMove();  break;
                case N4_HOLD:  n4StepHold();  break;
                case N4_LEAVE: n4StepLeave(); break;
                default: break;
            }
        } catch (Throwable t) {
            System.out.println("HSOAUTO: n4 tick error " + t.toString());
            n4Stop("Lỗi bất ngờ, đã dừng.");
        }
    }

    // ------------------------------------------------------------ vao / ra pho ban

    static void n4OnEnterDungeon() {
        /*
         * Quen sach hop thong bao NGAY khung hinh nay, truoc khi doc dong nao. Cac dong con
         * sot lai tu lang (va tu luot truoc) khong duoc coi la moi. Khong duoc doi roi moi
         * quen: thong bao huong quai dau tien co the toi trong vai giay dau.
         */
        flushInfo();
        n4InDungeon = true;
        n4EnterAt = now();
        n4Runs++;
        n4TalkFails = 0;
        n4AimX = 0;
        n4AimY = 0;
        n4AimName = null;
        n4AimDirty = false;
        n4WantNoclip(true);          // trong pho ban di xuyen: khong vuong thien thach, quai
        n4SetState(N4_WAIT);
        notice("Vào phó bản lượt " + n4Runs + ", chưa bật auto đánh, đứng yên chờ hướng quái.");
    }

    static void n4OnLeaveDungeon() {
        n4InDungeon = false;
        n4LeaveAt = now();
        n4MenuSeen = false;
        n4PauseAttackForMovement();
        n4WantNoclip(n4SavedNoclip); // ngoai lang: tra ve dung cai nguoi choi chon
        n4SetState(N4_LEAVE);
        notice("Xong phó bản lượt " + n4Runs + ", đợi nạp xong rồi về chỗ Phó chỉ huy.");
    }

    // ------------------------------------------------------------ B1

    /**
     * B1: ve Lang Soi Trang, toi dung (N4_HOME_X, N4_HOME_Y), doi engine dung, doi 0.5s, bat chuyen.
     *
     * Loi da xac nhan: "chay den gan Pho chi huy, chua bam gi da chay lai ve cho cu". Nguyen
     * nhan la vua vao tam la dung gap va hoi NPC ngay trong khi engine con dang di not doan
     * duong da giao - nhan vat bi le di mot doan roi giat nguoc lai. Server khong check va cham,
     * Noclip khong lien quan.
     *
     * Nen o day KHONG halt, KHONG tu gui vi tri. Giao duong -> de engine di het (path == null)
     * -> luc do moi xet toi chua -> toi roi thi doi them N4_HOME_WAIT_MS -> moi hoi NPC. Chua
     * toi thi giao duong tiep. Toa do (588,564) la tam mot o nen duong that ket thuc dung do.
     */
    static void n4StepHome() {
        n4PauseAttackForMovement();
        n4WantNoclip(n4SavedNoclip);               // ngoai lang: dung cai nguoi choi chon
        if (now() - n4StateSince > N4_HOME_TIMEOUT_MS) {
            n4Stop(join(join("Đi mãi không về được chỗ Phó chỉ huy (map " + mapId() + ", đang ở ",
                    n4Pos()), ")."));
            return;
        }
        if (mapId() != N4_TOWN_MAP) {
            n4IdleSince = 0L;
            routeTowards(N4_TOWN_MAP, false);      // bo dinh tuyen cua Auto Di Buon
            return;
        }
        if (!n4EngineIdle()) {
            n4IdleSince = 0L;                      // dang di het duong da giao - khong xet gi
            return;
        }
        if (!arrived(N4_HOME_X, N4_HOME_Y)) {
            n4IdleSince = 0L;
            stepToward(N4_HOME_X, N4_HOME_Y, false);
            return;
        }
        if (!n4Settled(N4_HOME_WAIT_MS)) return;   // toi roi, dung yen them 0.5s
        notice(join(join("Đã tới chỗ Phó chỉ huy (", n4Pos()), "), bắt chuyện."));
        sender().@sender.requestNpcMenu@((byte) npcIdOf(NPC_CHIHUY, NPC_CHIHUY_ID));
        n4SetState(N4_TALK);
    }

    // ------------------------------------------------------------ B2

    /**
     * B2: menu va hop thoai do n4OnNpcMenu()/n4Tick() bam; o day chi dung yen va canh gio.
     *
     * Het gio ma van chua doi map thi quay ve B1: B1 tu kiem tra - con dung dung cho thi doi
     * 0.5s roi hoi lai, bi doi cho roi thi di lai. Lap MAX_N4_TALK_FAILS lan van khong vao
     * duoc thi dung han va noi ro ly do.
     */
    static void n4StepTalk() {
        if (now() - n4StateSince < N4_TALK_TIMEOUT_MS) return;
        if (++n4TalkFails >= MAX_N4_TALK_FAILS) {
            if (!n4MenuSeen) {
                n4Stop(join(join("Không mở được menu Phó chỉ huy (đang ở ", n4Pos()),
                        ") - kiểm tra lại toạ độ chỗ đứng."));
            } else {
                n4Stop("Không vào được phó bản - nhiều khả năng đã hết đồng tiền Horae và hết ngọc.");
            }
            return;
        }
        notice("Chưa vào được phó bản, thử lại.");
        n4SetState(N4_HOME);
    }

    // ------------------------------------------------------------ B3

    /** Trong pho ban qua lau thi dung. Dung chung cho ca ba trang thai trong pho ban. */
    static boolean n4FightTooLong() {
        if (now() - n4EnterAt <= N4_FIGHT_TIMEOUT_MS) return false;
        n4Stop("Ở trong phó bản quá lâu, đã dừng.");
        return true;
    }

    /**
     * B3a: DUNG YEN cho toi khi doc duoc huong quai (n4ReadGate() chot cho don).
     *
     * Khong di dau truoc khi biet huong. Ban truoc di ra giua ban do roi nghe thong bao lai
     * quay dau - hai chuyen di cho mot cho dung, co luc mat 20 giay, quai ra mat roi.
     */
    static void n4StepWait() {
        if (n4FightTooLong()) return;
        n4PauseAttackForMovement();
        if (n4AimDirty) {
            n4AimDirty = false;
            n4SetState(N4_MOVE);
            return;
        }
        if (now() - n4StateSince > N4_WAIT_GATE_MS) {
            n4Aim(N4_ROCK_X, N4_ROCK_Y, "thiên thạch");
            n4AimDirty = false;
            notice("Không nghe được hướng quái ra, ra chỗ thiên thạch.");
            n4SetState(N4_MOVE);
        }
    }

    /**
     * B3b: doi N4_AIM_WAIT_MS ke tu luc chot cho don, roi ra do (Noclip bat, duong thang).
     *
     * Cung mot luat voi B1: engine dang di thi khong xet gi; engine ranh roi moi xem toi chua.
     * Toi thi sang N4_HOLD - khong halt, vi engine da tu dung. Khong toi duoc trong
     * N4_MOVE_TIMEOUT_MS thi dung danh tai cho - con hon chay mai.
     */
    static void n4StepMove() {
        if (n4FightTooLong()) return;
        n4PauseAttackForMovement();
        n4WantNoclip(true);
        /*
         * Auto Tu Danh co the de lai path cu tu luc dang dung danh. Xoa no dung mot lan
         * khi vao N4_MOVE, sau do de engine tu ghi path N4 va di het den cua da chot.
         * Khong xoa moi tick: lam vay se lam nhan vat di khung tung doan.
         */
        if (!n4MovePrepared) {
            @class.PLAYER@ me = player();
            if (me != null) haltWalk(me);
            n4MovePrepared = true;
        }
        if (!n4EngineIdle()) {
            n4IdleSince = 0L;                      // dang di het duong da giao
            return;
        }
        if (now() - n4AimAt < N4_AIM_WAIT_MS) return;   // doi mot nhip sau khi chot cho don
        if (arrived(n4AimX, n4AimY)) {
            notice(join(join(join("Đã vào chỗ đón ", n4AimName), join(" (", n4Pos())), "), đứng đánh."));
            n4StartAttack();
            n4ResumeAttackAfterMovement();
            n4SetState(N4_HOLD);
            return;
        }
        if (now() - n4StateSince > N4_MOVE_TIMEOUT_MS) {
            n4Stop("Không ra được chỗ đón, đã dừng Auto Ngã 4.");
            return;
        }
        n4IdleSince = 0L;
        stepToward(n4AimX, n4AimY, false);
    }

    /**
     * B3c: dung han, de Auto Tu Danh lam viec. Co huong moi (dot sau) thi quay lai B3b.
     *
     * Khong duoi theo quai, khong lui ve giua map, khong suy doan gi: chi dung va danh.
     */
    static void n4StepHold() {
        if (n4FightTooLong()) return;
        if (!n4AutoOn) n4StartAttack();
        n4ResumeAttackAfterMovement();
        n4WantNoclip(true);
        if (n4AimDirty) {
            n4AimDirty = false;
            n4PauseAttackForMovement();
            n4SetState(N4_MOVE);
            return;
        }
        /*
         * Den day thi engine native toan quyen: tu ve vong tam danh, chon quai va ap sat.
         * N4 khong duoc tu ghi path nua, neu khong hai ben se giat qua lai tren player.path.
         */
    }

    // ------------------------------------------------------------ B4

    /**
     * B4: vua bi da ra lang. Doi N4_LEAVE_WAIT_MS va ban do nap xong roi moi ve B1.
     *
     * Ma so map doi ngay tu goi tin dau tien, con ban do va vi tri moi cua nhan vat thi toi
     * sau. Lam gi o khung hinh do la doc phai toa do cu - ban truoc vi the ma ket luan "da ve
     * toi cho NPC" trong khi nhan vat con dung tan cho ra. Khong gui gi len server o day.
     */
    static void n4StepLeave() {
        if (now() - n4LeaveAt < N4_LEAVE_WAIT_MS) return;
        if (!n4MapReady()) return;
        notice(join(join("Đã nạp xong, đang ở ", n4Pos()), ", về chỗ Phó chỉ huy."));
        n4SetState(N4_HOME);
    }

    /**
     * Ban do moi da nap xong chua: qua N4_SETTLE_MS, co nhan vat, co bang o. Cho qua
     * N4_SETTLE_MAX_MS ma van thieu thi cu lam.
     */
    static boolean n4MapReady() {
        if (now() - n4LeaveAt > N4_SETTLE_MAX_MS) return true;
        if (now() - n4LeaveAt < N4_SETTLE_MS) return false;
        if (player() == null) return false;
        return tileGrid() != null && gridWidth() > 0;
    }

    // ------------------------------------------------------------ engine ranh

    /**
     * Engine da di het duong duoc giao chua (player.path == null la tin hieu engine tu dat).
     *
     * Chua het thi KHONG xet gi ca. Day la chot chan loi "vua vao tam la dung gap va tuong tac
     * ngay": moi lan cat duong giua chung la mot lan nhan vat bi le di roi giat nguoc lai.
     */
    static boolean n4EngineIdle() {
        @class.PLAYER@ me = player();
        return me != null && me.@player.path@ == null;
    }

    /**
     * Da dung yen (engine ranh, khong giao duong moi) lien tuc du `ms` chua.
     *
     * Khong halt, khong gui vi tri - engine da tu bao vi tri cuoi khi di het duong. Moi cho
     * giao duong moi phai dat n4IdleSince = 0.
     */
    static boolean n4Settled(long ms) {
        if (n4IdleSince == 0L) n4IdleSince = now();
        return now() - n4IdleSince >= ms;
    }

    /**
     * Ep Noclip ve dung trang thai buoc nay can - CA co ben nay lan tang runtime.
     *
     * Runtime tu tat Noclip sau ba lan bi server keo vi tri ve ma khong bao ai; co ben nay
     * lech voi no la duong giao cho engine khong khop va cham, nhan vat dam tuong roi tinh
     * duong moi, nhin y het chay vong vong. setNoClipEnabled() xoa luon bo dem keo vi tri.
     * Chi bo ke hoach duong da tinh san; duong dang di thi de engine di not, khong cat.
     */
    static void n4WantNoclip(boolean want) {
        boolean real = HSOSKYRuntimeSupport.isNoClipEnabled();
        if (real == want && noclipOn == want) return;
        noclipOn = want;
        HSOSKYRuntimeSupport.setNoClipEnabled(want);
        clearPlan();
    }

    // ------------------------------------------------------------ doc huong quai

    /** Chot cho don. n4AimAt la moc cho N4_AIM_WAIT_MS; n4AimDirty bao cho N4_WAIT/N4_HOLD. */
    static void n4Aim(int x, int y, String name) {
        n4AimX = x;
        n4AimY = y;
        n4AimName = name;
        n4AimAt = now();
        n4AimDirty = true;
    }

    /**
     * Doc dong "Bầy quái vật sẽ xuất hiện ở cửa phía Tây sau 15 giây nữa..." -> cho don co dinh.
     *
     * Goi tu takeInfo() moi khi hop thong bao co dong moi, chi khi dang trong pho ban. Dong
     * phai co chu "cửa" - de mot dong chat bat ky co chu "nam" khong keo nhan vat di. Cau bao
     * cua chinh auto khong dung chu "cửa" de khong tu kich hoat lai minh.
     */
    static void n4ReadGate(String lower) {
        if (lower == null || lower.indexOf(LBL_N4_GATE) < 0) return;
        int[] pos;
        String where;
        if (lower.indexOf("tây") >= 0) {
            pos = N4_POS_TAY;  where = "Tây";
        } else if (lower.indexOf("đông") >= 0) {
            pos = N4_POS_DONG; where = "Đông";
        } else if (lower.indexOf("bắc") >= 0) {
            pos = N4_POS_BAC;  where = "Bắc";
        } else if (lower.indexOf("nam") >= 0) {
            pos = N4_POS_NAM;  where = "Nam";
        } else {
            return;
        }
        if (pos[0] == n4AimX && pos[1] == n4AimY) return;            // cung huong, khong doi
        if (n4AimAt != 0L && now() - n4AimAt < N4_GATE_HOLD_MS) return;   // ban sao bi day xuong
        n4Aim(pos[0], pos[1], where);
        notice(join("Đợt quái tới từ hướng ", join(where, ", ra chỗ đón.")));
    }

    // ------------------------------------------------------------ menu NPC

    /**
     * Chon dong menu cua Pho chi huy - CHI o buoc B2.
     *
     * Thu tu uu tien dung nhu nguoi choi mo ta:
     *   1. "Vào Ngã Tư Tử Thần" - dong o menu chinh.
     *   2. "Đồng tiền horae"    - ve, dung truoc.
     *   3. "5 ngọc"             - het ve moi mua luot bang ngoc.
     * Menu tra phi chi hien ra khi hom nay da di roi; hom chua di thi sau buoc 1 la mot hop
     * xac nhan, va hop do do n4Tick() bam. Ngoai buoc B2 khong bam menu nao ca: "ngọc" la
     * chuoi chung chung, NPC nao cung co the co.
     */
    static boolean n4OnNpcMenu(short npcId, byte menuId, @class.VEC@ items) {
        if (n4State != N4_TALK) return false;
        int pick = indexOfLabel(items, LBL_N4_ENTER);
        if (pick < 0) pick = indexOfLabel(items, LBL_N4_HORAE);
        if (pick < 0) pick = indexOfLabel(items, LBL_N4_GEM);
        if (pick < 0) return false;
        n4MenuSeen = true;
        pendNpc = npcId;
        pendMenu = menuId;
        pendRow = pick;
        pendAt = now();
        return true;
    }

    // ------------------------------------------------------------ tam chon muc tieu

    /**
     * Bo loc DUONG DI ma Auto Tu Danh giao cho nhan vat - patcher chen vao truoc luc gan.
     *
     * DAY LA CHO HAI BEN GIANH NHAU.
     *
     * Auto Tu Danh khong chi chon muc tieu: khi muc tieu o xa no con TU TINH DUONG va ghi
     * thang vao player.path de chay toi. Auto Nga 4 cung ghi player.path de ra cho don. Hai
     * ben ghi de len nhau moi nhip, nen nhan vat khong bao gio di het duong nao ca - nhin ra
     * ngoai dung la "chay vong vong, khong chiu dung im, khong danh".
     *
     * Quet ca client thi chi co DUNG MOT cho gan duong di that vao player.path (ket qua cua
     * findPath, nam trong chinh vong auto danh); moi cho khac deu chi gan null de xoa duong.
     * Nen chan dung cho do la du, va khong dung toi gi khac.
     *
     * Khi auto cua minh dang chay: tra ve null = khong giao duong nao. Auto Tu Danh van chon
     * muc tieu va van danh binh thuong, chi mat quyen di chuyen. null la trang thai engine
     * xu ly duoc - chinh no cung gan null o bon cho khac trong cung ham do.
     */
    public static short[] autoAttackPath(short[] path) {
        /*
         * AUTO DI BUON: chan han. No dat mot con bo chi bam theo khi minh di dung nhip, nen
         * khong the de ai khac giat tay lai.
         */
        if (state != OFF) return null;
        /*
         * Trong WAIT/MOVE, N4 giu quyen di toi cua da. Khi HOLD, tra lai quyen cho engine
         * native de no dung dung vong tam danh, chon quai va di toi quai nhu ban Luna.
         */
        if (n4State != N4_OFF && n4State != N4_HOLD) return null;
        return path;
    }

    /**
     * Bo loc muc tieu cua Auto Tu Danh - patcher noi thay cho cho goi isValidAutoTarget.
     *
     * Ban mod chon muc tieu tren CA BAN DO. Trong pho ban thi khong duoc: quai vao tung dot
     * tu ria ban do, no khoa vao con o tan dang xa va danh hut, con o ngay canh thi khong dung.
     * Nguoi choi yeu cau: trong pho ban chi danh trong VONG TRON mod ve tren man hinh. Ngoai
     * pho ban giu nguyen hanh vi cu.
     */
    public static boolean autoTargetGate(Object target, Object me) {
        try {
            if (!HSOSKYPetFeedSupport.isValidAutoTarget(target, me)) return false;
            return !n4InDungeon || n4InRange(target, me);
        } catch (Throwable t) {
            return false;
        }
    }

    /**
     * Muc tieu co nam trong vong tron tam danh khong - ban kinh bang 105% tam goc:
     * tamDanh * 21 / 20, tinh bang pixel.
     * Doc khong duoc thi cho qua - tha nhan thua con hon dung im.
     */
    static boolean n4InRange(Object target, Object me) {
        try {
            @class.ENTITY@ t = (@class.ENTITY@) target;
            @class.PLAYER@ p = (@class.PLAYER@) me;
            int r = p.@player.atkRange@ * 21 / 20;
            if (r <= 0) return true;
            long dx = (long) t.@entity.x@ - p.@player.x@;
            long dy = (long) t.@entity.y@ - p.@player.y@;
            return dx * dx + dy * dy <= (long) r * r;
        } catch (Throwable th) {
            return true;
        }
    }

    // ------------------------------------------------------------ HUD

    /** Muc tieu Auto Tu Danh dang khoa, hoac null. */
    static @class.ENTITY@ n4Target() {
        try {
            return @class.CHARS@.@chars.target@;
        } catch (Throwable t) {
            return null;
        }
    }

    /**
     * Tu bam toi muc tieu Auto Tu Danh dang khoa. Tra ve true = da lo xong viec di nhip nay.
     *
     * Bam sat toi N4_LOOT_PX chu khong dung o tam danh: vat pham roi ngay cho con quai chet,
     * dung tu xa danh voi thi do roi cach ca tram pixel va khong nhat duoc - dung loi nguoi
     * choi bao sau khi het chay vong vong.
     *
     * Van giu luat khong cat duong: engine chua di het duong da giao thi khong giao duong moi.
     */
    static boolean n4ChaseTarget() {
        @class.ENTITY@ t = n4Target();
        if (t == null) return false;
        n4TargetAt = now();
        if (within(t.@entity.x@, t.@entity.y@, N4_LOOT_PX)) return true;   // da ap sat
        if (!n4EngineIdle()) return true;                                  // dang di, de yen
        n4IdleSince = 0L;
        stepToward(t.@entity.x@, t.@entity.y@, false);
        return true;
    }

    /**
     * Auto Tu Danh dang dan nhan vat hay khong.
     *
     * Co muc tieu = no dang lo viec di toi va danh con do. Luc nay Auto Nga 4 phai IM: hai
     * ben cung phat lenh di la ghi de len player.path cua nhau, nhan vat khong di het duong
     * nao - dung loi "chay vong vong" da mat ca chuc ban moi tim ra.
     *
     * Muc tieu bi siet trong vong tron tam danh (autoTargetGate), nen no chi keo nhan vat di
     * loanh quanh ban kinh do roi dung lai canh xac quai - vua dep de nhat do roi.
     */
    static boolean n4Busy() {
        try {
            return @class.CHARS@.@chars.target@ != null;
        } catch (Throwable t) {
            return false;
        }
    }

    /** Vi tri hien tai, dang "x,y" - de bao ra cho de doi chieu. */
    static String n4Pos() {
        @class.PLAYER@ me = player();
        if (me == null) return "?";
        return join(join(String.valueOf(me.@player.x@), ","), String.valueOf(me.@player.y@));
    }

    static String n4IdleReason() {
        if (dialogOpen()) return " [chờ đóng hộp thoại]";
        if (pendRow >= 0) return " [chờ bấm menu]";
        if (n4InDungeon) {
            String at = n4AimName == null ? "chờ hướng" : n4AimName;
            return join(join(" [lượt ", String.valueOf(n4Runs)), join(" - ", join(at, "]")));
        }
        return "";
    }
}
