    static String waypointLabels() {
        @class.VEC@ list = @class.TILEMAP@.@tilemap.waypoints@;
        if (list == null) return "(không đọc được)";
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < list.@vec.size@() && i < 8; i++) {
            Object o = list.@vec.get@(i);
            if (o == null) continue;
            @class.WAYPOINT@ wp = (@class.WAYPOINT@) o;
            if (sb.length() > 0) sb.append(" | ");
            sb.append(wp.@waypoint.destName@);
        }
        return sb.length() == 0 ? "(không có cổng nào)" : sb.toString();
    }

    static Object findWaypointTo(int destMapId) {
        @class.VEC@ list = @class.TILEMAP@.@tilemap.waypoints@;
