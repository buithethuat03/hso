    static boolean within(int tx, int ty, int slack) {
        @class.PLAYER@ me = player();
        if (me == null) return false;
        return Math.abs(me.@player.x@ - tx) <= slack && Math.abs(me.@player.y@ - ty) <= slack;
    }

    /*
     * Con bo di buon KHONG phai player ma la MOB. Server tao no bang goi 4
     * [byte kind=1][short template=131] (UseItem.java:102, MapService.java:247), client
     * dung lop MOB roi nhet vao chung danh sach CHARS.entities. Ten nhan vat ve sau moi
     * toi, trong goi 7 (Service.mob_in4:545 tra ve temp2.name) ma client tu xin ngay khi
     * tao mob.
     *
     * CANH BAY: MOB co field ten (String) va field template (int) trung TEN obfuscate voi
     * hai field khac cua ENTITY (mot byte va mot int). Bat buoc doc qua bien kieu MOB;
     * ep ve ENTITY la lay dung field sai kieu.
     */
    static @class.MOB@ cow() {
        cowByName = false;
        @class.PLAYER@ me = player();
        @class.VEC@ list = @class.CHARS@.@chars.entities@;
        if (me == null || list == null) return null;
        String mine = me.@entity.name@;
        @class.MOB@ named = null;
        @class.MOB@ near = null;
        boolean keptAlive = false;
        String refOwner = null;
        int nearGap = Integer.MAX_VALUE;
        for (int i = 0; i < list.@vec.size@(); i++) {
            Object o = list.@vec.get@(i);
            if (!(o instanceof @class.MOB@)) continue;   // loai player va NPC
            @class.MOB@ m = (@class.MOB@) o;
            String owner = m.@mob.name@;
            if (cowRef != null && m == cowRef) {
                keptAlive = true;
                refOwner = owner;     // de biet con dang vo da bi ten chu phu nhan chua
            }
            if (mine != null && owner != null && mine.equals(owner)) {
                named = m;
                continue;
            }
            if (owner != null && owner.length() > 0) continue;   // bo cua nguoi khac
            if (!isCowKind(m)) continue;
            /*
             * Chua kip nhan ten chu. O Cong dia nguc luc nao cung co nguoi khac dat bo, va
             * bo cua ho cung co luc chua kip mang ten - vo lay la mot lat sau no nhan ten
             * chu nguoi ta va minh bao "mat bo". Con bo cua MINH duoc server dat dung vao
             * cho minh dung (UseItem.java: new Pet_di_buon(..., conn.p.x, conn.p.y, ...))
             * va moi giay lai bi keo ve cho minh, nen chi nhan con o trong tam tay.
             */
            if (isAlienCow(m)) continue;   // da co mat truoc luc minh goi -> cua nguoi khac
            int gap = gapTo(me, m);
            if (gap > petLostPx() || gap >= nearGap) continue;
            near = m;
            nearGap = gap;
        }
        /*
         * TEN CHU LA QUYEN CAO NHAT, tren ca cai chot doi tuong ben duoi.
         *
         * Server gui kem ten nguoi chu trong goi 7 (mob_in4) cua chinh con bo do
         * (Service.java:546 writeUTF(temp2.name)), nen ten khop la bang chung khong the
         * choi cai: khong gioi han khoang cach, khong thua truoc bat cu phong doan nao.
         *
         * Truoc day cai chot duoc xet TRUOC, nen mot lan vo nham la dinh luon cho toi khi
         * con do roi khoi danh sach - ke ca khi bo that cua minh dang dung ngay canh voi
         * ten dung ten minh. Day chinh la loi nguoi choi da kiem chung: hai nguoi cung dat
         * bo qua cong mot luc, minh vo nham con cua nguoi ta, ho dat di la minh dung im.
         */
        if (named != null) {
            cowByName = true;
            if (cowRef != named) fetchRuns = 0;
            cowRef = named;
            return named;
        }
        /*
         * Chot doi tuong chi con y nghia chung nao ten chu CHUA phu nhan no.
         *
         * Chua co ten la chuyen binh thuong ngay sau moi lan doi map: client dung lai toan
         * bo danh sach thuc the roi phai hoi lai goi 7 cho tung mob, ten ve sau do chung
         * mot giay. Trong cua so ay van bam theo con dang vo, khong thi nhip nao cung ket
         * luan mat bo. Nhung vua co ten ma ten do khong phai cua minh thi buong NGAY, va
         * danh dau lai de vong sau khong vo lai chinh no.
         */
        if (keptAlive) {
            if (refOwner == null || refOwner.length() == 0) return cowRef;
            dropCow("Con bò đang theo là của người khác, bỏ - tìm lại bò của mình.");
        }
        if (cowRef != near) fetchRuns = 0;
        cowRef = near;
        return near;
    }

    /**
     * Buong con bo dang vo vi da chac chan no khong phai cua minh.
     *
     * Danh dau lai de vong sau khong vo lai dung con do. Sau day cow() tra ve null, va
     * stepHaul di duong mat bo binh thuong (cho COW_GONE_MS roi quay lai map truoc don) -
     * khong can duong xu ly rieng.
     */
    static void dropCow(String why) {
        markAlien(cowRef);
        cowRef = null;
        cowByName = false;
        cowRecovering = false;
        fetchRuns = 0;
        notice(why);
    }

    /**
     * Chup lai nhung con bo CHUA co ten chu dang co mat NGAY TRUOC luc minh bam goi bo.
     *
     * Cong dia nguc luc nao cung dong thuong nhan, va goi tao bo cua server (UseItem.java)
     * khong kem ten chu - ten chi ve o nhip keo pet mot giay sau do. Nen mot con bo vua duoc
     * nguoi ben canh goi ra trong khong khac gi bo cua minh. Truoc day stepSpawnPet thay "co
     * bo" la di thang sang cho Dylan KE CA KHI CHUA HE BAM GOI LAN NAO, roi Dylan tra ve
     * "Ta khong thay con vat di buon cua nguoi" va auto ket lai o do - dung loi nguoi choi bao.
     *
     * Con bo cua minh bao gio cung la doi tuong MOI, duoc tao sau luc chup, nen chi can loai
     * het nhung con da co san la khong the vo nham nua.
     */
    static void markAlienCows() {
        alienCount = 0;
        try {
            @class.PLAYER@ me = player();
            @class.VEC@ list = @class.CHARS@.@chars.entities@;
            if (me == null || list == null) return;
            for (int i = 0; i < list.@vec.size@(); i++) {
                Object o = list.@vec.get@(i);
                if (!(o instanceof @class.MOB@)) continue;
                @class.MOB@ m = (@class.MOB@) o;
                String owner = m.@mob.name@;
                if (owner != null && owner.length() > 0) continue;  // co ten roi thi cow() tu loc
                if (!isCowKind(m)) continue;
                markAlien(m);
            }
        } catch (Throwable t) {
            // khong chup duoc thi thoi, con luoi an toan la hop tra loi cua Dylan
        }
    }

    static void markAlien(Object m) {
        if (m == null) return;
        for (int i = 0; i < alienCount; i++) if (alienCows[i] == m) return;
        if (alienCount < alienCows.length) {
            alienCows[alienCount++] = m;
            return;
        }
        // Day cho thi day con cu nhat ra. Quen mot con da danh dau tu lau con hon quen
        // dung con vua buong - con vua buong la con dang dung ngay canh, de vo lai nhat.
        System.arraycopy(alienCows, 1, alienCows, 0, alienCows.length - 1);
        alienCows[alienCows.length - 1] = m;
    }

    static boolean isAlienCow(Object o) {
        for (int i = 0; i < alienCount; i++) if (alienCows[i] == o) return true;
        return false;
    }

    /** Khoang cach theo truc xa nhat giua nhan vat va mot mob. */
    static int gapTo(@class.PLAYER@ me, @class.MOB@ m) {
        int dx = Math.abs(cowX(m) - me.@player.x@);
        int dy = Math.abs(cowY(m) - me.@player.y@);
        return dx > dy ? dx : dy;
    }

    /**
     * Hai duong nhan dang doc lap, chi can mot cai dung: id mob trong bang mobs, hoac ten
     * mau ma client gan vao ENTITY.name luc tao mob. Dung ca hai de khoi phu thuoc vao
     * viec id 131 co giong nhau tren moi server hay khong.
     */
    static boolean isCowKind(@class.MOB@ m) {
        if (m.@mob.template@ == COW_TEMPLATE) return true;
        String tpl = m.@entity.name@;
        return tpl != null && tpl.toLowerCase().indexOf(NAME_COW) >= 0;
    }

    /**
     * Vi tri con bo theo dung goc nhin cua server. Server dat pet.x = player.x roi gui
     * xuong, client luu vao o "diem den" va cho mob di bo toi dan; doc x/y dang ve se
     * thay bo tut lai xa hon thuc te, du de treo ca chang dat bo.
     */
    static int cowX(@class.MOB@ c) {
        int dest = c.@player.stepDestX@;
        return dest > 0 ? dest : c.@entity.x@;
    }

    static int cowY(@class.MOB@ c) {
        int dest = c.@player.stepDestY@;
        return dest > 0 ? dest : c.@entity.y@;
    }

    /** Khoang cach toi con bo theo truc xa nhat, hoac -1 neu khong thay bo. */
    static int cowGap() {
        @class.MOB@ c = cow();
        @class.PLAYER@ me = player();
        if (c == null || me == null) return -1;
        int dx = Math.abs(cowX(c) - me.@player.x@);
        int dy = Math.abs(cowY(c) - me.@player.y@);
        return dx > dy ? dx : dy;
    }

    /**
     * Id NPC de gui goi tin. Uu tien id thuc the thay duoc tren map, khong thay thi dung
     * id co dinh - phia server chi doi dung id nay.
     */
    static int npcIdOf(String needle, int fallback) {
        @class.VEC@ list = @class.CHARS@.@chars.entities@;
        if (list == null) return fallback;
        for (int i = 0; i < list.@vec.size@(); i++) {
            Object o = list.@vec.get@(i);
            if (o == null) continue;
            @class.ENTITY@ e = (@class.ENTITY@) o;
            if (e.@entity.kind@ != 2 || e.@entity.name@ == null) continue;
            if (e.@entity.name@.toLowerCase().indexOf(needle) >= 0) return e.@entity.npcId@;
        }
        return fallback;
    }

