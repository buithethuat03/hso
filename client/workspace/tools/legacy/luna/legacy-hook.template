            boolean variantTimeout = !opcodeReady && loginLastRetryAt > 0L
                    && t - loginLastRetryAt >= LOGIN_CHARACTER_LIST_FALLBACK_MS;
            if (!opcodeReady && !variantTimeout) return;
            if (opcodeReady && t - loginCharacterListReadyAt < LOGIN_CHARACTER_LIST_SETTLE_MS) {
