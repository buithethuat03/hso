    /**
     * AutoTrade va N4 khong duoc chen vao recovery cua Auto Tu Danh thuong.
     * Hai feature nay co state machine rieng va tu ban giao quyen combat.
     */
    static boolean attackRecoveryRouteOwnsCombat() {
        return state != OFF || n4State != N4_OFF;
    }

    /** World da du dieu kien de native combat khoi dong lai chua. */
    static boolean attackRecoveryWorldReady() {
        try {
            if (player() == null || mapHolderMissing() || playerDead()) return false;
            if (!HSOSKYPetFeedSupport.isPlayerInGame()) return false;
            return !HSOSKYPetFeedSupport.hasCurrentDialog();
        } catch (Throwable t) {
            return false;
        }
    }

    /**
     * Tat native combat mot lan trong luc cho world on dinh. Khong goi
     * onAutoAttackToggled(false) o day vi ham do ghi de RMS y dinh cua nguoi choi.
     */
    static void attackRecoverySuppress() {
        if (attackRecoverySuppressed) return;
        try {
            @class.ENGINE@.@engine.field.autoAttack@ = false;
            HSOSKYPetFeedSupport.setModAutoAttack(false);
            HSOSKYPetFeedSupport.persistentAutoAttack = false;
        } catch (Throwable t) {
            // Keep the frame loop alive during login/revive transitions.
        }
        attackRecoverySuppressed = true;
    }

    /** Xoa target cu mot lan; native engine se tu quet lai sau khi rearm. */
    static void attackRecoveryClearTarget() {
        if (attackRecoveryTargetCleared) return;
        try {
            @class.CHARS@.@chars.target@ = null;
        } catch (Throwable t) {
            // Target field is version-specific; the binary verifier catches a bad symbol.
        }
        attackRecoveryTargetCleared = true;
    }

    /** Native auto flag da bat va target hien tai da hop le de danh chua. */
    static boolean attackRecoveryTargetReady() {
        try {
            @class.ENTITY@ target = @class.CHARS@.@chars.target@;
            @class.ENTITY@ me = player();
            return target != null && me != null
                    && HSOSKYPetFeedSupport.isValidAutoTarget(target, me);
        } catch (Throwable t) {
            return false;
        }
    }

    /** Co con muc tieu hop le trong danh sach entity de phan biet target-lost voi map trong. */
    static boolean attackRecoveryHasTargetCandidate() {
        try {
            @class.VEC@ entities = @class.CHARS@.@chars.entities@;
            @class.ENTITY@ me = player();
            if (entities == null || me == null) return false;
            int count = entities.@vec.size@();
            for (int i = 0; i < count; i++) {
                Object candidate = entities.@vec.get@(i);
                if (candidate != null && candidate != me
                        && HSOSKYPetFeedSupport.isValidAutoTarget(candidate, me)) {
                    return true;
                }
            }
        } catch (Throwable t) {
            // A transient entity-list read must not disturb the normal combat frame.
        }
        return false;
    }

    /** Chon lai mob gan nhat khi native scan de trong target du da co entity hop le. */
    static boolean attackRecoveryAcquireTarget() {
        try {
            @class.ENTITY@ current = @class.CHARS@.@chars.target@;
            @class.PLAYER@ me = player();
            if (current != null && me != null
                    && HSOSKYPetFeedSupport.isValidAutoTarget(current, me)) {
                return true;
            }
            @class.VEC@ entities = @class.CHARS@.@chars.entities@;
            if (entities == null || me == null) return false;
            @class.ENTITY@ best = null;
            long bestDistance = Long.MAX_VALUE;
            int count = entities.@vec.size@();
            for (int i = 0; i < count; i++) {
                Object value = entities.@vec.get@(i);
                if (!(value instanceof @class.ENTITY@) || value == me) continue;
                @class.ENTITY@ candidate = (@class.ENTITY@) value;
                if (!HSOSKYPetFeedSupport.isValidAutoTarget(candidate, me)) continue;
                long dx = (long) candidate.@entity.x@ - me.@player.x@;
                long dy = (long) candidate.@entity.y@ - me.@player.y@;
                long distance = dx * dx + dy * dy;
                if (best == null || distance < bestDistance) {
                    best = candidate;
                    bestDistance = distance;
                }
            }
            if (best == null) return false;
            @class.CHARS@.@chars.target@ = best;
            return true;
        } catch (Throwable t) {
            // A transient entity-list update must not interrupt the normal combat frame.
            return false;
        }
    }

    /** Bat dau mot recovery moi, khong reset lai recovery dang cho. */
    static void attackRecoveryBegin(String reason) {
        if (attackRecoveryRouteOwnsCombat()) return;
        if (!HSOSKYPetFeedSupport.persistentAutoAttack && !attackRecoveryDesired) return;
        if (attackRecoveryState == ATTACK_RECOVERY_WAITING
                || attackRecoveryState == ATTACK_RECOVERY_VERIFYING) return;

        attackRecoveryDesired = true;
        attackRecoveryReason = reason;
        attackRecoveryState = ATTACK_RECOVERY_WAITING;
        attackRecoveryStableSince = 0L;
        attackRecoveryVerifyUntil = 0L;
        attackRecoveryNativeMissingSince = 0L;
        attackRecoveryTargetMissingSince = 0L;
        attackRecoveryTargetCleared = false;
        attackRecoveryRearms = 0;
        attackRecoverySuppress();
    }

    /**
     * Quan sat cac moc ma onCanvasUpdate cua class binary khong biet: death -> live,
     * login -> game, va rising edge cua persistentAutoAttack.
     */
    static void attackRecoveryObserve() {
        boolean inGame = false;
        boolean dead = false;
        boolean worldSurfaceReady = false;
        boolean nativeDisconnected = false;
        boolean nativeMenuShowing = false;
        try {
            inGame = player() != null && !mapHolderMissing()
                    && HSOSKYPetFeedSupport.isPlayerInGame();
            // Keep the one-shot ENTER state tied to the actual world surface,
            // not only to isPlayerInGame().  The latter can briefly drop while
            // native menus/screens are being rebuilt, which used to arm a new
            // ENTER and close the Tự động menu as soon as it was opened.
            worldSurfaceReady = nativeWorldReadyForLogin();
            nativeDisconnected = HSOSKYPetFeedSupport.isDisconnected;
            try {
                nativeMenuShowing = @class.CANVAS@.@canvas.menu@ != null
                        && @class.CANVAS@.@canvas.menu@.@menu.isShowing@;
            } catch (Throwable ignoreMenu) {
                nativeMenuShowing = false;
            }
            dead = playerDead();
        } catch (Throwable t) {
            inGame = false;
            worldSurfaceReady = false;
            nativeDisconnected = true;
        }

        boolean persistent = HSOSKYPetFeedSupport.persistentAutoAttack;
        if (!inGame) {
            attackRecoveryWasInGame = false;
            attackRecoveryLastPersistent = persistent;
            // A native menu can temporarily replace currentScreen while the
            // player is still online. Do not treat that overlay as a fresh
            // login edge, otherwise the next frame clears the synthetic key
            // state and immediately closes the native Tự động menu. A real
            // logout/reconnect still has isDisconnected set, and the login
            // screen is an unambiguous reset boundary.
            boolean loginSurface = onLoginScreen();
            if (!worldSurfaceReady && !nativeMenuShowing
                    && (nativeDisconnected || loginSurface)) {
                postLoginEnterPending = false;
                postLoginEnterSent = false;
                postLoginEnterReleasePending = false;
                postLoginEnterAt = 0L;
                try {
                    @class.CANVAS@.@canvas.keyHeld@[5] = false;
                    @class.CANVAS@.@canvas.keyPressed@[5] = false;
                } catch (Throwable ignore) {
                    // Input arrays may be unavailable while leaving the world.
                }
            }
            return;
        }



        if (!attackRecoveryWasInGame && !postLoginEnterSent) {

            postLoginEnterPending = true;
            postLoginEnterAt = now() + POST_LOGIN_ENTER_DELAY_MS;
        }

        if (dead) {
            if (!attackRecoveryRouteOwnsCombat()
                    && (persistent || attackRecoveryDesired)) {
                attackRecoveryDesired = true;
                if (attackRecoveryState != ATTACK_RECOVERY_WAITING) {
                    attackRecoveryState = ATTACK_RECOVERY_WAITING;
                    attackRecoveryReason = "revive";
                    attackRecoveryStableSince = 0L;
                    attackRecoveryVerifyUntil = 0L;
                    attackRecoveryNativeMissingSince = 0L;
                    attackRecoveryTargetMissingSince = 0L;
                    attackRecoveryTargetCleared = false;
                    attackRecoveryRearms = 0;
                }
                attackRecoverySuppress();
            }
            attackRecoveryWasInGame = true;
            attackRecoveryLastPersistent = persistent;
            return;
        }

        if (!attackRecoveryWasInGame && persistent) {
            attackRecoveryBegin("login");
        } else if (persistent && !attackRecoveryLastPersistent) {
            attackRecoveryBegin("toggle");
        }

        attackRecoveryWasInGame = true;
        attackRecoveryLastPersistent = persistent;
    }



    /** Sends one OK/ENTER press 500ms after a login/world transition. */
    static void postLoginEnterTick() {
        if (postLoginEnterReleasePending) {
            try {
                @class.CANVAS@.@canvas.keyHeld@[5] = false;
                @class.CANVAS@.@canvas.keyPressed@[5] = false;
            } catch (Throwable ignore) {
                // The input arrays can be rebuilt during a screen transition.
            }
            postLoginEnterReleasePending = false;
            return;
        }
        if (!postLoginEnterPending || postLoginEnterSent) return;
        if (now() < postLoginEnterAt) return;
        try {
            pressOk();
        } catch (Throwable ignore) {
            // A transient input-array transition must not stop the frame loop.
        }
        postLoginEnterSent = true;
        postLoginEnterPending = false;
        // The native input loop consumes a keyHeld bit as a level. Release it
        // on the next canvas tick so later manual opening of Tự động is not
        // immediately dismissed by a stale synthetic Enter.
        postLoginEnterReleasePending = true;
    }

    /**
     * MENUBOX.show remains native. If a real user key edge opens a menu while
     * the one-shot login cleanup is still waiting, cancel only that pending
     * synthetic press. The observer deliberately does not depend on the
     * localized title: the native title may be encoded differently between
     * client builds, while the input edge and show call are stable. An
     * automatic popup has no key edge and still receives the ENTER cleanup.
     * Release the observed key on the next frame so a stale keyHeld level
     * cannot close the manually opened menu.
     */
    public static void observeNativeMenuOpen(String title) {
        if (!postLoginEnterPending || postLoginEnterSent) return;
        boolean userEnter = false;
        try {
            // keyPressed is the edge generated by the user's soft-key event.
            // Some native menu paths consume that edge before MENUBOX.show;
            // while the one-shot timer is still pending, a held OK bit is
            // therefore also evidence of a real manual key event. Synthetic
            // pressOk() cannot match this window because it runs only after
            // postLoginEnterAt and immediately clears the pending flag.
            userEnter = @class.CANVAS@.@canvas.keyPressed@[5];
            if (!userEnter && @class.CANVAS@.@canvas.keyHeld@[5]
                    && now() < postLoginEnterAt) {
                userEnter = true;
            }
        } catch (Throwable ignore) {
            return;
        }
        if (!userEnter) return;
        postLoginEnterPending = false;
        postLoginEnterSent = true;
        postLoginEnterReleasePending = true;
        postLoginEnterAt = 0L;
    }

    /** Native kickstart co gioi han va co buoc verify, khong lap theo frame. */
    static void attackRecoveryRearm() {
        long t = now();
        if (attackRecoveryRearms >= ATTACK_RECOVERY_MAX_REARMS) {
            attackRecoverySuppress();
            attackRecoveryState = ATTACK_RECOVERY_IDLE;
            attackRecoveryDesired = false;
            return;
        }

        attackRecoveryClearTarget();
        try {
            HSOSKYPetFeedSupport.persistentAutoAttack = true;
            HSOSKYPetFeedSupport.setModAutoAttack(true);
            @class.ENGINE@.@engine.field.autoAttack@ = true;
            HSOSKYPetFeedSupport.reengageAutoAttack();
        } catch (Throwable t2) {
            // The verify pass below will retry once after the native state settles.
        }
        attackRecoverySuppressed = false;
        attackRecoveryLastPersistent = true;
        attackRecoveryLastRearm = t;
        attackRecoveryNativeMissingSince = 0L;
        attackRecoveryTargetMissingSince = 0L;
        attackRecoveryRearms++;
        attackRecoveryVerifyUntil = t + ATTACK_RECOVERY_VERIFY_MS;
        attackRecoveryState = ATTACK_RECOVERY_VERIFYING;
    }

    /** Chay sau revive, truoc AutoTrade/N4, moi frame. */
    static void attackRecoveryTick() {
        if (attackRecoveryState == ATTACK_RECOVERY_IDLE) return;

        if (attackRecoveryRouteOwnsCombat()) {
            attackRecoveryState = ATTACK_RECOVERY_IDLE;
            attackRecoveryDesired = false;
            attackRecoverySuppressed = false;
            attackRecoveryNativeMissingSince = 0L;
            attackRecoveryTargetMissingSince = 0L;
            return;
        }
        if (!attackRecoveryDesired) {
            attackRecoveryState = ATTACK_RECOVERY_IDLE;
            attackRecoverySuppressed = false;
            attackRecoveryNativeMissingSince = 0L;
            attackRecoveryTargetMissingSince = 0L;
            return;
        }

        long t = now();
        if (attackRecoveryState == ATTACK_RECOVERY_WAITING) {
            if (!attackRecoveryWorldReady()) return;
            if (!attackRecoveryTargetCleared) attackRecoveryClearTarget();
            if (attackRecoveryStableSince == 0L) {
                attackRecoveryStableSince = t;
                return;
            }
            if (t - attackRecoveryStableSince < ATTACK_RECOVERY_SETTLE_MS) return;
            attackRecoveryRearm();
            return;
        }

        if (attackRecoveryState == ATTACK_RECOVERY_VERIFYING) {
            if (!attackRecoveryWorldReady()) return;
            try {
                attackRecoveryAcquireTarget();
                if (HSOSKYPetFeedSupport.isPlayerAuto()
                        && attackRecoveryTargetReady()) {
                    attackRecoveryState = ATTACK_RECOVERY_ARMED;
                    attackRecoveryNativeMissingSince = 0L;
                    attackRecoveryTargetMissingSince = 0L;
                    return;
                }
            } catch (Throwable t2) {
                // Treat an unreadable native state as not ready yet.
            }
            if (t < attackRecoveryVerifyUntil) return;

            // Stop the binary support from kicking once per frame if native flags did not settle.
            attackRecoverySuppress();
            attackRecoveryState = ATTACK_RECOVERY_WAITING;
            attackRecoveryStableSince = t;
            // A second bounded attempt must clear the stale target again; otherwise
            // a native scanner that retained null/invalid state cannot recover.
            attackRecoveryTargetCleared = false;
            return;
        }

        if (attackRecoveryState == ATTACK_RECOVERY_ARMED) {
            try {
                if (!HSOSKYPetFeedSupport.persistentAutoAttack) {
                    attackRecoveryNativeMissingSince = 0L;
                    attackRecoveryTargetMissingSince = 0L;
                    return;
                }
                if (HSOSKYPetFeedSupport.isPlayerMovingKeyHeld()) {
                    attackRecoveryNativeMissingSince = 0L;
                    attackRecoveryTargetMissingSince = 0L;
                    return;
                }
                if (!HSOSKYPetFeedSupport.isPlayerAuto()) {
                    if (attackRecoveryNativeMissingSince == 0L) {
                        attackRecoveryNativeMissingSince = now();
                        return;
                    }
                    if (now() - attackRecoveryNativeMissingSince
                            < ATTACK_RECOVERY_NATIVE_DRIFT_MS) {
                        return;
                    }
                    attackRecoveryState = ATTACK_RECOVERY_WAITING;
                    attackRecoveryStableSince = 0L;
                    attackRecoveryNativeMissingSince = 0L;
                    attackRecoveryTargetMissingSince = 0L;
                    attackRecoveryTargetCleared = false;
                    attackRecoveryRearms = 0;
                    attackRecoveryReason = "native-drift";
                    attackRecoverySuppress();
                    return;
                }
                attackRecoveryNativeMissingSince = 0L;
                if (attackRecoveryTargetReady()) {
                    attackRecoveryTargetMissingSince = 0L;
                    return;
                }
                if (attackRecoveryTargetMissingSince == 0L) {
                    attackRecoveryTargetMissingSince = now();
                    attackRecoveryAcquireTarget();
                    return;
                }
                if (attackRecoveryTargetReady()) {
                    attackRecoveryTargetMissingSince = 0L;
                    return;
                }
                if (!attackRecoveryHasTargetCandidate()) {
                    attackRecoveryTargetMissingSince = 0L;
                    return;
                }
                if (attackRecoveryTargetMissingSince == 0L) {
                    attackRecoveryTargetMissingSince = now();
                    return;
                }
                if (now() - attackRecoveryTargetMissingSince >= ATTACK_RECOVERY_TARGET_LOST_MS) {
                    attackRecoveryState = ATTACK_RECOVERY_WAITING;
                    attackRecoveryStableSince = 0L;
                    attackRecoveryTargetMissingSince = 0L;
                    attackRecoveryTargetCleared = false;
                    attackRecoveryRearms = 0;
                    attackRecoveryReason = "target-lost";
                    attackRecoverySuppress();
                }
            } catch (Throwable t2) {
                // Do not disturb a normal combat frame if a transient field is unreadable.
            }
        }
    }

    /**
     * RMS persistence belongs to the native support, but the native runtime
     * can rebuild its auto-horse flag while returning from the login screen.
     * Re-arm only on world-entry and on a bounded retry cadence; never clear
     * the user's persisted preference during a reconnect.
