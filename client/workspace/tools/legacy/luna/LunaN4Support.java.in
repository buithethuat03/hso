    private static int mapIdOfName(String name) {
        if (name == null) return -1;
        String n = name.toLowerCase().trim();
        for (int i = 0; i < MAP_IDS.length && i < MAP_LABELS.length; i++) {
            String candidate = MAP_LABELS[i].toLowerCase();
            if (n.equals(candidate) || n.indexOf(candidate) >= 0 || candidate.indexOf(n) >= 0) {
                return MAP_IDS[i];
            }
        }
        return -1;
    }

    private static int nextHop(int from, int to) {
        if (from == to) return to;
        if (from < 0 || from >= MAP_MAX || to < 0 || to >= MAP_MAX) return -1;
        boolean[] seen = new boolean[MAP_MAX];
        int[] prev = new int[MAP_MAX];
        int[] queue = new int[MAP_MAX];
        for (int i = 0; i < MAP_MAX; i++) prev[i] = -1;
        int head = 0;
        int tail = 0;
        queue[tail++] = from;
        seen[from] = true;
        while (head < tail) {
            int cur = queue[head++];
            for (int i = 0; i + 1 < MAP_EDGES.length; i += 2) {
                int a = MAP_EDGES[i];
                int b = MAP_EDGES[i + 1];
                int other = a == cur ? b : (b == cur ? a : -1);
                if (other < 0 || other >= MAP_MAX || seen[other]) continue;
                seen[other] = true;
                prev[other] = cur;
                if (other == to) {
                    head = tail;
                    break;
                }
                queue[tail++] = other;
            }
        }
        if (!seen[to]) return -1;
        int cursor = to;
        while (prev[cursor] != from) {
            cursor = prev[cursor];
            if (cursor < 0) return -1;
        }
        return cursor;
    }

    private static @class.WAYPOINT@ findWaypointTo(int destMapId) {
        @class.VEC@ list = @class.TILEMAP@.@tilemap.waypoints@;
        if (list == null) return null;
        for (int i = 0; i < list.@vec.size@(); i++) {
            Object o = list.@vec.get@(i);
            if (o == null) continue;
            @class.WAYPOINT@ wp = (@class.WAYPOINT@) o;
            if (mapIdOfName(wp.@waypoint.destName@) == destMapId) return wp;
        }
        return null;
    }
}
