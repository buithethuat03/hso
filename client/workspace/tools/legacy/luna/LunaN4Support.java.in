    private static final int[] MAP_EDGES = {
            0, 1, 1, 2, 1, 3, 1, 7, 1, 50, 3, 4, 4, 5, 5, 6,
            7, 8, 7, 11, 7, 15, 7, 18, 8, 9, 9, 10, 11, 12, 12, 13,
