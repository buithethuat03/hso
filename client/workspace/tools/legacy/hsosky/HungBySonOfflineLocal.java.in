    public static boolean handles(String key) {
        return "ch.chon_do".equals(key) || "ch.chon_bua".equals(key) || "ch.nang".equals(key)
            || "ch.ma_bua".equals(key) || "ch.bua_theo_cap".equals(key)
            || HungBySonTradeLocal.handles(key);
    }

    public static String formula(String key, int variant) {
        if ("ch.chon_do".equals(key)) return "q3|0|@0|3";
        if ("ch.chon_bua".equals(key)) return "q3|0|@0|7";
        if ("ch.nang".equals(key)) return "q3|2|0|0";
        if ("ch.bua_theo_cap".equals(key)) return "val|" + smartMode(variant);
        if ("ch.ma_bua".equals(key)) {
            int id = cloverId(variant);
            if (id < 0) stop("Cường hóa: không có cỏ " + (variant == 2 ? "4" : "3") + " lá trong túi. Đã dừng Auto.");
            return "val|" + id;
        }
        String result = HungBySonTradeLocal.formula(key, variant);
        return result == null ? NOT_READY : result;
    }

    /** User policy: four-leaf clover only at current +8, +9 and +10; none at other levels. */
    public static int smartMode(int currentLevel) {
        return currentLevel >= 8 && currentLevel <= 10 ? 2 : 0;
    }

    public static String guide() {
        return "Các tính năng MOD hoạt động cục bộ, không cần key hay máy chủ MOD.\n"
            + "Auto Cường Hóa: trong túi đồ chọn trang bị > Thêm vào DS; mở MOD HungDZ > Auto Cường Hóa, "
            + "chọn cấp cộng và cỏ may mắn rồi bật. Tắt Auto Phó Bản khi dùng.\n"
            + "Thông minh: chỉ dùng cỏ 4 lá khi trang bị đang +8, +9 hoặc +10; các mức còn lại không dùng cỏ. "
            + "Thiếu loại cỏ đã chọn sẽ dừng. Đạt cấp mục tiêu thì chuyển món tiếp theo.\n"
            + "Auto Đi Buôn V3: chuẩn bị vật phẩm thú đã chọn; lần đầu tự đọc cửa hàng đá quý.\n"
            + "Auto Farm, Auto Khu 2, Phó Bản, thay set, tự buff và PvP dùng menu/cấu hình sẵn có.\n"
            + "Các thao tác vẫn cần kết nối server game và đủ vật phẩm/tiền theo luật server game.";
    }

