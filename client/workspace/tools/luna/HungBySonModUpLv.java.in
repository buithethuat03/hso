    static String cat(String a, String b) {
        return new StringBuffer(a).append(b).toString();
    }

    static String turned(boolean on) {
        return on ? "Đã bật " : "Đã tắt ";
    }

    public boolean onAction(int action, int extra) {
        try {
            if (blockMazeAction(action)) return true;
            if (action == MENU) { showMain(); return true; }
            if (action == NGA_TU) { showNgaTu(); return true; }
            if (action == FOG_MENU) { showFog(); return true; }
            if (action == FREE) { free = !free; notice(cat(turned(free), "vào Ngã Tư bằng lượt free, đồng Horae")); showNgaTu(); return true; }
            if (action == GEM) { gem = !gem; notice(cat(turned(gem), "vào Ngã Tư bằng ngọc")); showNgaTu(); return true; }
            if (action == BOTH) { both = !both; notice(cat(turned(both), "vào Ngã Tư bằng cả lượt free, đồng Horae và ngọc")); showNgaTu(); return true; }
            if (action == FOG) { fog = !fog; notice(cat(turned(fog), "tự động vào Làng Phủ Sương")); showFog(); return true; }
            if (action == MAZE) { setMaze(!maze); notice(cat(turned(maze), "Auto Mê cung")); showMain(); return true; }
            if (action == FINISH) {
                finish = !finish;
                homeSince = 0L;
                dungeonContext();
                notice(cat(turned(finish), "tự động hoàn thành phó bản"));
                showMain();
                return true;
            }
            if (action == FIRE) {
                fire = !fire;
                fireMap = map();
                fireZone = zone();
                notice(cat(turned(fire), "tự động đốt Lửa Thiêng"));
                @~lliiiiil@.@~liliilll@();
                return true;
            }
        } catch (Throwable ignored) {
        }
        return false;
    }

    // ------------------------------------------------------------------ dialogs

    /** Every native dialog text; true suppresses the dialog (ModUpLv closes it). */
    public static boolean onDialog(String text) {
        try {
            if (text == null) return false;
            if (maze && text.startsWith("Xin chờ")) return true;
            if (fog && text.endsWith("sương")) {
                fog = false;
                info("Thông báo", "Bạn đã hết vé vào Làng Phủ Sương");
            }
            if (!finish) return false;
            String plain = plain(text);
            boolean answered = false;
            // YES/NO dialogs of the Phó chỉ huy (ModUpLv K092): answer like it, one rule at a time.
            if (free && plain.endsWith(ALONE)) { reply(); answered = true; }
            if (gem && plain.endsWith(GEM_FEE)) { reply(); answered = true; }
            if (both && plain.endsWith(ALONE)) { reply(); answered = true; }
            if (both && plain.endsWith(GEM_FEE)) { reply(); answered = true; }
            if (free && plain.endsWith(GEM_FEE)) {
                free = false;
                finish = false;
                info("TB Phó Bản", "Bạn đã đi hết lượt phó bản free hoặc hết vé.\n=> Tắt phó bản free và Horae");
            }
            // OK dialogs (ModUpLv K014). The daily limit refuses every entry mode, free/Horae included;
            // leaving one mode on re-asks the NPC every tick and re-opens this dialog forever.
            if (finish && plain.indexOf(DAILY_LIMIT) >= 0) {
                stopEntry();
                info("TB Phó Bản", "Đã hết 10 lượt phó bản trong 1 ngày.\n=> Tắt tự động vào phó bản");
            }
            if (finish && free && plain.startsWith(NEED)) {
                free = false; finish = false;
                info("TB Phó Bản", "Đã hết lượt miễn phí hoặc vé phó bản.\n=> Tắt phó bản free và Horae");
            }
            if (finish && free && plain.startsWith(LEVEL)) {
                free = false; finish = false;
                info("TB Phó Bản", "Level chưa đạt yêu cầu.\n=> Tắt phó bản free và Horae");
            }
            if (finish && gem && plain.startsWith(NEED)) {
                gem = false; finish = false;
                info("TB Phó Bản", "Không đủ ngọc để tiếp tục.\n=> Tắt vào bằng ngọc");
            }
            if (finish && gem && plain.startsWith(LEVEL)) {
                gem = false; finish = false;
                info("TB Phó Bản", "Level chưa đạt yêu cầu.\n=> Tắt vào bằng ngọc");
            }
            if (finish && both && plain.startsWith(LEVEL)) {
                both = false; finish = false;
                info("TB Phó Bản", "Level chưa đạt yêu cầu.\n=> Tắt phó bản bằng cả lượt free, đồng Horae và ngọc");
            }
            if (finish && both && plain.startsWith(NEED)) {
                both = false; finish = false;
                info("TB Phó Bản", "Không đủ ngọc để tiếp tục.\n=> Tắt phó bản bằng cả lượt free, đồng Horae và ngọc");
            }
            // Unknown refusal wording: entry re-asks the NPC every 840ms, so stop after a few unanswered dialogs.
            if (answered) entryRefusals = 0;
            else if (finish && (free || gem || both) && map() != 48 && ++entryRefusals >= MAX_ENTRY_REFUSALS) {
                stopEntry();
                info("TB Phó Bản", "Phó chỉ huy không cho vào phó bản.\n=> Tắt tự động vào phó bản");
            }
        } catch (Throwable ignored) {
        }
        return false;
    }

    static void stopEntry() {
        free = gem = both = false;
        finish = false;
        homeSince = 0L;
        entryRefusals = 0;
    }

    /** Lower-case ASCII words separated by single spaces; precomposed and combining tone marks both drop. */
    static String plain(String text) {
        StringBuffer out = new StringBuffer(text.length());
        boolean gap = false;
        for (int i = 0; i < text.length(); i++) {
            char c = text.charAt(i);
            if (c >= '̀' && c <= 'ͯ') continue;
            int k = VI_MARKED.indexOf(c);
            if (k >= 0) c = VI_PLAIN.charAt(k);
            else if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
            if (c >= 'a' && c <= 'z' || c >= '0' && c <= '9') {
                if (gap && out.length() > 0) out.append(' ');
                gap = false;
                out.append(c);
            } else {
                gap = true;
            }
        }
        return out.toString();
    }

    // ------------------------------------------------------------------ tick

    public void update() {
        try {
            long now = now();
            int map = map();
            synchronized (AutoAttackRuntime.requestLock()) {
                if (mazePlayer != null && (!maze || !HungAutoAttackAccess.farmWorldReady()
                        || mazePlayer != @~liiliii@.@~llilliill@ || mazeMap != map || mazeZone != zone())) {
                    releaseMazeCombat();
                    clearMazeWalk();
                }
            }
            dungeonContext();
            if (map != 48) dungeonNotify = true;
            if (map == 48 || !finish) entryRefusals = 0;
            if (!HungAutoAttackAccess.farmWorldReady()) return;
            @~lliiil@ player = @~liiliii@.@~llilliill@;
            if (fire && now >= fireAt) { fireAt = now + FIRE_MS; fireTick(player, map); }
            if (finish && now >= dungeonAt) {
                dungeonAt = now + DUNGEON_MS;
                dungeonEntry(player, map, now);
                if (map == 48) {
                    if (dungeonNotify) {
                        dungeonNotify = false;
                        meteorX = meteorY = -1;
                        notice("Đã vào phó bản và bắt đầu thực thi");
                        info("Thông báo", "Đã vào phó bản và bắt đầu thực thi");
                    }
                    dungeonFight(player);
                }
            }
            if (fog && now >= fogAt) { fogAt = now + FOG_MS; fogTick(player, map); }
            if (maze && now >= mazeAt) { mazeAt = now + MAZE_MS; mazeTick(player, map, now); }
        } catch (Throwable ignored) {
        }
    }

    // ------------------------------------------------------------------ Lửa thiêng

    static void fireTick(@~lliiil@ player, int map) {
        if (map != fireMap || zone() != fireZone) return;
        // ModUpLv requires its native auto (state 1); Hung also runs Auto đánh and Auto Farm.
        if (@~lliiil@.@~lllilli@ != 1 && !AutoAttackRuntime.enabled() && !@~lliiiiil@.@~lililiilill@) return;
        @~liiiliii@ flame = null;
        et world = @~liiliii@.@~llillilll@;
        for (int i = 0; world != null && i < world.c(); i++) {
            Object value = world.a(i);
            if (!(value instanceof @~liiiliii@)) continue;
            @~liiiliii@ e = (@~liiiliii@)value;
            if (e.cv == 1 && FIRE_NAME.equals(e.cC)) { flame = e; break; }
        }
        @~llilli@ fireItem = null, oil = null;
        et bag = @~llilli@.@~liiillili@;
        for (int i = 0; bag != null && i < bag.c(); i++) {
            Object value = bag.a(i);
            if (!(value instanceof @~llilli@)) continue;
            @~llilli@ item = (@~llilli@)value;
            if (item.@~liiiiliii@ == null || item.@~llllii@ <= 0) continue;
            if (FIRE_NAME.equals(item.@~liiiiliii@) && fireItem == null) fireItem = item;
            else if (OIL_NAME.equals(item.@~liiiiliii@) && oil == null) oil = item;
            if (fireItem != null && oil != null) break;
        }
        if (flame == null && fireItem != null) useItem(fireItem.O);
        else if (flame != null && flame.bz < 4 && oil != null) useItem(oil.O);
    }

    // ------------------------------------------------------------------ Ngã Tư Tử Thần

    static boolean village(int map) {
        return map == 1 || map == 33 || map == 34 || map == 48 || map == 67 || map == 69 || map == 93;
    }

    /** ModUpLv K012.K157: reach the Phó chỉ huy of a village and ask to enter. */
    static void dungeonEntry(@~lliiil@ player, int map, long now) {
        if (!free && !gem && !both) return;
        if (!village(map)) {
            if (homeSince == 0L) {
                homeSince = now;
                notice("Map hiện tại không có NPC Phó chỉ huy! 5 giây nữa sẽ dùng Bùa về làng (nếu còn) để đi tìm.");
            }
            if (now - homeSince >= HOME_SCROLL_MS) {
                useItem(RETURN_SCROLL);
                homeSince = 0L;
            }
        } else {
            homeSince = 0L;
        }
        if (map == 1) { approach(player, 615, 528, 50); npc(-37, 0, 0); }
        else if (map == 33) approach(player, 0, 608, 50);
        else if (map == 34) { approach(player, 584, 456, 50); npc(-37, 0, 0); }
        else if (map == 67) approach(player, 0, 312, 50);
        else if (map == 69) { approach(player, 396, 306, 50); npc(-37, 0, 0); }
        else if (map == 93) { approach(player, 554, 528, 50); npc(-37, 0, 0); }
    }

    /** New server notices only: never replay a previous run's scrolling info queue. */
    public static synchronized void onDungeonNotice(String text) {
        if (!dungeonContext()) return;
        if (dungeonPosition.onNotice(text, now())) dungeonAimDirty = true;
    }

    static synchronized boolean dungeonContext() {
        boolean active = finish && map() == 48;
        if (active && !dungeonActive) {
            dungeonPosition.enterDungeon();
            dungeonAimDirty = true;
        } else if (!active && dungeonActive) {
            dungeonPosition.reset();
            dungeonMovement.release(MovementArbiter.OWNER_N4);
            dungeonAimDirty = false;
        }
        dungeonActive = active;
        return active;
    }

    static boolean dungeonAtStand(@~lliiil@ player) {
        return dungeonPosition.hasTarget() && player.aZ / 24 == dungeonPosition.targetTileX()
                && player.ba / 24 == dungeonPosition.targetTileY();
    }

    /** Special sends have no walker: move only to a direction's fixed stand tile, then hold. */
    static synchronized void dungeonFight(@~lliiil@ player) {
        AutoAttackRuntime.engageMonsters();
        dungeonAccess.farmSpotHold();
        if (dungeonAimDirty || dungeonAtStand(player)) {
            player.cO = null;
            if (player.cG == 1) player.cG = 0;
            dungeonAimDirty = false;
        }
        if (!dungeonPosition.hasTarget()) return;
        if (dungeonAtStand(player)) {
            dungeonMovement.release(MovementArbiter.OWNER_N4);
            return;
        }
        if (player.cO == null && dungeonMovement.acquire(MovementArbiter.OWNER_N4)) {
            int[] target = {dungeonPosition.targetX(), dungeonPosition.targetY()};
            if (dungeonMovement.submitPath(MovementArbiter.OWNER_N4, target, 2)) walk(target[0], target[1]);
        }
    }

    static void approach(@~lliiil@ player, int x, int y, int radius) {
        if (@~liiiliii@.c(player.aZ, player.ba, x, y) > radius) {
            walk(x, y);
            notice(new StringBuffer("Đang di chuyển tới tọa độ: (").append(x).append(", ").append(y).append(")").toString());
        }
    }

    // ------------------------------------------------------------------ Làng Phủ Sương

    /** ModUpLv K082.K157; Mrs Oda row and the sale-trip gate from HungFogOdaPatcher. */
    static void fogTick(@~lliiil@ player, int map) {
        if (map == 135) {
            @~liiiliii@ serena = nearestNpc(player, "Serena");
            int d = serena == null ? Integer.MAX_VALUE : distance(player, serena);
            if (serena != null && d > 50) walk(serena.aZ, serena.ba);
            else if (player.cG == 0 && d < 50) {
                npc(-104, 0, 1);
                info("Làng Phủ Sương", new StringBuffer("Đã vào Làng Phủ Sương lần thứ ").append(++fogCount).toString());
            }
        } else if (map == 1) {
            if (codexFogSaleBusy()) return;
            @~liiiliii@ oda = nearestNpc(player, "Mrs Oda");
            if (oda == null) return;
            int d = distance(player, oda);
            if (d > 50) walk(oda.aZ, oda.ba);
            // Mrs Oda has 16 rows here and "Làng phủ sương" is the last; ModUpLv's row 16 was ignored.
            else if (player.cG == 0) npc(-81, 0, 15);
        }
    }

    /** An Auto bán rác trip owns the village walk until it restores Farm (state back to 0). */
    public static boolean codexFogSaleBusy() {
        return @~lliiilll@.@~lilliiiiill@ && @~lliiiiil@.@~lililiilill@ && @~lliiilll@.@~lilliiiilil@ != 0;
    }

    static @~liiiliii@ nearestNpc(@~lliiil@ player, String name) {
        et world = @~liiliii@.@~llillilll@;
        @~liiiliii@ best = null;
        int bestDistance = Integer.MAX_VALUE;
        for (int i = 0; world != null && i < world.c(); i++) {
            Object value = world.a(i);
            if (!(value instanceof @~liiiliii@)) continue;
            @~liiiliii@ e = (@~liiiliii@)value;
            if (e.cv != 2 || !name.equals(e.cC)) continue;
            int d = distance(player, e);
            if (d > bestDistance) continue;
            bestDistance = d;
            best = e;
        }
        return best;
    }

    // ------------------------------------------------------------------ Mê cung

    /** Exclusive intent: shut down competing combat/movement before exposing the new owner. */
    public static void setMaze(boolean enabled) {
        synchronized (AutoAttackRuntime.requestLock()) {
            if (maze == enabled) return;
            maze = false;
            releaseMazeCombat();
            clearMazeWalk();
            if (enabled) {
                if (AutoAttackRuntime.enabled()) AutoAttackRuntime.handleAction(-111);
                if (AutoAttackRuntime.specialEnabled()) AutoAttackRuntime.handleAction(-116);
                // The old monster toggle is no longer a setting. Special OFF already releases it.
                @~lliillil@.@~ll@(false);
                if (@~lliillii@.@~liilliliili@) new @~lliillii@().onAction(-85, 0);
                dungeonAccess.stopFarm();
                finish = free = gem = both = fog = fire = false;
                homeSince = 0L;
                @~lliiil@ player = @~liiliii@.@~llilliill@;
                if (player != null) {
                    player.cO = null;
                    if (player.cG == 1) player.cG = 0;
                }
                mazeReset();
                mazeAt = 0L;
                maze = true;
            }
        }
        dungeonContext();
    }

    /** The registry and direct Auto Attack/chat entry points consume conflicting toggles. */
    public static boolean blockMazeAction(int action) {
        if (!maze) return false;
        if (action == -40 || action == -85 || action == -98 || action == -111 || action == -112 || action == -113
                || action == -116 || action == -117 || action == FREE || action == GEM || action == BOTH
                || action == FOG || action == FINISH || action == FIRE) {
            notice("Hãy tắt Auto Mê cung trước khi bật auto khác");
            return true;
        }
        return false;
    }

    /** Farm OFF must yield only to a live guard cast in this exact player/map/zone. */
    public static boolean mazeOwnsCombat() {
        if (!maze || !HungAutoAttackAccess.farmWorldReady()) return false;
        @~lliiil@ player = @~liiliii@.@~llilliill@;
        if (!mazeCombat.owns(player, map(), zone())) return false;
        Object held = mazeCombat.target();
        if (!(held instanceof @~liiiliii@)) return false;
        @~liiiliii@ target = (@~liiiliii@)held;
        if (target.bs <= 0 || target.cG == 4 || target.dz) return false;
        et world = @~liiliii@.@~llillilll@;
        for (int i = 0; world != null && i < world.c(); i++) if (world.a(i) == target) return true;
        return false;
    }

    static void clearMazeWalk() {
        if (mazePlayer != null) {
            mazePlayer.cO = null;
            if (mazePlayer.cG == 1) mazePlayer.cG = 0;
        }
        mazePlayer = null;
        mazeMap = mazeZone = -1;
    }

    static void releaseMazeCombat() {
        Object owner = mazeCombat.player();
        mazeCombat.release();
        if (owner instanceof @~lliiil@) {
            @~lliiil@ previous = (@~lliiil@)owner;
            @~lillill@ cast = previous.di;
            // A replaced actor must not retain a tag-zero callback after losing this owner.
            if (cast != null && cast.@~llillilil@ == previous && cast.codexAutoAttackGeneration == 0) {
                cast.codexAutoAttackGeneration = -1;
                HungAutoAttackAccess.cancelCast(cast);
            }
        }
        // Native cleanup is valid only for the current local actor that this module claimed.
        if (owner != null && owner == @~liiliii@.@~llilliill@) @~lliiiiil@.@~lillllll@();
    }

    /** ModUpLv K002.K143. */
    static void mazeTick(@~lliiil@ player, int map, long now) {
        synchronized (AutoAttackRuntime.requestLock()) {
        if (!maze) return;
        if (mazePlayer != player || mazeMap != map || mazeZone != zone()) {
            releaseMazeCombat();
            clearMazeWalk();
            mazePlayer = player;
            mazeMap = map;
            mazeZone = zone();
        }
        if (mazeCombat.player() != null && !mazeOwnsCombat()) releaseMazeCombat();
        if (map != 106 && map != 109) releaseMazeCombat();
        if (map == 108) {
            found108 = true;
            walkIdle(player, 501, 598);
            npc(-87, 0, 0);
            return;
        }
        if (map != 109) { door109Picked = false; door109 = 0; }
        if (map != 112) { door112Picked = false; door112 = 0; }
        switch (map) {
            case 1: case 33: case 67: case 93:
                mazeVillage(map, now);
                door109Counter = 0; door109Picked = false; door109 = 0;
                door112Counter = 0; door112Picked = false; door112 = 0;
                break;
            case 105: walkIdle(player, 468, 4); break;
            case 106: guard(player, 2, 760, 360); break;
            case 107: case 110: walkIdle(player, 832, 352); break;
            case 109:
                if (!door109Picked) {
                    if (++door109Counter > 2) door109Counter = 1;
                    door109 = door109Counter;
                    door109Picked = true;
                }
                if (door109 == 1) guard(player, 3, 396, 704);
                else if (door109 == 2) guard(player, 1, 1, 381);
                break;
            case 111: walkIdle(player, 836, 348); break;
            case 112:
                if (!door112Picked) {
                    if (++door112Counter > 2) { mazeReset(); return; }
                    door112 = door112Counter;
                    door112Picked = true;
                }
                if (door112 == 1) walkIdle(player, 92, 832);
                else if (door112 == 2) walkIdle(player, 381, 0);
                break;
            case 113: walkIdle(player, 92, 832); break;
            case 114: walkIdle(player, 825, 348); break;
            case 115: walkIdle(player, 92, 836); break;
            default: break;
        }
        }
    }

    /** In a village: use the maze item every 1.5s; after 4 uses re-evaluate the door of map 112. */
    static void mazeVillage(int map, long now) {
        if (now - mazeItemAt < MAZE_ITEM_MS) return;
        mazeItemAt = now;
        useItem(MAZE_ITEM);
        if (++mazeUses < 4) return;
        if (!found108 && map == 112) door112Counter = door112 = door112 == 1 ? 2 : 1;
        mazeUses = 0;
        found108 = false;
    }

    static void mazeReset() {
        door109Counter = door109 = door112Counter = door112 = mazeUses = 0;
        door109Picked = door112Picked = found108 = false;
        mazeItemAt = 0L;
    }

    /** ModUpLv K002.K143(id, x, y): reach and attack the door guard, else go to its post. */
    static void guard(@~lliiil@ player, int id, int x, int y) {
        et world = @~liiliii@.@~llillilll@;
        if (world == null || world.c() == 0) { releaseMazeCombat(); return; }
        @~liiiliii@ target = null;
        int best = 9999;
        for (int i = 0; i < world.c(); i++) {
            Object value = world.a(i);
            if (!(value instanceof @~liiiliii@)) continue;
            @~liiiliii@ e = (@~liiiliii@)value;
            if (e.cu != id || e.cv != 1 || e.bs <= 0 || e.cG == 4 || e.dz) continue;
            int d = distance(player, e);
            if (d >= best) continue;
            best = d;
            target = e;
        }
        if (target != null) {
            if (best > 150) {
                releaseMazeCombat();
                if (player.cG != 1) walk(target.aZ, target.ba);
            }
            else if (best <= 150) {
                if (mazeCombat.target() != target) releaseMazeCombat();
                mazeCombat.claim(player, target, map(), zone());
                @~liiliii@.@~llillilil@ = target;
                castAll(player);
            }
        } else {
            releaseMazeCombat();
            walkIdle(player, x, y);
        }
    }

    /** ModUpLv K154.K177: native auto on, cast every ready skill of the current bar. */
    static void castAll(@~lliiil@ player) {
        if (player.cG == 4) return;
        if (!@~lliiil@.@~lllliiii@) player.@~liilil@();
        // Let the native animation/request complete before selecting another hotbar skill.
        if (player.cG == 2 || player.cA >= 0) return;
        @~lilii@[][] bars = @~lliiil@.@~lliliiil@;
        if (bars == null || bars[@~lliiil@.d] == null) return;
        @~lilii@[] bar = bars[@~lliiil@.d];
        for (int i = 0; i < bar.length; i++) {
            @~lilii@ slot = bar[i];
            if (slot == null || slot.b != 0) continue;
            short skill = slot.@~lilllli@;
            @~liil@[] cooldowns = @~lliiil@.@~lliillli@;
            if (cooldowns == null || skill < 0 || skill >= cooldowns.length || cooldowns[skill] == null || cooldowns[skill].b > 0) continue;
            boolean ready = true;
            try {
                int level = @~lliiil@.@~llilllii@[skill];
                if (level > 0 && player.bu < @~liillil@.@~liili@(skill).@~lllillllil@[level + @~lliiil@.@~llilllil@[skill] - 1].@~lilllli@) ready = false;
            } catch (Throwable ignored) {
            }
            if (ready) {
                player.@~@(i, false);
                if (player.cG == 2 || player.cA >= 0) return;
            }
        }
    }

    // ------------------------------------------------------------------ native helpers

