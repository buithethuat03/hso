    /**
     * Native PK and battlefield eligibility first, then radius / level-40 / nearest top 20.
     * Battlefield ON: Xà nữ monsters inside the radius come first, and inside each group
     * (Xà nữ, level 40, others) lower HP goes first, nearer on equal HP. The locked target is offered
     * with HP -1, so it heads its group; the new first target becomes the lock. A send cannot mix monsters
     * (opcode 9) with players (opcode 6), so their list replaces the players' and pkSerpents is set.
     */
    static et nearestPlayers(@~lliiil@ player) {
        et result = new et("Player attack focus by user");
        nearest = -1;
        pkSerpents = false;
        pkTargets.clear();
        et world = @~liiliii@.@~llillilll@;
        if (world == null) return result;
        boolean war = BattlefieldSupport.enabled();
        int x = player.aZ, y = player.ba, count = world.c();
        try {
            if (war) {
                for (int i = 0; i < count; i++) {
                    Object value = world.a(i);
                    if (!(value instanceof @~liiiliii@)) continue;
                    @~liiiliii@ e = (@~liiiliii@)value;
                    if (!serpentTarget(e)) continue;
                    pkTargets.offer(e, e.cu, AutoPkTargetPolicy.distanceSquared(x, y, e.aZ, e.ba), false, e == pkLock ? -1 : e.bs);
                }
                pkSerpents = pkTargets.size() > 0;
            }
            for (int i = 0; !pkSerpents && i < count; i++) {
                Object value = world.a(i);
                if (!(value instanceof @~liiiliii@)) continue;
                @~liiiliii@ e = (@~liiiliii@)value;
                if (e.cv != 0 || e.cL || !dungeonAccess.validTarget(e, true)) continue;
                long distance = AutoPkTargetPolicy.distanceSquared(x, y, e.aZ, e.ba);
                pkTargets.offer(e, e.cu, distance, war && e.bz == 40, !war ? 0 : e == pkLock ? -1 : e.bs);
            }
            pkLock = war && pkTargets.size() > 0 ? (@~liiiliii@)pkTargets.at(0) : null;
            for (int i = 0; i < pkTargets.size(); i++) {
                @~liiiliii@ e = (@~liiiliii@)pkTargets.at(i);
                result.@~l@(new @~liilli@((short)e.cu, e.cv));
            }
            // Stats annotation is a pixel distance, independent of native overflowing distance.
            long squared = pkTargets.nearestSquared();
            if (squared >= 0) {
                int distance = 0;
                while ((long)(distance + 1) * (distance + 1) <= squared) distance++;
                nearest = distance;
            }
            return result;
        } finally { pkTargets.clear(); }
    }

    /** The 20 nearest living monsters of the loaded map, nearest first (ModUpLv K154.K143 filter). */
    static et nearestMonsters(@~lliiil@ player) {
        et list = new et("Monter attack focus by user");
        nearest = -1;
        et world = @~liiliii@.@~llillilll@;
        if (world == null) return list;
        int n = world.c();
        boolean[] used = new boolean[n];
        while (list.c() < MAX_TARGETS) {
            int best = -1, bestDistance = Integer.MAX_VALUE;
            for (int i = 0; i < n; i++) {
                if (used[i]) continue;
                Object value = world.a(i);
                if (!(value instanceof @~liiiliii@) || !loopMonster((@~liiiliii@)value, player)) { used[i] = true; continue; }
                @~liiiliii@ e = (@~liiiliii@)value;
                int d = @~liiiliii@.c(player.aZ, player.ba, e.aZ, e.ba);
                if (d > WIDE_RANGE || d >= bestDistance) continue;
                bestDistance = d;
                best = i;
            }
            if (best < 0) break;
            used[best] = true;
            if (nearest < 0) nearest = bestDistance;
            @~liiiliii@ e = (@~liiiliii@)world.a(best);
            list.@~l@(new @~liilli@((short)e.cu, e.cv));
        }
        return list;
    }

    /** Living monster; Con Ma stays with Farm's captcha branch, removed objects and the monster groups excluded in Auto đánh are skipped. */
    static boolean loopMonster(@~liiiliii@ e, @~lliiil@ player) {
        return e != player && e.cv == 1 && e.bs > 0 && e.cG != 4 && !e.cL && !e.x() && e.cy != 2
                && HungMonsterSelectionCommands.allow(e);
    }

    /**
     * Loot follows the mod's "Auto nhặt đồ" menu: its whole-map pass checks the on/off switch and the
     * Trắng/Xanh/Vàng/Tím/Cam boxes. Farm only reaches that pass with Auto đánh off, so Special runs it here.
     */
    static void pickupFrame(@~lliiil@ player) {
        @~lliiiiil@.@~lliiilii@();
        if (map() != 48) return;
        et world = @~liiliii@.@~llillilll@;
        if (world == null) return;
        for (int i = 0; i < world.c(); i++) {
            Object value = world.a(i);
            if (!(value instanceof @~liiiliii@)) continue;
            @~liiiliii@ e = (@~liiiliii@)value;
            if (e.dz || e.cv != 3 || !dungeonGoldChest(e)
                    || @~liiiliii@.c(player.aZ, player.ba, e.aZ, e.ba) >= PICKUP_RANGE) continue;
            @~lilillll@.@~liililli@().@~li@((short)e.cu, e.cv);
            e.dz = true;
        }
    }

    /** The sole loot exception to the menu: map 48 always picks Rương vàng, even with Auto nhặt off. */
    static boolean dungeonGoldChest(@~liiiliii@ item) {
        return map() == 48 && item.cC != null && "rương vàng".equals(item.cC.trim().toLowerCase());
    }

    // ------------------------------------------------------------------ menus

    static String state(boolean on) {
        return on ? "[BẬT]" : "[TẮT]";
    }

    static bt row(String label, int action) {
        return new bt(label, action, @~liilllii@.@~liiiliiiiil@);
    }

    static void show(et menu, String title) {
        @~liilllii@.@~liiiliillll@.@~@(menu, 2, title, false, (et)null);
    }

    public void addMenu(et menu) {
        menu.@~l@(row("Phó bản / Mê cung >", MENU));
    }

    /** Cài Đặt Cấu Hình: inserted before "Reset Cấu Hình". */
    public static void addConfigRows(et menu) {
        menu.@~l@(row(cat("Auto Lửa Thiêng: ", state(fire)), FIRE));
    }

    static void showMain() {
        et menu = new et("PHÓ BẢN / MÊ CUNG");
        menu.@~l@(row("Phó bản Ngã Tư Tử Thần >", NGA_TU));
        menu.@~l@(row("Làng Phủ Sương >", FOG_MENU));
        menu.@~l@(row(cat("Auto Mê cung: ", state(maze)), MAZE));
        menu.@~l@(row(cat("Hoàn thành phó bản: ", state(finish)), FINISH));
        menu.@~l@(row("<< Quay lại", BACK_MAIN));
        show(menu, "PHÓ BẢN / MÊ CUNG");
    }

    static void showNgaTu() {
        et menu = new et("NGÃ TƯ TỬ THẦN");
        menu.@~l@(row(cat("Vào bằng lượt free, đồng Horae: ", state(free)), FREE));
        menu.@~l@(row(cat("Vào bằng ngọc: ", state(gem)), GEM));
        menu.@~l@(row(cat("Vào bằng cả lượt free, đồng Horae và ngọc: ", state(both)), BOTH));
        menu.@~l@(row("<< Quay lại", MENU));
