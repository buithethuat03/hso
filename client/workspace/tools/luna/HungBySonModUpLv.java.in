    /**
     * Additional mode boundary for legacy Auto casts; native eligibility still runs after it.
     * Players only, except the Battlefield's "Xà nữ" monster, which Auto PK also attacks.
     */
    public static boolean validPkMode(Object value, boolean players) {
        if (!players) return true;
        if (!(value instanceof @~liiiliii@)) return false;
        @~liiiliii@ e = (@~liiiliii@)value;
        @~lliiil@ player = @~liiliii@.@~llilliill@;
        return player != null && !e.cL && (e.cv == 0 || (BattlefieldSupport.enabled() && serpentName(e)))
                && AutoPkTargetPolicy.distanceSquared(player.aZ, player.ba, e.aZ, e.ba) >= 0;
    }

    /**
     * Battlefield PK order for the Special OFF path, higher first and ties nearer first: group
     * Xà nữ (2), then exact level 40 (1), then other players (0) in bits 28-29; inside a group
     * lower HP ranks higher (HP capped at 0x0FFFFFFF in the low 28 bits). The controller's current
     * target ranks as HP 0, so it is kept until it dies, leaves the radius or a higher group shows up.
     */
    public static int priorityRank(Object value) {
        if (!BattlefieldSupport.enabled() || !(value instanceof @~liiiliii@)) return 0;
        @~liiiliii@ e = (@~liiiliii@)value;
        int group = e.cv == 1 ? (serpentName(e) ? 2 : 0) : e.cv == 0 && e.bz == 40 ? 1 : 0;
        int hp = e.bs <= 0 || value == AutoAttackRuntime.target() ? 0 : e.bs > 0x0FFFFFFF ? 0x0FFFFFFF : e.bs;
        return group << 28 | 0x0FFFFFFF - hp;
    }

    /** Catalog name match, as BattlefieldSupport/MonsterCacheSupport exclude "Xà nữ". */
    static boolean serpentName(@~liiiliii@ e) {
        return e.cv == 1 && e.cC != null && "Xà nữ".equalsIgnoreCase(e.cC.trim());
    }

    /** A living Xà nữ the native monster gate accepts (this also aligns its Battlefield position). */
    static boolean serpentTarget(@~liiiliii@ e) {
        return serpentName(e) && !e.cL && dungeonAccess.validTarget(e, false);
    }

    /**
     * World renderer calls before its camera transform is reset; the native clip is retained.
     * Feet-to-feet lines mark the targets nearestPlayers() picks from (same filters, same order of
     * checks so Battlefield position alignment runs before the radius): with Battlefield ON and a
     * Xà nữ in range, only red lines to Xà nữ; otherwise players, sky blue for the Battlefield level 40
     * and white for the rest. The focused player is orange in Battlefield mode; the Special
     * loop uses its attack lock because it sends without changing native focus. Xà nữ stays red.
     * The ring is drawn last, over the lines.
     */
    public static void paintPkRange(@~llilll@ graphics) {
        try {
            if (graphics == null || !pkMode()
                    || !HungAutoAttackAccess.farmWorldReady()) return;
            @~lliiil@ player = @~liiliii@.@~llilliill@;
            javax.microedition.lcdui.Graphics g = graphics.@~lliiilii@;
            int scale = @~llilll@.b;
            if (g == null || scale <= 0) return;
            int color = g.getColor();
            try {
                et world = @~liiliii@.@~llillilll@;
                if (world != null) {
                    boolean war = BattlefieldSupport.enabled();
                    Object focus = AutoAttackRuntime.enabled() && AutoAttackRuntime.normalMonstersActive()
                            ? pkLock : @~liiliii@.@~llillilil@;
                    int count = world.c();
                    // Pass 0: red Xà nữ lines. Players only get lines (pass 1) while no Xà nữ is in range.
                    boolean serpents = false;
                    for (int pass = war ? 0 : 1; pass < 2 && !(pass == 1 && serpents); pass++) {
                        for (int i = 0; i < count; i++) {
                            Object value = world.a(i);
                            if (!(value instanceof @~liiiliii@)) continue;
                            @~liiiliii@ e = (@~liiiliii@)value;
                            if (pass == 0 ? !serpentTarget(e) : e.cv != 0 || e.cL || !dungeonAccess.validTarget(e, true)) continue;
                            if (AutoPkTargetPolicy.distanceSquared(player.aZ, player.ba, e.aZ, e.ba) < 0) continue;
                            if (pass == 0) serpents = true;
                            g.setColor(pass == 0 ? 0xFF0000 : war && e == focus ? 0xFFA500
                                    : war && e.bz == 40 ? 0x00BFFF : 0xFFFFFF);
                            g.drawLine(player.aZ * scale, player.ba * scale, e.aZ * scale, e.ba * scale);
                        }
                    }
                }
                g.setColor(0x50FF00);
                g.drawArc((player.aZ - AutoPkTargetPolicy.RADIUS) * scale,
                        (player.ba - AutoPkTargetPolicy.RADIUS) * scale,
                        AutoPkTargetPolicy.RADIUS * 2 * scale, AutoPkTargetPolicy.RADIUS * 2 * scale, 0, 360);
            } finally { g.setColor(color); }
        } catch (Throwable ignored) {
        }
    }

    /** Exact opcode-6 serializer is generated from the pinned native cast's sender call. */
    static void sendPlayers(et targets, int skill) {
        // Replaced by the pinned patcher; no guessed obfuscated sender name in this template.
        throw new IllegalStateException("PK serializer bridge not generated");
