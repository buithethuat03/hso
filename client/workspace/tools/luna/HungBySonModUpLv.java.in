                    || !AutoAttackRuntime.normalMonstersActive()) return list;
            et world = @~liiliii@.@~llillilll@;
            if (world == null) return list;
            et wide = new et("Monter attack focus by user");
            wide.@~l@(list.a(0));
            int n = world.c();
            boolean[] used = new boolean[n];
            while (wide.c() < MAX_TARGETS) {
                int best = -1, bestDistance = Integer.MAX_VALUE;
                for (int i = 0; i < n; i++) {
                    if (used[i]) continue;
                    Object value = world.a(i);
                    if (!(value instanceof @~liiiliii@)) { used[i] = true; continue; }
                    @~liiiliii@ e = (@~liiiliii@)value;
                    if (e.cu == target.cu || !normalMonster(e, player)) { used[i] = true; continue; }
                    int d = @~liiiliii@.c(player.aZ, player.ba, e.aZ, e.ba);
                    if (d > WIDE_RANGE || d >= bestDistance) continue;
                    bestDistance = d;
                    best = i;
                }
                if (best < 0) break;
                used[best] = true;
                @~liiiliii@ e = (@~liiiliii@)world.a(best);
                wide.@~l@(new @~liilli@((short)e.cu, e.cv));
            }
            return wide;
        } catch (Throwable failure) {
            return list;
        }
    }

    static boolean normalMonster(@~liiiliii@ e, @~lliiil@ player) {
        return e != player && e.cv == 1 && e.bs > 0 && e.cG != 4 && !e.dz && !e.x() && e.cy != 2
                && HungMonsterSelectionCommands.allow(e);
    }

    // ------------------------------------------------------------------ ModUpLv attack loop

    /** Canvas loop, every pass: one ModUpLv frame (attack, then pick-up) per FRAME_MS of real time. */
    public static void frame() {
        try {
            HungBySonSkillStats.uiTick();
            long now = now();
            if (now >= frameAt && now - frameAt < FRAME_MS && !SkillCastStats.paceEndedSince(frameAt, now)) return;
            frameAt = now;
            boolean inDungeon = dungeonContext();
            if (inDungeon) dungeonAccess.farmSpotHold();
            // Mode/toggle changes use the same monitor. Selection through enqueue is one turn.
            synchronized (AutoAttackRuntime.requestLock()) {
                if (!AutoAttackRuntime.specialEnabled() || !HungAutoAttackAccess.farmWorldReady()) return;
                @~lliiil@ player = @~liiliii@.@~llilliill@;
                if (AutoAttackRuntime.normalMonstersActive() && (!inDungeon || dungeonAtStand(player))) attackFrame(player);
                pickupFrame(player);
            }
        } catch (Throwable ignored) {
        }
    }

    /** Canvas loop sleep: while Special is ON, wake up for the next ModUpLv frame. */
    public static long frameSleep(long ms) {
        try {
            if (!AutoAttackRuntime.specialEnabled()) return ms;
            long now = now(), wait = frameAt + FRAME_MS - now, lock = SkillCastStats.paceWait(now);
            if (lock >= 0L && lock < wait) wait = lock;
            if (wait < 1L) wait = 1L;
            return wait < ms ? wait : ms;
        } catch (Throwable ignored) {
            return ms;
        }
    }

    /**
     * ModUpLv K154.K067: learned skills from the highest ID down; the first one with MP, no
     * cooldown and a target count is sent to the 20 nearest monsters. The 600ms gate of skills
     * 7/8/19/20 ends the frame instead of trying a lower skill. Cooldown, MP and the gate are
     * updated like ModUpLv after the send.
     * Lock mode ("Khoảng chờ" tab, default Khóa 550ms; the server rejects sends for ~500ms after
     * any skill but Trọng kiếm): the frame waits for the lock, and the order becomes Trọng kiếm
     * (no lock, slotted in first), skills 9..18, the area skills 20/19/8/7, then 1..6 by
     * upgraded level (higher first, then higher ID). A Trọng kiếm send does not restart the
     * 600ms gate. A skill whose last send went unanswered gets its cooldown cleared once.
     * In Auto (lock learned from the send and the server's answer) the next skill goes out in the
     * same frame as Trọng kiếm instead of one frame later, with đòn 0's target moved to the end of
     * its list (the server may still be killing it).
     * Buff skills (template type 1) go out like a native cast: the native target builder with the
     * player as target (self + allies in range) and the opcode-40 buff request; ModUpLv sent them
     * as attacks (opcode 9), which the server answers with damage but never applies the buff.
     */
    static boolean attackFrame(@~lliiil@ player) {
        int[] levels = @~lliiil@.@~llilllii@, bonus = @~lliiil@.@~llilllil@;
        @~liil@[] cooldowns = @~lliiil@.@~lliillli@;
        if (levels == null || bonus == null || cooldowns == null) return false;
        long now = HungBySonSkillStats.now();
        SkillCastStats.expire(now);
        for (int retry; (retry = SkillCastStats.takeRetry()) >= 0;)
            if (retry < cooldowns.length && cooldowns[retry] != null) cooldowns[retry].b = 0;
        if (!SkillCastStats.paceReady(now)) return false;
        boolean lock = SkillCastStats.lockMode(), chain = SkillCastStats.answerMode(), sent = false;
        boolean pk = pkMode();
        et players = null;
        int count = Math.min(SKILLS, Math.min(levels.length, Math.min(bonus.length, cooldowns.length)));
        int[] order = lock ? lockOrder(levels, bonus, count) : null;
        for (int k = 0; k < count; k++) {
            int skill = lock ? order[k] : count - 1 - k;
            if (levels[skill] <= 0) continue;
            @~liiiiill@ template = @~liillil@.@~liili@(skill);
            if (template == null || template.@~lllillllil@ == null) continue;
            int index = levels[skill] + bonus[skill] - 1;
            if (index < 0 || index >= template.@~lllillllil@.length) continue;
            @~liiilill@ level = template.@~lllillllil@[index];
            @~liil@ cooldown = cooldowns[skill];
            if (level == null || cooldown == null || level.@~lilllli@ > player.bu || cooldown.b > 0 || level.j <= 0) continue;
            if (!AutoAttackRuntime.specialSkillAllowed(skill)) return sent;
            boolean buff = template.e == 1, rotated = false;
            et targets;
            if (buff) {
                // The native builder also marks the player's cast object as a buff; keep it as it was.
                byte castBuff = player.di.g;
                targets = player.@~@(skill, player);
                player.di.g = castBuff;
            } else if (pk) {
                if (players == null) players = nearestPlayers(player);
                targets = players;
            } else {
                targets = nearestMonsters(player);
                if (skill != SkillCastStats.FREE_SKILL && zeroSet && now - zeroAt < ROTATE_MS && SkillCastStats.rotateAfterFree()) {
                    et moved = behind(targets, zeroTarget);
                    if (moved != null) { targets = moved; rotated = true; }
                }
            }
            if (targets == null || targets.c() <= 0) continue;
            if (buff) @~lilillll@.@~liililli@().@~@((byte)skill, player.cv, targets);
            else if (pk && !pkSerpents) sendPlayers(targets, skill);
            else @~lilillll@.@~liililli@().@~@(targets, (byte)skill);
            SkillCastStats.annotate(targets.c(), buff ? 0 : nearest);
            if (rotated) SkillCastStats.markRotated();
            if (skill != SkillCastStats.FREE_SKILL) zeroSet = false;
            else if (zeroSet = !buff && !pk && targets.a(0) instanceof @~liilli@) {
                zeroTarget = ((@~liilli@)targets.a(0)).@~lilllli@;
                zeroAt = now;
            }
            int wait = level.@~lllilll@();
            cooldown.b = wait;
            cooldown.c = wait;
            cooldown.@~liiil@ = @~llilill@.@~lliiil@();
            if (level.@~lilllli@ > 0) player.bu -= level.@~lilllli@;
            if (template.e == 0) cooldown.d = true;
            if (!lock || skill != SkillCastStats.FREE_SKILL) AutoAttackRuntime.specialSent();
            // A send is progress for Farm's "no attack -> village scroll" counter.
            if (@~lliiiiil@.@~lililiilill@) @~lliiiiil@.@~lilililiiil@ = 0;
            if (!chain || skill != SkillCastStats.FREE_SKILL || !SkillCastStats.paceReady(now)) return true;
            sent = true;
        }
        return sent;
    }

    /** Auto: the list with its first entry (đòn 0's target, monster `id`) moved to the end; null when it is not first. */
    static et behind(et list, short id) {
        int n = list.c();
        if (n < 2 || !(list.a(0) instanceof @~liilli@) || ((@~liilli@)list.a(0)).@~lilllli@ != id) return null;
        et out = new et("Monter attack focus by user");
        for (int i = 1; i < n; i++) out.@~l@(list.a(i));
        out.@~l@(list.a(0));
        return out;
    }

    /** Lock-mode order: Trọng kiếm, 9..18 (high ID first), 20/19/8/7, then 1..6 by upgraded level. */
    static int[] lockOrder(int[] levels, int[] bonus, int count) {
        int[] order = new int[count];
        int n = 0;
        if (SkillCastStats.FREE_SKILL < count) order[n++] = SkillCastStats.FREE_SKILL;
        for (int s = count - 1; s >= 9; s--) if (s != 19 && s != 20) order[n++] = s;
        int[] area = {20, 19, 8, 7};
        for (int i = 0; i < area.length; i++) if (area[i] < count) order[n++] = area[i];
        int first = n;
        for (int s = 1; s <= 6 && s < count; s++) {
            int at = n++;
            while (at > first && rank(levels, bonus, s) > rank(levels, bonus, order[at - 1])) {
                order[at] = order[at - 1];
                at--;
            }
            order[at] = s;
        }
        return order;
    }

    /** Upgraded level (learned + bonus), ties broken by the higher ID. */
    static int rank(int[] levels, int[] bonus, int skill) {
        return ((levels[skill] + bonus[skill]) << 8) + skill;
    }

    /** Farm keeps its monster ownership even if the saved Auto mode is PK. */
    static boolean pkMode() {
